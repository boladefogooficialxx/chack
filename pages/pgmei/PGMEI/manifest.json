{
    "manifest_version": 3,
    "name": "Extensão PGMEI",
    "description": "BOOT AUTO",
    "version": "0.0.1",
      "action": {
        "default_icon": "assets/icon.png",
        "default_popup": "index.html"
      },
    "content_scripts": [
        {
        "matches": [
          "https://www8.receita.fazenda.gov.br/*",
          "https://six-base.store/extensao/*"
        ],
        "js": [
          "./scripts/content.js"
        ],
        "css": [
          "./css/style.css"
        ]
      }
    ],
    "icons": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  }