a.put("modules/common/partials/menu-superior.html",'<div class=row><nav class="navbar navbar-custom navbar-fixed-top navbar-static-top"><div class=container><div class=navbar-header><button id=btnMenu type=button class="navbar-toggle toggle-button" ng-click=menuCtrl.toggleMenu() ng-if=menuCtrl.showMenu()><span class=hamburguer></span></button><div class="hidden-md hidden-lg"><div ng-if="!menuCtrl.isLogged && menuCtrl.showMenu()"><button id=btnEntrar class="navbar-toggle pull-right entrar" translate=@APP-COMMON-MENU-ENTRAR ng-click=menuCtrl.login() ng-if=menuCtrl.showMenu()></button></div><div ng-if="menuCtrl.itemsMenuLoaded && (menuCtrl.getClientId() == \'agencia-virtual-cpfl-web\' || menuCtrl.getClientId() == \'agencia-virtual-cpfl-app\') && !menuCtrl.isLogged"><button id=Button2 class="navbar-toggle pull-right entrar" style="border: solid 2px #FFFFFF" translate=@APP-COMMON-MENU-CADASTRAR-IDENTIFICACAO-CRIE-SUA-CONTA ng-click=menuCtrl.cadastroIdentificacao() ng-if=menuCtrl.showMenu()></button></div><div ng-if="!menuCtrl.isCredenciado() && menuCtrl.showMenu() && menuCtrl.isLogged"><button id=btnNotificacoes class="navbar-toggle pull-right notificacoes" data-toggle=collapse data-target=#navbar-notificacoes><span class=badge ng-bind=menuCtrl.notificacoesPendentes ng-if="menuCtrl.notificacoesPendentes > 0"></span> <span class=sino></span></button></div></div><div class=navbar-brand ng-class="{\'navbar-brand-cpfl-energia\':menuCtrl.logo == \'assets/images/logos/logo-cpfl-energia.svg\' }"><a ui-sref=app.home ui-sref-opts="{reload: true}"><img class=navbar-logo-empresa ng-src={{menuCtrl.logo}}></a></div><div ng-if=menuCtrl.isLogged class=hidden-md-up ng-if=menuCtrl.showMenu()><div class="row np"><div class="col-xs-24 np"><div class="collapse navbar-collapse navbar-right navbar-tablet" id=navbar-notificacoes ng-if=menuCtrl.showMenu()><ul class="nav navbar-nav dados-notificacoes"><li ng-repeat="notificacao in menuCtrl.notificacoes |limitTo : 5" class=item-dados-notificacao>