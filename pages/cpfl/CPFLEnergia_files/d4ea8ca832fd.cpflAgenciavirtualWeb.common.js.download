l-style"><div class=modal-body style=padding-left:0px!important;padding-right:0px!important><table class=table><thead></thead><tbody><tr ng-if=!vm.snapshotData><td><div><webcam channel=vm.channel on-streaming=vm.onSuccess() on-error=vm.onError(err) on-stream=vm.onStream(stream)></webcam></div></td><td><div><div class=buttons><button type=button ng-click=vm.voltarFoto(); class="btn btn-default btn-secondary btn-lg btn-block"><span class="glyphicon glyphicon-menu-left"></span> <span style="font-family:\'Lato\', sans-serif !important" translate=@APP-COMMON-LINK-VOLTAR></span></button> <button type=button ng-click=vm.makeSnapshot() class="btn btn-default btn-secondary btn-lg btn-block"><span class="glyphicon glyphicon-picture"></span> <span style="font-family:\'Lato\', sans-serif !important" translate=@APP-COMMON-ENVIO-DOCUMENTOS-TIRAR-FOTO></span></button></div></div><div><div class=col-xs-48><div style="font-weight:bold;font-size: 14px"><span translate=@APP-COMMON-ENVIO-DOCUMENTOS-QUALIDADE-IMAGEM></span></div></div></div></td></tr><tr ng-show=vm.snapshotData><td><div><canvas id=snapshot width=300 height=300></canvas></div></td><td><div><div class=buttons><button type=button ng-click=vm.voltarFoto(); class="btn btn-default btn-secondary btn-lg btn-block"><span class="glyphicon glyphicon-menu-left"></span> <span style="font-family:\'Lato\', sans-serif !important" translate=@APP-COMMON-LINK-VOLTAR></span></button> <button type=button ng-click=vm.enviarFoto() class="btn btn-default btn-secondary btn-lg btn-block"><span class="glyphicon glyphicon-open"><span style="font-family:\'Lato\', sans-serif !important" translate=@APP-COMMON-ENVIO-DOCUMENTOS-ENVIAR-FOTO></span></span></button> <button type=button ng-click="vm.snapshotData=undefined;" class="btn btn-default btn-secondary btn-lg btn-block"><span class="glyphicon glyphicon-picture"><span style="font-family:\'Lato\', sans-serif !important" translate=@APP-COMMON-ENVIO-DOCUMENTOS-NOVA-FOTO></span></span></button></div></div><div><div class=col-xs-48><div style="font-weight:bold;font-size: 14px"><span translate=@APP-COMMON-ENVIO-DOCUMENTOS-QUALIDADE-IMAGEM></span></div></div></div></td></tr></tbody></table></div></div>');a.put("modules/common/templates/modal-captcha-challenge.html",'<div id=modalConfirm><div class="modal-dialog cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate={{vm.titulo}}></h2></div></div></div><div class=modal-body id=modal-body><alert target=modal-captcha-challenge></alert><div class=row><div class=col-xs-24><p translate=@APP-MODAL-COMMON-CAPTCHA-CHALLENGE-MESSAGE class=text-center></p></div></div><div style="position:relative initial"><captcha on-success=vm.closeModal(response) on-error=vm.errorCaptcha(response)></div></div><div class=modal-footer id=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-offset-6"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=vm.dismissModal() translate=@APP-MODAL-COMMON-CAPTCHA-CHALLENGE-BTN-CANCEL></button></div></div></div></div></div></div>');a.put("modules/common/templates/modal-confirm.html",'<div id=modalConfirm><div class=modal-dialog><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate={{modalConfirmCtrl.title}}></h2></div></div></div><div class=modal-body id=modal-body><div class=row><div class=col-xs-24><p translate={{modalConfirmCtrl.message}} translate-values={{modalConfirmCtrl.params}} class=text-center></p></div></div></div><div class=modal-footer id=modal-footer><div class=row><div class=buttons ng-if="modalConfirmCtrl.btnDismissAcao != \'N\'"><div class="col-xs-24 col-md-12 col-md-push-12"><button class="btn btn-default btn-lg btn-block" id=btnConfirm ng-click=modalConfirmCtrl.closeModal() translate={{modalConfirmCtrl.buttonConfirmText}}></button></div><div class="col-xs-24 col-md-12 col-md-pull-12" ng-if="modalConfirmCtrl.btnDismissAcao != \'S\'"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=modalConfirmCtrl.dismissModal() translate={{modalConfirmCtrl.buttonCancelText}}></button></div><div class="col-xs-24 col-md-12 col-md-pull-12" ng-if="modalConfirmCtrl.btnDismissAcao === \'S\'"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click="modalConfirmCtrl.closeModal(\'S\')" translate={{modalConfirmCtrl.buttonCancelText}}></button></div></div><div class=row style="display: flex"><div class=buttons ng-if="modalConfirmCtrl.btnDismissAcao == \'N\'" style="margin: auto"><div class="col-xs-24 col-md-12" style="display: inline-table; min-width: 300px"><button class="btn btn-default btn-secondary btn-lg btn-block" style="background: -webkit-linear-gradient(left, #006699, #00bbcc);color: #fff" ng-click="modalConfirmCtrl.closeModal(\'S\')" translate=@APP-LIGACAO-NOVA-STEP3-OK></button></div></div></div></div></div></div></div>');a.put("modules/common/templates/modal-encontrar-instalacao.html",'<div class="modal-content cpfl-style"><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.dismissModal(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title ng-if="!vm.consultou && !vm.resultados" translate=@APP-MODAL-COMMON-ENCONTRAR-INSTALACAO-TITULO></h2><h2 class=modal-title id=modal-title ng-if="vm.consultou || vm.resultados" translate=@APP-MODAL-COMMON-ENCONTRAR-INSTALACAO-TITULO-2></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-encontrar-instalacao></alert></div></div><div ng-if=!vm.divConsultarMeuCodigo><div class=row><div class=col-xs-24><uib-tabset type=pills active=activePill justified=true><uib-tab index=0 ng-click="vm.trocarTipoCliente(\'CPFL\')" heading="{{\'@APP-MODAL-COMMON-ENCONTRAR-INSTALACAO-CLIENTE-CPFL\' | translate}}"><img src=assets/images/onde-encontrar-meu-codigo-cpfl.jpg class=img-