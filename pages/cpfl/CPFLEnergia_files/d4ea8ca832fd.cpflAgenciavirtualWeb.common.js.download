APP-CREDENCIADOS-SUBCABECALHO-CLIENTE class=box-subcabecalho-instalacao-txt></span><span ng-if="vm.protocoloAtendimento && vm.protocoloAtendimento.NomeTitular && vm.protocoloAtendimento.NomeTitular.length <= 25" ng-bind=vm.protocoloAtendimento.NomeTitular class=box-subcabecalho-instalacao-titular></span> <span ng-if="vm.protocoloAtendimento && vm.protocoloAtendimento.NomeTitular && vm.protocoloAtendimento.NomeTitular.length > 25" ng-bind="(vm.protocoloAtendimento.NomeTitular | limitTo:25) + \'...\'" class=box-subcabecalho-instalacao-titular></span></div><span>&nbsp;&nbsp;|&nbsp;&nbsp;</span><div class="text-center box-subcabecalho-infos" ng-if=!vm.ehCredenciadoImobiliaria><span translate=@APP-CREDENCIADOS-SUBCABECALHO-INSTALACAO class=box-subcabecalho-instalacao-txt></span> <span class=box-subcabecalho-instalacao-numero ng-bind=vm.protocoloAtendimento.Instalacao></span></div><div class="text-center box-subcabecalho-infos" ng-if=vm.ehCredenciadoImobiliaria><span translate=@APP-CREDENCIADOS-SUBCABECALHO-INSTALACAO class=box-subcabecalho-instalacao-txt></span> <span class=box-subcabecalho-instalacao-numero ng-bind=vm.instalacaoMask></span></div><span>&nbsp;&nbsp;|&nbsp;&nbsp;</span><div class="text-center box-subcabecalho-infos" ng-if=!vm.ehCredenciadoImobiliaria><span translate=@APP-CREDENCIADOS-SUBCABECALHO-PN class=box-subcabecalho-instalacao-txt></span> <span class=box-subcabecalho-instalacao-numero ng-bind=vm.protocoloAtendimento.ParceiroNegocio></span></div><div class="text-center box-subcabecalho-infos" ng-if=vm.ehCredenciadoImobiliaria><span translate=@APP-CREDENCIADOS-SUBCABECALHO-PN class=box-subcabecalho-instalacao-txt></span> <span class=box-subcabecalho-instalacao-numero ng-bind=vm.parceiroNegocioMask></span></div><span>&nbsp;&nbsp;|&nbsp;&nbsp;</span><div class="text-center box-subcabecalho-infos"><span translate=@APP-CREDENCIADOS-SUBCABECALHO-INSTALACAO-SITUACAO class=box-subcabecalho-instalacao-txt></span> <span ng-bind=vm.SituacaoCalculada class=box-subcabecalho-instalacao-numero></span></div></div><div class="col-xs-24 text-center"><div class=row ng-if="vm.enderecoAtendimento && vm.enderecoAtendimento.Rua"><div class=col-xs-24><div class=panel-subcabecalho-endereco><div class=panel-group><div class=panel-default><div class=panel-heading data-toggle=collapse data-target=#enderecoCompleto ng-if=!vm.ehCredenciadoImobiliaria data-parent=#accordion><span translate=@APP-CREDENCIADOS-SUBCABECALHO-ENDERECO class=box-subcabecalho-instalacao-txt></span> <span ng-bind=vm.enderecoAbreviado class=subcabecalho-endereco-completo-span ng-init="vm.textTooltipVejaMais = true;" ng-click=vm.changeTooltipText(); tooltip-placement=top uib-tooltip={{vm.textTooltip}}></span> <i id=iconeMaisEndereco class="iconMaisEnderecoCompleto fa" ng-if=!vm.ehCredenciadoImobiliaria ng-class="{\'fa-plus\': vm.textTooltipVejaMais, \'fa-minus\': !vm.textTooltipVejaMais}" ng-init="vm.textTooltipVejaMais = true;" ng-click=vm.changeTooltipText(); tooltip-placement=top uib-tooltip={{vm.textTooltip}}></i></div><div class=panel-heading ng-if=vm.ehCredenciadoImobiliaria data-parent=#accordion><span translate=@APP-CREDENCIADOS-SUBCABECALHO-ENDERECO class=box-subcabecalho-instalacao-txt></span> <span ng-bind=vm.enderecoAbreviado class=subcabecalho-endereco-completo-span></span> <i id=iconeMaisEndereco class="iconMaisEnderecoCompleto fa" ng-if=!vm.ehCredenciadoImobiliaria ng-class="{\'fa-plus\': vm.textTooltipVejaMais, \'fa-minus\': !vm.textTooltipVejaMais}" ng-init="vm.textTooltipVejaMais = true;" ng-click=vm.changeTooltipText(); tooltip-placement=top uib-tooltip={{vm.textTooltip}}></i></div><div id=enderecoCompleto class="panel-collapse collapse" ng-if="vm.enderecoAtendimento && vm.enderecoAtendimento.Rua"><div class=panel-body-np><div class=panel-subcabecalho-padding><div><div class=row><div class=col-xs-24><span translate=@APP-CREDENCIADOS-SUBCABECALHO-ENDERECO-COMPLETO class=box-subcabecalho-instalacao-txt></span><br><span ng-bind=vm.enderecoCompleto class=