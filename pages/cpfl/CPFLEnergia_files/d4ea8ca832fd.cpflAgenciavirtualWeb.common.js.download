=vm.fecharModal() type=submit translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-BTN-VOLTAR></button></div></div></div></div></form></div>');a.put("modules/common/views/modal-painel-inicial-buscar-instalacao-home.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-TITULO></h2></div></div></div><form name=form novalidate><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-painel-inicial-buscar-instalacao></alert></div></div><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h2 translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-TEXTO-SUB></h2></div></div></div><div class=col-xs-24><div class=cpfl-style><table ng-table=vm.tableParams class=table show-filter=true><tr ng-repeat="instalacao in $data"><td ng-if=vm.isTipoPesquisaEndereco data-title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-COMPLEMENTO\' | translate" filter="{ complementoEstruturado: \'text\'}" sortable>{{::instalacao.complementoEstruturado}}</td><td ng-if=vm.isTipoPesquisaEndereco title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-INSTALACAO\' | translate" filter="{ Uc: \'text\'}" sortable>{{::instalacao.UcFake}}</td><td ng-if=!vm.isTipoPesquisaEndereco data-title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-ENDERECO\' | translate" filter="{ Endereco: \'text\'}" sortable>{{::instalacao.Endereco}}</td><td class="cpfl-style text-center" title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-SELECIONE\' | translate"><div class=radio-box><div class="form-group form-group-radio"><label name=radio-instalacao><input type=radio ng-value=instalacao ng-model=vm.instalacaoSelecionada name=enderecoRadio ng-click=vm.fecharAlert()> <span class=any></span></label></div></div></td></tr></table></div></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12" ng-class="{\'col-md-push-12\': vm.mostratBotaoVoltar, \'col-md-offset-6\': !vm.mostratBotaoVoltar}"><button class="btn btn-default btn-lg btn-block" ng-click=vm.pegarInstalacao() translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-BTN-INICAR-AT></button></div><div ng-if=vm.mostratBotaoVoltar class="col-xs-24 col-md-12 col-md-pull-12"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=vm.fecharModal() type=submit translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-BTN-VOLTAR></button></div></div></div></div></form></div>');a.put("modules/common/views/modal-painel-inicial-buscar-instalacao.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-TITULO></h2></div></div></div><form name=form novalidate><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-painel-inicial-buscar-instalacao></alert></div></div><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h2 translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-TEXTO-SUB></h2></div></div></div><div class=col-xs-24><div class=cpfl-style><table ng-table=vm.tableParams class=table show-filter=true><tr ng-repeat="instalacao in $data"><td ng-if=vm.isTipoPesquisaEndereco data-title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-COMPLEMENTO\' | translate" filter="{ complementoEstruturado: \'text\'}" sortable>{{::instalacao.complementoEstruturado}}</td><td ng-if=vm.isTipoPesquisaEndereco title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-INSTALACAO\' | translate" filter="{ Uc: \'text\'}" sortable>{{::instalacao.UcFake}}</td><td ng-if=!vm.isTipoPesquisaEndereco data-title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-ENDERECO\' | translate" filter="{ Endereco: \'text\'}" sortable>{{::instalacao.Endereco}}</td><td ng-if=vm.isTipoPesquisaEndereco title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-STATUS\' | translate" filter="{ StatusInstalacao: \'text\'}" sortable>{{::instalacao.StatusInstalacao}}</td><td class="cpfl-style text-center" title="\'@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-SELECIONE\' | translate"><div class=radio-box><div class="form-group form-group-radio"><label name=radio-instalacao><input type=radio ng-value=instalacao ng-model=vm.instalacaoSelecionada name=enderecoRadio ng-click=vm.fecharAlert()> <span class=any></span></label></div></div></td></tr></table></div></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12" ng-class="{\'col-md-push-12\': vm.mostratBotaoVoltar, \'col-md-offset-6\': !vm.mostratBotaoVoltar}"><button class="btn btn-default btn-lg btn-block" ng-click=vm.pegarInstalacao() translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-BTN-INICAR-AT></button></div><div ng-if=vm.mostratBotaoVoltar class="col-xs-24 col-md-12 col-md-pull-12"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=vm.fecharModal() type=submit translate=@APP-CREDENCIADOS-MODAL-SELECIONAR-INSTALACAO-BTN-VOLTAR></button></div></div></div></div></form></div>');a.put("modules/common/views/politica-privacidade.html","<div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-POLITICA-DE-PRIVACIDADE></li></ol></div></div><div class=row><div class=col-xs-24><h1>Política de privacidade</h1></div></div><div class=row><div class=col-xs-24><h4 class=titulo></h4><div class=separador></div><p>A CPFL Energia compromete-se a proteger sua privacidade e a fornecer um acesso mais seguro. Esta declaração de privacidade aplica-se ao site e ao aplicativo CPFL Energia e refere-se ao levantamento, uso e tratamento de todos os dados informados e recebidos. Acessando o site e/ou aplicativo CPFL Energia, o usuário expressamente declara que consente com as práticas descritas nesta declaração.</p><h2>Coleta de Informações Pessoais</h2><p>A CPFL Energia necessita coletar algumas informações na efetivação do cadastro no site/aplicativo tais como: seu endereço de e-mail, nome, endereço residencial ou do trabalho ou número de telefone. CPFL Energia coleta também algumas informações demográficas tais como, idade, sexo, preferências e interesses. Há também a coleta de informações sobre as ferramentas e softwares utilizados, que são coletadas pelo site CPFL Energia. Estas informações podem incluir: seu endereço de IP, tipo de navegador, nomes de domínio, tempos de acesso e consultas às páginas do site. Ao aceitar os Termos de Uso e a Política de Privacidade da CPFL Energia, você desde já consente com o uso desses dados pela CPFL. Estas informações serão usadas por CPFL Energia para manter a qualidade do serviço e fornece estatísticas internas a respeito do uso do site/aplicativo CPFL Energia.</p><p>Nota: CPFL Energia não lê suas comunicações confidenciais.</p><p>A CPFL Energia incentiva-o ler a Política de Privacidade de modo que você possa compreender como o site coleta, trata, usa e compartilha suas informações. A CPFL Energia não é responsável por nenhuma Política de Privacidade ou outros conteúdos que forem exibidos fora dos sites CPFL Energia.</p><h2>Uso de Informações Pessoais</h2><p>Mediante o aceite, a CPFL Energia coleta e usa suas informações pessoais para operar o site/aplicativo CPFL Energia e realizar os serviços solicitados pelos próprios usuários. A CPFL Energia usa também suas informações de identificação pessoal para informá-lo de outros produtos ou serviços disponíveis no site CPFL Energia. A CPFL Energia pode também contatá-lo através de enquetes para conduzir pesquisas sobre sua opinião de serviços atuais ou dos serviços novos e potenciais, que possam ser oferecidos. A CPFL Energia não vende nem não aluga suas listas e dados de clientes a terceiros. Todos os terceiros são proibidos de usar a sua informação pessoal a não ser para o estrito uso conforme a presente política, e são obrigados a manter a confidencialidade de suas informações.</p><p>A CPFL Energia não usa nem divulga informações pessoais sensíveis tais como: raça, religião e afiliações políticas sem seu consentimento explícito.</p><p>A CPFL Energia se mantém informada dos acessos e visitas dos clientes ao site CPFL Energia, a fim de determinar quais serviços são os mais populares. Estes dados poderão ser usados para satisfazer de maneira customizada aos clientes cujo comportamento indique interesse por áreas específicas.</p><p>Os sites CPFL Energia, irão disponibilizar suas informações pessoais, sem o aviso prévio, somente se forem requisitadas por lei ou se forem necessárias para:</p><p>(a) estar em conformidade com mandatos legais ou para obedecer aos processos legais que deverão ser cumpridos pela CPFL Energia, ou seus sites;</p><p>(b) proteger e defender os direitos de propriedade de CPFL Energia;</p><p>(c) agir sob circunstancias que exijam a proteção da segurança dos usuários de CPFL Energia, ou do público.</p><h2>Uso de cookies</h2><p>O site CPFL Energia usa cookies para personalizar sua experiência online. Um cookie é um arquivo texto que é armazenado no seu computador por um servidor de páginas web. Os cookies não podem ser usados para executar programas ou enviar vírus para o seu computador. Os cookies são atribuídos exclusivamente a você, e só podem ser lidos pelo servidor que os enviou a você. Um dos propósitos principais dos cookies é uma característica conveniente que economiza o seu tempo ao carregar e exibir informações da página.</p><h2>Segurança Das Suas Informações Pessoais</h2><p>A CPFL Energia assegura que as suas informações pessoais não serão acessadas, usadas ou reveladas de forma não autorizada. A CPFL Energia assegura que as informações pessoais que você forneceu nos servidores estão em um ambiente controlado, seguro e protegido de acessos não autorizados.</p><h2>Mudança Desta Declaração</h2><p>A CPFL Energia se reserva ao direito de atualizar esta Política de Privacidade para refletir os interesses da empresa e de nossos clientes. A CPFL Energia encoraja você a rever este documento periodicamente para estar informado de como CPFL Energia está protegendo sua informação.</p></div></div>");a.put("modules/common/views/resultado.html",'<div class=resultadoServico><div id=divBreadcrumb class=row><div class=col-xs-24><ol class=breadcrumb><li></li><li><a class=active ui-sref=app.home>Home</a></li></ol></div></div><div class=resultadoDadosImpressao><h1 translate={{resultado.resultado.servico}}></h1><alert></alert><div class=row><div class=col-xs-24><h2 translate={{resultado.resultado.titulo}}></h2></div></div><div class=row><div class=col-xs-24><span id=textoMensagem translate={{resultado.resultado.mensagem}} translate-values={{resultado.resultado.parametros}} translate-compile></span></div></div><div ng-if="resultado.resultado.link && resultado.resultado.linkMensagem"><div class=row><div class=col-xs-24><div id=Div1><span translate={{resultado.resultado.linkMensagem}}></span> <a ui-sref={{resultado.resultado.link}} translate=@APP-RESULTADO-CLIQUE-AQUI></a></div></div></div></div><div ng-if=resultado.resultado.protocolo><div class=row><div class=col-xs-24><div id=protocoloAtendimento><h2 translate=@APP-RESULTADO-PROTOCOLO-DE-ATENDIMENTO></h2><p ng-bind=resultado.resultado.protocolo></p></div></div></div></div><div ng-if=resultado.resultado.informacoesImportantes><div class=row><div class=col-xs-24><div id=protocoloAtendimento><h2 translate=@APP-RESULTADO-INFORMACOES-IMPORTANTES></h2><span translate={{resultado.resultado.informacoesImportantes}}></span></div></div></div></div><div ng-if=resultado.resultado.faltaEnergia><div class=row><div class=col-xs-24><div id=protocoloAtendimento><h2 translate=@APP-RESULTADO-EM-CASO-FALTA-ENERGIA></h2><span translate={{resultado.resultado.faltaEnergia}}></span></div></div></div></div><div ng-if=resultado.data><div class=row><div class=col-xs-24><div id=dataSolicitacao><h2 translate=@APP-DATA-LEITURA-DATA-SOLICITACAO></h2><p ng-bind=resultado.data></p></div></div></div></div><div ng-if=resultado.resultado.enviarDeclaracaoClasseCredenciados><div class=row><div class=col-xs-24><div id=informacoesImportantes><h2 translate=@APP-ENVIAR-DECLARACAO-CREDENCIADOS-TITULO></h2><p translate=@APP-ENVIAR-DECLARACAO-CREDENCIADOS-LINK-ENVIO-DOC></p></div></div></div></div></div><div id=pesquisaSatisfacao ng-if="resultado.resultado.codServico && !resultado.resultado.isCredenciado"><div class=row style="margin: 0"><div><p>Participe da nossa pesquisa: são apenas 3 perguntas e leva menos de 1 minuto. Para responder agora, <a ng-if="resultado.resultado.codServico == \'ADV001\' " href=https://pt.surveymonkey.com/r/cpfl-alterar-vencimento style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'FDE003\' " href=https://pt.surveymonkey.com/r/cpfl-falta-energia style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'HCO004\' " href=https://pt.surveymonkey.com/r/cpfl-segunda-via style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'@APP-SUCCESS-RCF009\' " href=https://pt.surveymonkey.com/r/cpfl-conta-digital style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'TRN001\' " href=https://pt.surveymonkey.com/r/cpfl-troca-nome style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'TRN025\' " href=https://pt.surveymonkey.com/r/cpfl-troca-nome style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'TRN031\' " href=https://pt.surveymonkey.com/r/cpfl-troca-nome style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'TRN033\' " href=https://pt.surveymonkey.com/r/cpfl-troca-nome style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'TRN032\' " href=https://pt.surveymonkey.com/r/cpfl-troca-nome style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'@APP-SUCCESS-NLG062\' " href=https://pt.surveymonkey.com/r/cpfl-ligacao-nova style="color: #006699">clique aqui</a> <a ng-if="resultado.resultado.codServico == \'@APP-SUCCESS-NLG059\' " href=https://pt.surveymonkey.com/r/cpfl-ligacao-nova style="color: #006699">clique aqui</a> .</p></div></div></div><div id=botoes><div class=row><div class=buttons><div class="col-xs-24 col-md-6" ng-if=resultado.resultado.reenviarEmail><button id=btnVoltar class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-REENVIAR-EMAIL ng-click=resultado.reenviarEmail();></button></div></div></div><div class=row><div class=buttons><div ng-if=resultado.resultado.protocolo><div class="col-xs-24 col-md-6 hidden-xs hidden-sm"><button id=btnImprimir class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-IMPRIMIR ng-click=resultado.imprimir();></button></div><div class="col-xs-24 col-md-6"><button id=btnEnviarPorEmail class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-ENVIAR-POR-EMAIL ng-click=resultado.exibirModalEnviarPorEmail();></button></div><div class="col-xs-24 col-md-6"><button id=btnBaixarPdf class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-BAIXAR-PDF ng-click=resultado.baixarPDF();></button></div><div class="col-xs-24 col-md-6"><button id=btnVoltar class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-VOLTAR ui-sref=app.home></button></div></div><div ng-if=!resultado.resultado.protocolo><div class="col-xs-24 col-md-8 col-pull-md-16"><button id=btnOK class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-OK ui-sref=app.home></button></div></div><div ng-if=resultado.resultado.botaoSms><div class="col-xs-24 col-md-6"><button class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-REENVIAR-SMS ng-click=resultado.reenviarSMS();></button></div></div></div></div></div><div id=listaCredenciados ng-if=resultado.resultado.agenciasCredenciados><agencias-credenciados agencias-credenciados=resultado.resultado.agenciasCredenciados></agencias-credenciados></div></div>');
a.put("modules/common/views/tarifa-social.html","<style>.saiba-mais .titulo {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 18px;\r"+"\n"+"        margin-bottom: 3px;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .subtitulo {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 14px;\r"+"\n"+"        margin-bottom: 5px;\r"+"\n"+"        text-decoration: underline;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .subtitulo-verde {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 14px;\r"+"\n"+"        margin-bottom: 5px;\r"+"\n"+"        color: #C8D748;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .separador {\r"+"\n"+"        margin-bottom: 2em;\r"+"\n"+"        border-top: 5px solid #C8D748;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais #demonstrativo span {\r"+"\n"+"        display: inline-block;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais ul.setas {\r"+"\n"+"        list-style: none;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .setas li:before {\r"+"\n"+'        content: "» ";\r'+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas {\r"+"\n"+"        background-color: #F2F0F0;\r"+"\n"+"        text-align: center;\r"+"\n"+"        border-collapse: collapse;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas tr:nth-child(even) {\r"+"\n"+"        background-color: #F7F7F7;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas tr, td {\r"+"\n"+"        padding: 9px;\r"+"\n"+"        border: 1px solid #FFF;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .green {\r"+"\n"+"        color: #C8D748 !important;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .bold {\r"+"\n"+"        font-weight: bold;\r"+"\n"+'    }</style><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-TARIFA-SOCIAL-TITULO></li></ol></div></div><div class=row><div class=col-xs-24><h1>Tarifa Social</h1></div></div><div class=row><div class=col-xs-24><p>A Agência Nacional de Energia Elétrica - ANEEL, por meio da Resolução 414 de 09 de setembro de 2010, definiu os critérios para cadastramento e faturamento dos clientes residenciais na Tarifa Social de Energia Elétrica.</p><p>As unidades consumidoras serão classificadas nas Subclasses Residencial Baixa Renda, desde que sejam utilizadas por:</p><p>I - família inscrita no Cadastro Único para Programas Sociais do Governo Federal? Cadastro Único, com renda familiar mensal per capita menor ou igual a meio salário mínimo nacional; ou</p><p>II - quem receba o Benefício de Prestação Continuada da Assistência Social? BPC, nos termos dos arts. 20 e 21 da Lei no 8.742, de 7 de dezembro de 1993; ou</p><p>III - família inscrita no Cadastro Único com renda mensal de até 3 (três) salários mínimos, que tenha portador de doença ou patologia cujo tratamento ou procedimento médico requeira o uso continuado de aparelhos, equipamentos ou instrumentos que, para o seu funcionamento, demandem consumo de energia elétrica.*</p><p>Caso você não esteja inscrito no Cadastro Único para Programas Sociais do Governo Federal, procure o mais rápido possível a prefeitura municipal para informações de como se cadastrar.</p><p>Mas, se você possui inscrição no Cadastro Único, ou Benefício de Prestação Continuada da Assistência Social ? BPC (Auxílio ao Idoso ou Auxílio ao Deficiente) é necessário informar os seguintes documentos à CPFL:</p><ul class=setas><li><b>Número do NIS</b> (Número de Identificação Social); ou</li><li><b>Número do NB</b> (Número do Benefício); e</li><li><b>CPF</b>;e</li><li><b>RG</b>; ou</li><li><b>Outro documento</b>: na inexistência do RG, outro documento oficial com foto - original (direto na agência) ou cópia simples (se for enviado por correio) e;</li><li><b>Número do "Seu Código"</b> que consta na conta de energia elétrica do imóvel.</li></ul><p>O cadastramento pode ser efetuado pelos nossos diversos canais de atendimento:</p><ul class=setas><li>Fale Conosco</li><li>Chat</li><li>Call Center</li><li>Agência de Atendimento</li><li>Correspondência (Rodovia Campinas Mogi - Mirim n. 1.755 Km 2,5, Jardim Santana, CEP: 13088-900. A/C DCNS, Bloco VI, Térreo,)</li></ul><br><p><i>*Além da documentação acima, é necessário e relatório e atestado médico contendo: Identificação da CID - Classificação Internacional de Doenças, identificação do número do CRM - Conselho Regional de Medicina, do médico, descrição dos aparelhos ou instrumentos com número de horas mensais de utilização, e o endereço da UC.</i></p></div></div>');a.put("modules/common/views/termo-uso.html","<div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-TERMO-DE-USO></li></ol></div></div><div class=row><div class=col-xs-24><h1>Termos de uso</h1></div></div><div class=row><div class=col-xs-24><h4 class=titulo></h4><div class=separador></div><h2>Acordo entre o usuário E CPFL Energia</h2><p>O site/aplicativo CPFL Energia é compreendido por várias páginas, operadas pela CPFL Energia.<br>O site/aplicativo CPFL Energia é oferecido a todos os usuários condicionando a aceitação do presente Termo de Uso e da Política de Privacidade em seu teor integral. O uso do site/aplicativo CPFL Energia deve estar sempre de acordo com todos os termos, circunstâncias e observações feitas aqui.</p><h2>Modificação destes termos de uso</h2><p>A CPFL Energia reserva-se ao direito de modificar os presentes Termos de Uso, as circunstâncias, as observações e o conteúdo que o site/aplicativo CPFL Energia oferece a qualquer momento.</p><h2>Links a sites de terceiros</h2><p>O site CPFL Energia pode conter links a outros sites da Internet, os quais somente são acionados mediante ação física do usuário. Os locais referenciados não estão sob o domínio e controle de CPFL Energia e, portanto, a CPFL Energia não se responsabiliza pelo conteúdo destes, incluindo URLs inválidas ou quaisquer mudanças de conteúdo ou atualizações de um local referenciado por estes links. A CPFL Energia não é responsável pela transmissão de formulários emitidos a partir de qualquer site linkado. A CPFL Energia está fornecendo estas informações somente como uma conveniência e não indica nenhum endosso de CPFL Energia a seus operadores e nem que está de acordo com as informações fornecidas.</p><h2>Uso indevido ou ilegal</h2><p>Como condição de uso do site/aplicativo CPFL Energia, o usuário compromete-se a não usar o site/aplicativo CPFL Energia para toda e qualquer finalidade que seja imoral, ilegal ou proibida perante o presente Termo de Uso. O usuário não pode usar o site/aplicativo CPFL Energia de nenhuma maneira que possa afetar, em qualquer grau, incapacitar, ou danificar o site/aplicativo CPFL Energia ou, inclusive, interferir no uso de outros usuários do site/aplicativo CPFL Energia. O usuário não pode obter, ou tentar obter, materiais ou informações restritas que estejam ou se tornem disponíveis de forma não intencional, ou fornecidas através de terceiros não autorizados. Caso seja identificado o uso indevido do site/aplicativo CPFL Energia, a CPFL Energia se reserva ao direito de remover o acesso do usuário à respectiva plataforma, sem prejuízo das demais ações cabíveis de acordo com a legislação.</p><h2>Uso dos serviços de comunicação</h2><p>O site/aplicativo CPFL Energia pode fornecer serviços de publicações de boletins, áreas de bate-papo, grupos de notícias, fóruns, comunidades, páginas pessoais, calendários, e/ou outras facilidades de comunicação, projetadas para permitir ao usuário comunicar-se com o público em geral ou com um grupo específico. O usuário concordará em usar os serviços de comunicação somente para emitir e receber as mensagens e materiais que são apropriados e relacionados ao serviço deste site/aplicativo. O usuário, ao usar um serviço de comunicação deste site/aplicativo, não deverá:</p><p><ul><li>Difamar, abusar, ameaçar ou violar de qualquer maneira os direitos legais (tais como direitos de privacidade e de publicação) de outros;</li><li>Publicar, postar, realizar upload, distribuir ou disseminar tópicos, nomes, materiais ou informações impróprias, profanas, obscenas, indecentes ou ilegais;</li><li>Realizar uploads de arquivos que contenham softwares ou qualquer outro material protegido por leis de propriedade intelectual ou direitos autorais, a menos que o usuário possua direitos expressos de controle ou todos os consentimentos necessários para esta finalidade;</li><li>Realizar uploads de arquivos que contenham vírus, arquivos corrompidos, ou outro software ou programa similar que possa danificar a operação do computador de outros usuários;</li><li>Anunciar ou oferecer a venda ou compra de bens ou serviços para qualquer finalidade de negócio, a menos que tal serviço de comunicação seja permitido especificamente e expressamente pelo administrador do portal;</li><li>Conduzir ou passar para outros exames, competições, esquemas de pirâmides, correntes ou qualquer mensagem caracterizada como spam;</li><li>Realizar downloads de arquivos postados por um outro usuário deste serviço, sabendo que o conteúdo deste não possa ser legalmente distribuído de tal maneira;</li><li>Falsificar ou suprimir todas as observações legais ou outras atribuições do autor, ou designações ou marcas proprietárias da origem ou a fonte do software ou o outro material contido em um arquivo disponível;</li><li>Restringir ou inibir qualquer usuário de usar e de acessar os serviços deste site/aplicativo;</li><li>Violar o código de conduta ética ou outros códigos que possam ser aplicáveis para qualquer serviço deste site/aplicativo.</li><li>Coletar quaisquer informações sobre outra pessoa, incluindo, mas não se limitando aos endereços de e-mail, nome etc, sem seu prévio consentimento;</li><li>Violar todas ou alguma das leis ou regulamentos aplicáveis, inclusive as dispostas no presente Termo de Uso e na Política de Privacidade;</li></ul></p><p>A CPFL Energia reserva-se ao direito de rever os materiais postados neste serviço de comunicação e remover todos os materiais disponibilizados que julgar impróprios. A CPFL Energia reserva-se ao direito de restringir a qualquer momento o acesso de qualquer usuário a alguns ou a todos os serviços de comunicação deste site por qualquer razão que julgar relevante.</p><p>Nunca forneça suas informações de identificação pessoal deste serviço de comunicação à terceiros.</p><p>Os materiais publicados nos portais e ambientes online da CPFL Energia podem estar sujeitos às limitações de uso, na reprodução e/ou na disseminação. O usuário é responsável por aderir a tais limitações se o mesmo efetuar o download destes.</p><h2>Materiais fornecidos a CPFL Energia ou postados no site/aplicativo CPFL Energia</h2><p>A CPFL Energia não reivindica a posse nem a propriedade dos materiais fornecidos à CPFL Energia, uploads que não estão em conformidade com CPFL Energia ou a qualquer de seus serviços associados. Entretanto, postando, fornecendo ou submetendo informações, o usuário estará concedendo a CPFL Energia, e suas companhias afiliadas as permissões necessárias para usar estas informações na forma em que foram fornecidas para este site/aplicativo, sem limitações aos seguintes direitos: cópia, distribuição, transmissão, reprodução, edição, tradução e reformatação da informação fornecida; e para publicar seu nome em relação a estas informações.</p><p>Nenhuma compensação será paga pelo uso dos dados dos usuários. A CPFL Energia se reserva ao direito de não apresentar ou usar todos os dados que os usuários forneceram.</p><p>Ao postar, fornecer ou submeter seus dados, o usuário autoriza a CPFL Energia a controlar os direitos que lhe é concedida, conforme determinações legais, sobre o seu cadastro, agindo sobre este dentro do que a legislação permite.</p><h2>Responsabilidades</h2><p>A informação, o software, os produtos e os serviços incluídos ou disponibilizados no site/aplicativo CPFL Energia podem incluir incorreções ou erros tipográficos. As mudanças são realizadas periodicamente com relação a estas informações. A CPFL Energia e/ou seus fornecedores podem fazer melhorias e/ou mudanças no site/aplicativo CPFL Energia a qualquer momento que julgar necessário, visando a melhoria da experiência do usuário com o site/aplicativo da CPFL Energia.</p><p>A CPFL Energia e/ou seus fornecedores não serão, em nenhuma hipótese, responsáveis por quaisquer danos diretos, danos indiretos, punitivos, acidentais, especiais, consequenciais, perdas, lucros cessantes ou quaisquer danos pela perda de uso, dados ou lucros, que sejam justificadas por qualquer falha na conexão ou pelo desempenho do site/aplicativo.</p><h2>Limitação de termos de acesso</h2><p>A CPFL Energia se reserva ao direito de restringir a qualquer usuário o acesso ao site/aplicativo CPFL Energia, aos serviços relacionados a qualquer parte do portal no momento que julgar necessário. O uso do site/aplicativo CPFL Energia é desautorizado em toda a jurisdição em que estes termos não tenham efeito legal. A menos que especificado de outra maneira, este acordo constitui o acordo completo entre o usuário e CPFL Energia.</p><p>A CPFL Energia arquiva pelo prazo de 5 (cinco) anos todas comunicações entre a CPFL Energia e seus clientes, independentemente da forma a qual essa comunicação fora recebida, seja de forma eletrônica, oral ou escrita. A comunicação deverá ser realizada somente entre o usuário e CPFL Energia. Uma versão impressa deste acordo e de todas as observações fornecidas no formulário eletrônico serão admissíveis nas continuações judiciais ou administrativas baseadas ou relacionadas a este acordo.</p><h2>As marcas registradas</h2><p>Os nomes de companhias reais e dos produtos mencionados neste site são marcas registradas de seus respectivos proprietários.</p><p>Todos os direitos concedidos expressos ou não neste site são reservados.</p><h2>Observações dos direitos reservados e da marca registrada</h2><p>© CPFL Energia 2019. Todos os direitos reservados. Seus fornecedores detém todos os direitos reservados sob as informações contidas neste site.</p></div></div>");a.put("modules/common/views/tributos.html","<style>.saiba-mais .titulo {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 18px;\r"+"\n"+"        margin-bottom: 3px;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .subtitulo {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 14px;\r"+"\n"+"        margin-bottom: 5px;\r"+"\n"+"        text-decoration: underline;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .subtitulo-verde {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 14px;\r"+"\n"+"        margin-bottom: 5px;\r"+"\n"+"        color: #C8D748;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .separador {\r"+"\n"+"        margin-bottom: 2em;\r"+"\n"+"        border-top: 5px solid #C8D748;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais #demonstrativo span {\r"+"\n"+"        display: inline-block;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais ul.setas {\r"+"\n"+"        list-style: none;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .setas li:before {\r"+"\n"+'        content: "» ";\r'+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas {\r"+"\n"+"        background-color: #F2F0F0;\r"+"\n"+"        text-align: center;\r"+"\n"+"        border-collapse: collapse;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"        .saiba-mais .tabela-aliquotas tr:nth-child(even) {\r"+"\n"+"            background-color: #F7F7F7;\r"+"\n"+"        }\r"+"\n"+"\r"+"\n"+"        .saiba-mais .tabela-aliquotas tr, td {\r"+"\n"+"            padding: 9px;\r"+"\n"+"            border: 1px solid #4d4d4d;\r"+"\n"+"        }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .green {\r"+"\n"+"        color: #C8D748 !important;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .bold {\r"+"\n"+"        font-weight: bold;\r"+"\n"+'    }</style><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-TRIBUTOS-TITULO></li></ol></div></div><div class=row><div class=col-xs-24><h1>Tributos Municipais, Estaduais e Federais</h1></div></div><div class=row><div class=col-xs-24><h5 class=subtitulo-verde>Tributos Federais</h5><p>É obrigação da distribuidora levar a energia elétrica aos seus consumidores.</p><p>Para cumprir esse compromisso, a empresa tem custos que devem ser cobertos pela tarifa de energia.</p><p>De modo geral, a conta de luz inclui o ressarcimento dos custos com:</p><ul><li>Geração de energia;</li><li>Transmissão + distribuição (Transporte de energia até as casas / Fio)</li><li><b>Encargos e TRIBUTOS</b></li></ul><p>O objetivo aqui é levar informações sobre a cobrança dos tributos.</p><ul class=setas><li>PIS - Programa de Integração Social.</li><li>COFINS - Contribuição para o Financiamento da Seguridade Social.</li></ul><p>Estas contribuições são exigidas pela União por meio de lei e asseguram recursos para que o Governo desenvolva atividades voltadas ao trabalhador e sociais do Governo Federal.</p><p>À CPFL, mediante as atividades prestadas em sua área de concessão, lhe cumpre a tarefa de arrecadar as quantias incidentes sobre o faturamento das Notas Fiscais/Conta de Energia Elétrica e repassá-las ao cofre Estadual e Federal.</p><p>O <b>PIS/COFINS</b> estavam embutidos nas tarifas de energia elétrica e eram reajustadas quando dos reajustes periódicos das tarifas.</p><p>A partir da edição das Leis nº 10.637/2002, 10.833/2003 e 10.865/2004, o PIS/COFINS tiveram suas alíquotas fixadas em <b>1,65% e 7,6%, respectivamente</b>, passando a ser apuradas de <b>forma não cumulativa.</b></p><p>O regime anterior, denominado "cumulativo", define-se pela aplicação das alíquotas de 0,65% para PIS e de 3,00% para COFINS sobre o total de receita bruta auferida e o novo regime, denominado ?não cumulativo?, define-se pela aplicação das alíquotas de 1,65% para PIS e de 7,6% para COFINS sobre o total líquido entre a receita bruta e determinados abatimentos permitidos nas bases legais citadas.</p><p>O Setor Elétrico, de um modo geral, a exemplo de outros segmentos da economia, enquadra-se no regime não cumulativo.</p><p>As alterações na forma de cálculo e de recolhimento destas contribuições implicaram em retirar da tarifa de energia o PIS e COFINS quando da homologação pela ANEEL das tarifas a serem praticadas, e sendo transferida a responsabilidade pelo cálculo e repasse diretamente às distribuidoras de Energia Elétrica.</p><p>Por conta desse novo critério de cálculo as alíquotas de PIS/COFINS apuradas a serem repassadas via faturamento na conta de luz variam de um mês para o outro, são apresentadas na própria conta de energia elétrica e calculadas com base no conceito universal de formação de preço: ?cálculo por dentro?.</p><p>A variação deve-se ao fato de estar diretamente relacionado ao volume de créditos (custos) e débitos (vendas) apurados mensalmente pelas distribuidoras.</p><p>A metodologia de cálculo do repasse dessas contribuições estão em conformidade com as especificações da Nota Técnica nº 115/2005-SFF/SER/ANELL de 18/04/05, em substituição ao modelo de repasse de custos de PIS e COFINS até então praticado.</p><p>Em suma, as Concessionárias de Energia Elétrica do Grupo CPFL Energia adotam a aplicação das normas estabelecidas pela Agencia Nacional de Energia Elétrica ? ANEEL, observando-se estritamente a sistemática de cálculo estabelecida.</p><p><b>Vide exemplos de cálculos no ítem 4</b> - EXEMPLO DE CÁLCULO DOS TRIBUTOS COBRADOS NA SUA CONTA DE ENERGIA ELÉTRICA.</p><p>Deve ser observado que o PIS/COFINS compõem o valor do ICMS, não incidindo sobre a CIP - Contribuição para Custeio do Serviço de Iluminação Pública.</p><br><h5 class=subtitulo-verde>Tributo Estadual</h5><p><b>ICMS</b> - Imposto sobre Circulação de Mercadorias e Serviços, regulamento aprovado pelo Decreto 45.490/00.</p><p>Para fins tributários, a energia elétrica é considerada mercadoria, sendo o imposto instituído no âmbito do Estado do SP através da Lei 6.374/89, e que posteriormente foi substituída pela atual Lei 13.918/09.</p><p>Previsto no artigo 155 da Constituição Federal de 1988, o ICMS incide sobre as operações relativas à circulação de mercadorias e serviços e é de competência dos governos Estaduais e do Distrito Federal.</p><p>É regulamentado pelo Código Tributário Nacional- CTN, ou seja, é um conjunto de leis que instituiu as principais normas de direito tributário exigidas pela Constituição Federal.</p><p>A distribuidora tem a obrigação de realizar a cobrança do ICMS direto na fatura e repassá-lo integralmente ao Governo Estadual.</p><p>É um imposto calculado "por dentro", conforme prevê o artigo 33 do Convênio ICM66/88.</p><p>O montante do imposto integra sua própria base de cálculo, constituindo o destaque mera indicação para fins de controle. Tal dispositivo refletido na lei estadual não é inovação, pois o próprio CTN - Código Tributário Nacional, na redação dada pelo artigo 1º do Ato Complementar nº 27, de 08.12.66, já definia dessa forma o cálculo do ICMS, em seu artigo 53, parágrafo 4º.</p><p>Para operacionalizar o cálculo conforme disposto no artigo nº 33 é, adotada a <b>fórmula</b> a seguir:</p><p>ICMS = [R$ valor da Energia fornecida (consumo/demanda)] X [1/(1 - Alíquota)] - 1</p><p>Portanto, no cálculo da energia, como no de qualquer produto, o valor do ICMS faz parte do valor da operação, que é a base de cálculo.</p><p>Segue tabela com os percentuais de cobrança por faixa de consumo em kW/h, conforme a classe da unidade consumidora:</p><br><p><b>ALÍQUOTA DE ICMS - ENERGIA ELÉTRICA ESTADO DE SÃO PAULO - DECRETO nº 43.080/02 DECRETO N° 45.490 DE 30/11/2000</b></p><table class="tabela-aliquotas col-md-offset-1"><tr><td class=text-left>Classes</td><td>Consumo (kWh)</td><td>Alíquota</td><td>Base legal</td></tr><tr><td class=text-left>Industrial</td><td></td><td>18%</td><td>Artigo 52, Inciso I do RICMS/00</td></tr><tr><td class=text-left>Comercial</td><td></td><td>18%</td><td>Artigo 52, Inciso I do RICMS/00</td></tr><tr><td class=text-left>Rural</td><td>Com cadastro</td><td>0%</td><td>Artigo 8º e Anexo I, Artigo 29 do RICMS/00 (Isenção)<br></td></tr><tr><td class=text-left>Rural</td><td></td><td>18%</td><td>Artigo 52, Inciso I, do RICMS/00</td></tr><tr><td class=text-left>Residencial</td><td>até 90 Kwh<br></td><td>0%</td><td>Artigo 8º e Anexo I, Artigo 29 do RICMS/00 (Isenção)<br></td></tr><tr><td class=text-left>Residencial</td><td>de 91Kwh até 200 Kwh</td><td>12%</td><td>Artigo 52, Inciso V, Letra A, do RICMS/00</td></tr><tr><td class=text-left>Residencial</td><td>acima 200 Kwh</td><td>18%</td><td>Lei complementar 194/22 - Comunicado SPF SP</td></tr><tr><td class=text-left>Poder Público</td><td></td><td>0%</td><td>Artigo 8º e Anexo I, Artigo 55 do RICMS/00 (Isenção)</td></tr><tr><td class=text-left>Poder Público</td><td></td><td>18%</td><td>Artigo 52, Inciso I, do RICMS/00</td></tr><tr><td class=text-left>Serviço Público</td><td></td><td>12%</td><td>Artigo 52, Inciso V, Letra C do RICMS/00</td></tr><tr><td class=text-left>Serviço Público</td><td></td><td>18%</td><td>Artigo 52, Inciso I, do RICMS/00</td></tr><tr><td class=text-left>Iluminação Pública</td><td></td><td>18%</td><td>Artigo 52, Inciso I do RICMS/00</td></tr><tr><td class=text-left>Embaixadas Diplomáticas</td><td></td><td>0%</td><td>Artigo 8º e Anexo I, Artigo 71 do RICMS/00 (Isenção)</td></tr><tr><td class=text-left>Cooperativas Eletrific. Rural</td><td></td><td>0%</td><td>Artigo 328º do RICMS/00 (Diferimento)</td></tr><tr><td class=text-left>Consumo Próprio</td><td></td><td>18%</td><td>Artigo 52, Inciso I do RICMS/00</td></tr></table><br><p><b>ALIQUOTAS DO ICMS - FORNECIMENTO DE ENERGIA ELÉTRICA ESTADO DE MINAS GERAIS - RICMS/MG - DECRETO nº 43.080/02</b></p><table class="tabela-aliquotas col-md-offset-1"><tr><td class=text-left>Classes</td><td>Consumo (kWh)</td><td>Alíquota</td><td>Base legal</td></tr><tr><td class=text-left>Industrial</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - Comercial</td><td></td><td>18%</td><td>Lei Complementar 194/22 e Decreto n° 48.456/2022</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - Serviço de Transporte</td><td>Exceto Tração Elétrica</td><td>18%</td><td>Lei Complementar 194/22 e Decreto n° 48.456/2022</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - Adm. Condominial</td><td></td><td>18%</td><td>Lei Complementar 194/22 e Decreto n° 48.456/2022</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - Iluminação Rodovias</td><td></td><td>18%</td><td>Lei Complementar 194/22 e Decreto n° 48.456/2022</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - Templos de Cultos Religiosos</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - Templos de Cultos Religiosos</td><td></td><td>0%</td><td>Anexo I - Item 207 das Isenções - RICMS/MG</td></tr><tr><td class=text-left>Comercial, Serv. e Outras Ativ. - imóveis das entidades religiosas, das entidades beneficentes educacionais, de assistência social ou de saúde, inclusive filantrópicas, e dos hospitais públicos e privados</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Rural</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Rural - Irrigante Noturno</td><td></td><td>7%</td><td>Art. 42,inciso I, letra "d4", do RICMS/MG</td></tr><tr><td class=text-left>Rural - Irrigante Diurno</td><td></td><td>12%</td><td>Art. 42,inciso I, letra "b14" do RICMS/MG</td></tr><tr><td class=text-left>Rural do IDENE (*)</td><td></td><td>0%</td><td>Anexo I - Item 139 das Isenções - RICMS/MG</td></tr><tr><td class=text-left>Residencial</td><td></td><td>18%</td><td>Lei Complementar 194/22 e Decreto n° 48.456/2022</td></tr><tr><td class=text-left>Residencial Baixa Renda / Indigena / Quilombola / Baixa Renda Beneficio de Prestação Continuada da Assistência Social-BPC / Baixa Renda Multifamiliar</td><td>Média de até 3 KWh por dia</td><td>0%</td><td>Anexo I - Item 79a das Isenções do RICMS/MG</td></tr><tr><td class=text-left>Residencial Baixa Renda - Parcela da Subvençaõ Tarifária</td><td></td><td>0%</td><td>Parcela da Subvençaõ Tarifária - Item 165 Anexo I</td></tr><tr><td class=text-left>Poder Público - Estadual</td><td></td><td>0%</td><td>Anexo I - Item 79c das Isenções - RICMS/MG</td></tr><tr><td class=text-left>Poder Público - Instituições Ensino Superior / Hospitais Públicos</td><td></td><td>6%</td><td>Art. 42,inciso I, § 18, do RICMS/MG</td></tr><tr><td class=text-left>Poder Público - Federal / Municipal</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Iluminação Pública</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Serviço Público</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Serv. Transporte Tração Elétrica</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr><tr><td class=text-left>Consumo Próprio</td><td></td><td>18%</td><td>Art. 42,inciso I, letra "e" do RICMS/MG</td></tr></table><br><p><b>ALIQUOTAS DO ICMS - FORNECIMENTO DE ENERGIA ELÉTRICA ESTADO DO PARANÁ - RICMS/PR - DECRETO N° 7.871/2017</b></p><table class="tabela-aliquotas col-md-offset-1"><tr><td class=text-left>Classes</td><td>Consumo (kWh)</td><td>Alíquota</td><td>Base legal</td></tr><tr><td class=text-left>Industrial</td><td></td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Comercial</td><td></td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Templos Religiosos</td><td></td><td>0%</td><td>Item 80 do Anexo V - Isenções, do art. 4 do RICMS/PR</td></tr><tr><td class=text-left>Rural</td><td>Eletrificação Rural</td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Rural</td><td></td><td>0%</td><td>Artigo 31, Item 27.3 do Anexo VIII do Decreto n° 7.871/2017</td></tr><tr><td class=text-left>Residencial</td><td>até 30 Kwh</td><td>0%</td><td>Item 57 do Anexo V - Isenções, do art. 4 do RICMS/PR</td></tr><tr><td class=text-left>Residencial</td><td>acima 30 Kwh</td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Poder Público</td><td></td><td>0%</td><td>Item 56 do Anexo V - Isenções, do art. 4 do RICMS/PR</td></tr><tr><td class=text-left>Poder Público</td><td></td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Iluminação Pública</td><td></td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Serviço Público</td><td></td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Consumo Próprio</td><td></td><td>18%</td><td>Lei Complementar n° 194/2022 e Boletim Informativo n° 05/2022</td></tr><tr><td class=text-left>Missões diplomaticas,<br>repartições consulares</td><td></td><td>0%</td><td>Item 105, do Anexo V - Isenções, do art. 4 do RICMS/PR</td></tr><tr><td class=text-left>Residencial - Baixa Renda<br>Luz Fraterna</td><td>Consumo igual<br>ou inferior 120 kwhh</td><td>0%</td><td>Item 58-A, do Anexo V - Isenções, do art. 4 do RICMS/PR</td></tr></table><br><p><b>ALIQUOTAS DO ICMS - FORNECIMENTO DE ENERGIA ELÉTRICA ESTADO DE RIO GRANDE DO SUL - Decreto n° 37.699/97</b></p><table class="tabela-aliquotas col-md-offset-1"><tr><td class=text-left>Classes</td><td>Consumo (kWh)</td><td>Alíquota</td><td>Base legal</td></tr><tr><td class=text-left>Industrial com cadastro</td><td></td><td>17%</td><td>Art. 27,inciso X, do RICMS/RS</td></tr><tr><td class=text-left>Industrial sem cadastro</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Industrial Complexo GM</td><td></td><td>0%</td><td>Apêndice II, Seção I,Item XV, letra c - ENERGIA ELETRICA</td></tr><tr><td class=text-left>Comercial</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Comercial - Consulados</td><td></td><td>0%</td><td>Art. 9º, Inciso XLVIII, alínea "a" do RICMS/RS (Isenções)</td></tr><tr><td class=text-left>Comercial com CAE</td><td></td><td>17%</td><td></td></tr><tr><td class=text-left>Agroindustrial com CAE</td><td></td><td>17%</td><td></td></tr><tr><td class=text-left>Rural Produtor com Inscrição</td><td>até 100 Kwh</td><td>12%</td><td>Art. 27,inciso V - Item XXVI (Apendice I - Seção II) do RICMS/RS - Combinado com o Art. 1º, Livro III - Apêndice II - Seção I - Item XV - letra "b" - Nota 02</td></tr><tr><td class=text-left>Rural Produtor com Inscrição</td><td>Acima 100 Kwh</td><td>0%</td><td>Art. 1º, Livro III - Apêndice II - Seção I - Item XV - letra "b" - Nota 01 - Combinado como o artigo 53 do RICMS/RS (Diferimento).</td></tr><tr><td class=text-left>Rural sem Inscrição</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Associação Hídrica Rural</td><td></td><td>12%</td><td>Art. 27, inciso I(nota), Apêndice I, Seção I, cc Apêndice II, item XV do RICMS/RS.</td></tr><tr><td class=text-left>Residencial e Residencial Baixa Renda</td><td>até 50 Kwh</td><td>12%</td><td>Art. 27,inciso V - Item XXVI (Apendice I - Seção II) do RICMS/RS</td></tr><tr><td class=text-left>Residencial e Residencial Baixa Renda</td><td>acima 51 Kwh</td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Residencial Baixa Renda - Parcela Subvenção</td><td></td><td>0%</td><td>Art. 9º, Inciso CXXVII do RICMS/RS (Isenções)</td></tr><tr><td class=text-left>Poder Público Estadual</td><td></td><td>0%</td><td>Art. 9º, Inciso LXXVII do RICMS/RS (Isenções)</td></tr><tr><td class=text-left>Poder Público</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Iluminação Pública</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Serviço Público</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Consumo Próprio</td><td></td><td>17%</td><td>Lei Complementar n° 194/22 e Decreto n° 56.573/2022</td></tr><tr><td class=text-left>Concessionária/Geradora/Permissionárias</td><td></td><td>0%</td><td>Apêndice II, Seção I,Item XV, letra a - ENERGIA ELETRICA</td></tr></table><br><p><b>OBSERVAÇÕES RELEVANTES</b></p><p>Consumidor da classe rural e inscrito no Cadastro de Contribuintes do ICMS junto à SEFAZ ? Secretaria da Fazenda do Estado de São Paulo, que comprovar à CPFL, por meio do documento CADESP (vide site da SEFAZ www.fazenda.sp.gov.br), que explora atividade produtiva rural (Ex: Agropecuária, agricultura, aquicultura, entre outras), poderá ter a isenção da cobrança do imposto. Bastando para tanto que formalize a solicitação junto à empresa por meio dos canais de atendimento disponibilizados e faça as devidas comprovações.</p><br><h5 class=subtitulo-verde>Tributo Municipal</h5><p><b>CIP - Contribuição para Custeio do Serviço de Iluminação Pública</b></p><p>Além dos tributos mencionados acima, a conta de energia elétrica é utilizada para arrecadação da contribuição para custeio do serviço de iluminação pública (prevista em lei municipal) para as Prefeituras que efetuam essa cobrança e mantém convênio com a CPFL.</p><p>Contribuição Municipal (Contribuição de Iluminação Pública - variável de acordo com o município).</p><p>Previsto no artigo 149-A da Constituição Federal do Brasil de 1988 que estabelece, entre as competências dos municípios, dispor, conforme lei específica aprovada pela Câmara Municipal, a forma de cobrança e a base de cálculo da Contribuição.</p><p>É atribuída ao Poder Público Municipal toda e qualquer responsabilidade pela operacionalização e manutenção das instalações de iluminação pública.</p><p>A concessionária apenas arrecada a referida contribuição de iluminação pública e repassa para os respectivos municípios.</p><p>A CIP é a principal fonte de recursos para a ampliação dos pontos de iluminação pública, aumento do potencial de Iluminação já instalado, manutenção e pagamento do consumo da Iluminação Pública.</p><br></div></div>');
};a.$inject=["$templateCache"];if(angular.element(document.body).injector()){var b=angular.element(document.body).injector().get("$templateCache");a(b)}angular.module("cpflAgenciavirtualWeb.common").run(a)})();