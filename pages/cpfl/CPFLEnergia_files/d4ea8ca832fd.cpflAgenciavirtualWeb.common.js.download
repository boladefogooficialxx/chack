spostaN2.descricao}}</span></label></div></div><div class="buttons col-xs-24 col-md-8 col-md-push-16"><button ng-click=vm.salvarPesquisa() id=btnSalvarPesquisa type=button class="btn btn-default btn-lg btn-block pull-right col-3" translate=@APP-COMMON-PESQUISA-SATISFACAO-SALVAR></button></div></div></div><div class=col-xs-24 ng-if=vm.enviado><span translate=@APP-COMMON-PESQUISA-SATISFACAO-ENVIADO></span></div></div></section>');a.put("modules/common/directives/recebimento-fatura/recebimento-fatura.html",'<div class=row><div class=col-xs-24><h2 translate={{vm.recebimentoFaturaTitle}}></h2></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=emailFatura class=inputs translate=@APP-COMMON-DIRECTIVE-RECEBIMENTO-FATURA-EMAIL data-required=true></label><input type=email class=form-control id=emailFatura placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.recebimentoFaturaEmail acn-email-validator ng-disabled=!vm.recebimentoFaturaCheckboxDesejoCadastrar ng-required=vm.recebimentoFaturaCheckboxDesejoCadastrar cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=confirmarEmailFatura class=inputs translate=@APP-COMMON-DIRECTIVE-RECEBIMENTO-FATURA-CONFIRMAR-EMAIL data-required=true></label><input type=email class=form-control id=confirmarEmailFatura placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.recebimentoFaturaConfirmarEmail ng-disabled=!vm.recebimentoFaturaCheckboxDesejoCadastrar ng-required=vm.recebimentoFaturaCheckboxDesejoCadastrar acn-confirmation-validator=vm.recebimentoFaturaEmail acn-email-validator cpfl-highlight-input></div></div><div class=col-xs-24><button type=button class="btn btn-link np" translate=@APP-COMMON-DIRECTIVE-RECEBIMENTO-FATURA-LINK-TERMO-ADESAO ng-click=vm.visualizarTermoAdesao();></button></div><div ng-if=vm.recebimentoFaturaMostraCheckboxDesejoCadastrar><div class=col-xs-24><div class=form-group><div class=checkbox><input type=che