ass=hand><div class=col-xs-24><span ng-bind=registro.DescricaoServico class=titleServicoSolicitado></span><br><span translate=@APP-COMMON-DIRECTIVE-ULTIMAS-SOLICITACOES-PROTOCOLO></span><span ng-bind=registro.NumeroAtividade></span><br><span translate=@APP-COMMON-DIRECTIVE-ULTIMAS-SOLICITACOES-ULT-ATUALIZACAO></span><span ng-bind="registro.DataUltimaAtualizacao | date:\'dd/MM\'"></span><br><span translate=@APP-COMMON-DIRECTIVE-ULTIMAS-SOLICITACOES-STATUS></span><span ng-bind=registro.Status translate={{registro.DisplayStatus}}></span></div></a></div></div><a ui-sref=app.consulta-solicitacao class=hand>Pesquisar serviço realizado por protocolo</a></div><div ng-if=vm.showNaoHaSolicitacoes><span translate=@APP-COMMON-DIRECTIVE-ULTIMAS-SOLICITACOES-NAO-HA-SOLICITACOES></span></div></div>');a.put("modules/common/partials/accordion-default.html",'<div><div class="panel panel-default"><a href tabindex=0 class=accordion-toggle ng-click=toggleOpen() uib-accordion-transclude=heading><div class=panel-heading><h4 style="text-align: center" class=panel-title><span uib-accordion-header ng-class="{\'text-muted\': isDisabled}" translate={{heading}}></span></h4></div></a><div class="panel-collapse collapse" uib-collapse=!isOpen><div class=panel-body ng-transclude></div></div></div></div>');a.put("modules/common/partials/banner-promocao-btn.html",'<banner-promocao><div class=row><div class=col-xs-24><img ng-click=bannerPromocaoController.participar() style="cursor: pointer; width: 100%; border-radius: 10px; height: 12em" src=assets/images/banners/banner-cadastro-sorte.jpg alt=""></div></div></banner-promocao>');a.put("modules/common/partials/banner-promocao-ver-numeros.html",'<banner-promocao><div class=row><div class=col-xs-24><img style="cursor: pointer; width: 100%; border-radius: 10px; height: 12em" src=assets/images/banners/banner-cadastro-sorte-3.jpg alt=""></div></div></banner-promocao>');a.put("modules/common/partials/banner-promocao.html",'<banner-promocao><div class=row><di