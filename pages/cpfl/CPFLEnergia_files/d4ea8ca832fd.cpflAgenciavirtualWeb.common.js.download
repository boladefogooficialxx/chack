do.CodigoComplemento3 ng-required="vm.showEnderecoComplementosFlag && !vm.source.form.enderecoSelecionado.CodigoComplemento1 && !vm.source.form.enderecoSelecionado.CodigoComplemento2 && !vm.source.form.enderecoSelecionado.CodigoComplemento3"><ui-select-match placeholder="{{\'@APP-PARCEIRO-NEGOCIO-PLACEHOLDER-SELECIONE-COMPLEMENTO\' | translate}}" allow-clear=true><span style=color:dimgray ng-bind=$select.selected.Descricao></span> <a uib-tooltip=Limpar class="fa fa-times clear-button" style=color:black ng-if=!vm.disabled ng-click=$select.clear($event)></a></ui-select-match><ui-select-choices repeat="complemento.CodTipoComplemento as complemento in vm.complementos.TiposComplemento3 | filter: $select.search | orderBy:\'Descricao\' track by $index"><a class=hand><div ng-bind=complemento.Descricao></div></a></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-angle-down" aria-hidden=true></i></span></div></div><div class="col-xs-24 col-md-12 complemento"><div class=form-group><label for=txcomplemento3 translate=@APP-LIGACAO-NOVA-STEP2-DESC-COMPLEMENTO class=inputs></label><input type=text class=form-control id=txcomplemento3 placeholder=Complemento maxlength=7 ng-disabled=vm.disabled ng-model=vm.source.form.enderecoSelecionado.Complemento3 cpfl-highlight-input ng-required=vm.source.form.enderecoSelecionado.CodigoComplemento3></div></div></div></div></div>');a.put("modules/common/directives/busca-endereco-ou-instalacao/busca-endereco-ou-instalacao.html",'<section id=localizacao><div class=row><div class=col-xs-24><h2 translate={{vm.title}}></h2></div></div><div ng-if=vm.showAlertNumeroEnderecosRetornados><div class=row><div class=col-xs-24><div uib-alert class="alert alert-info" dismiss-on-timeout=10000 close="vm.showAlertNumeroEnderecosRetornados = undefined"><div class="alert-icon info-icon"></div><span translate=@APP-DIRETIVA-BUSCA-END-ENDERECO-MUITOS-ENDERECOS-RETORNADOS class=alert-message></span></div></div></div></div><div ng-if="vm.showBuscaCep != \'false\'"><form name=formProtocoloAtendimento novalidate><h2 translate=@APP-CREDENCIADOS-TITLE-PESQUISA></h2><p translate=@APP-CREDENCIADOS-SUBTITLE-PESQUISA></p><div class=row><div class=col-xs-24><ul class="nav nav-pills nav-justified" ng-init="vm.isInstalacao = true; vm.isDocumento = false; vm.isEndereco = false; vm.isMedidor = false; vm.isNome = false;"><li ng-class="{active: vm.isInstalacao}"><a ng-click="vm.isInstalacao = true; vm.isDocumento = false; vm.isEndereco = false; vm.isMedidor = false;\r'+"\n"+"                                vm.isNome = false; vm.form.instalacao = ''; vm.form.estado = undefined; vm.form.municipio = undefined;\r"+"\n"+'                                vm.alteraStatusForm(formProtocoloAtendimento, \'Unsubmitted\')" data-toggle=tab translate=@APP-COMMON-INSTALACAO></a></li><li ng-class="{active: vm.isEndereco}"><a ng-click="vm.isInstalacao = false; vm.isDocumento = false; vm.isEndereco = true; vm.isMedidor = false;\r'+"\n"+"                                vm.isNome = false; vm.form.endereco = ''; vm.form.estado = undefined; vm.form.municipio = undefined;vm.alteraStatusForm(formProtocoloAtendimento, 'Unsubmitted')\" data-toggle=tab translate=@APP-CREDENCIADOS-TAB-ENDERECO></a></li><li ng-class=\"{active: vm.isMedidor}\"><a ng-click=\"vm.isInstalacao = false; vm.isDocumento = false; vm.isEndereco = false; vm.isMedidor = true;\r"+"\n"+'                                vm.isNome = false; vm.form.medidor = \'\'; vm.form.estado = undefined; vm.form.municipio = undefined;vm.alteraStatusForm(formProtocoloAtendimento, \'Unsubmitted\')" data-toggle=tab translate=@APP-CREDENCIADOS-TAB-MEDIDOR></a></li></ul></div></div><div class="tab-content clearfix"><div ng-if=vm.isInstalacao><div><div class=row><div class=form-group><div class=col-lg-12><label for=instalacao class=inputs translate=@APP-COMMON-DIGITE-CODIGO-TITULO data-required=true></label><input type=text class=form-control id=instalacao maxlength=10 ng-model=vm.pesquisarInstalacao cpfl-highlight-input required autocomplete=off><div class=buttons><button id=encontrarInstalacao type=button class="btn btn-link" ng-click=vm.encontrarInstalacao() translate=@APP-LOGIN-LINK-ENCONTRAR-INSTALACAO></button></div></div><div class=col-lg-12><button type=submit ng-click=vm.continuarPesquisarInstalacao(); class="btn btn-default btn-lg btn-block btn-iniciar-atendimento ng-scope" translate=@APP-CREDENCIADOS-PESQUISAR-INSTALACAO></button></div></div></div></div></div></div><div ng-if=vm.isEndereco><busca-endereco source=vm selected-callback=vm.enderecoDiretiva buscar-endereco-exato=true apenas-concessao=true reativacao={{vm.reativacao}} show-checkbox={{vm.showCheckbox}}></busca-endereco></div><div ng-if=vm.isMedidor><div><div class=row><div class=col-xs-12><div class=form-group><label for=medidor class=inputs translate=@APP-CREDENCIADOS-TAB-MEDIDOR data-required=true></label><input type=text class=form-control id=medidor ng-model=vm.pesquisarMedidor cpfl-highlight-input required></div></div><div class=col-xs-12><button type=submit ng-click=vm.continuarPesquisarMedidor(); class="btn btn-default btn-lg btn-block btn-iniciar-atendimento ng-scope" translate=@APP-CREDENCIADOS-PESQUISAR-INSTALACAO></button></div></div></div></div></form></div></section>');a.put("modules/common/directives/busca-endereco/busca-endereco.html",'<section id=localizacao><div class=row><div class=col-xs-24><h2 translate={{vm.title}}></h2></div></div><div ng-if=vm.showAlertNumeroEnderecosRetornados><div class=row><div class=col-xs-24><div uib-alert class="alert alert-info" dismiss-on-timeout=10000 close="vm.showAlertNumeroEnderecosRetornados = undefined"><div class="alert-icon info-icon"></div><span translate=@APP-DIRETIVA-BUSCA-END-ENDERECO-MUITOS-ENDERECOS-RETORNADOS class=alert-message></span></div></div></div></div><form><div id=buscaLocalizacao ng-if="vm.showBuscaCep != \'false\'"><div ng-show="vm.showNavPills != \'false\'"><div class=row><div class=col-xs-24><ul ng-hide="vm.userPossuiEndereco || vm.hideNavPills" class="nav nav-pills nav-justified" ng-init="vm.isInstalacao = false;vm.isEndereco = true"><li ng-class="{active: vm.isInstalacao}"><a ng-click="vm.isInstalacao = true;vm.isEndereco = false" data-toggle=tab translate=@APP-DIRETIVA-BUSCA-END-INSTALACAO></a></li><li ng-class="{active: vm.isEndereco}"><a ng-click="vm.isInstalacao = false;vm.isEndereco = true" data-toggle=tab translate=@APP-DIRETIVA-BUSCA-END-ENDERECO></a></li></ul></div></div></div><div class="tab-content clearfix"><div ng-if=vm.isInstalacao id=1a><div id=tabInstalacao><div class=row><div class=col-xs-24><div class=form-group><label for=numeroInstalacao class=inputs translate=@APP-DIRETIVA-BUSCA-END-INSTALACAO data-required=true></label><input type=tel class=form-control id=numeroInstalacao ng-model=vm.numInstalacao ng-disabled=vm.continuou placeholder="{{\'@APP-DIRETIVA-BUSCA-END-PLACEHOLDER-INSTALACAO\' | translate}}" cpfl-highlight-input ng-required=vm.isInstalacao></div></div></div><div ng-if=!vm.continuou><div class=row><div class=col-xs-24><button ng-click=vm.abrirModalEncontreCodigo() id=btnInstrucoesCodigo type=button class="btn btn-link pull-right" translate=@APP-DIRETIVA-BUSCA-END-CODIGO-IMOVEL></button></div></div></div></div><div ng-hide="vm.continuou || vm.userPossuiEndereco"><div class=row><div class="col-xs-24 col-md-8 col-md-offset-16"><div class=buttons><button ng-click=vm.getInstalacaoEndereco(vm.numInstalacao) id=btnContinuarInstalacao type=button class="btn btn-default btn-lg btn-block pull-right" translate=@APP-REPAROS-IP-CONTINUAR></button></div></div></div></div></div><div ng-if=vm.isEndereco id=2a><div id=tabEndereco><div id=consultaPorCEP><div ng-hide=vm.sabeCEP><div class=row><div class=col-xs-24><div class=form-group><label for=cep class=inputs translate=@APP-REPAROS-IP-CEP data-required=true></label><input type=tel class=form-control id=cep name=cep ng-model=vm.cep ng-disabled="vm.continuou || vm.disableCep" placeholder="{{\'@APP-COMMON-PLACEHOLDER-CEP\' | translate}}" ng-change="vm.source.cep = vm.cep" custom-cep-mask cpfl-highlight-input ng-required=!vm.sabeCEP></div></div></div></div><div ng-hide="vm.continuou || vm.sabeCEP || vm.userPossuiEndereco || vm.showComplementoEndereco"><div class=row><div class=col-xs-24><button ng-click=vm.naoSeiOCEP(true) id=btnEscolherMunicipio type=button class="btn btn-link pull-right" translate=@APP-REPAROS-IP-NAO-SEI-CEP></button></div></div></div></div><div id=consultaPorMunicipio><div ng-if=vm.sabeCEP><div class=row><div class="col-xs-24 col-md-12"><div class=selectBox><div class=form-group><label class=inputs translate=@APP-REPAROS-IP-ESTADO data-required=true></label><ui-select id=selectEstado ng-model=vm.estado theme=selectize ng-disabled="vm.continuou || !vm.estados || vm.showComplementoEndereco" name=selectEstado ng-change="vm.getMunicipios(vm.estado.Codigo);vm.source.estado = vm.estado" ng-required=vm.sabeCEP><ui-select-match placeholder="{{ \'@APP-REPAROS-IP-SELECIONE-ESTADO\' | translate}}"><span ng-bind=$select.selected.Codigo></span></ui-select-match><ui-select-choices repeat="estado in vm.estados | filter: $select.search"><span ng-bind=estado.Codigo></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-search" aria-hidden=true></i></span></div></div></div><div class="col-xs-24 col-md-12"><div class=selectBox><div class=form-group><label class=inputs translate=@APP-REPAROS-IP-MUNICIPIO data-required=true></label><ui-select id=selectMunicipio ng-model=vm.municipio theme=selectize ng-disabled="vm.continuou || !vm.municipios || vm.showComplementoEndereco" name=selectMunicipio ng-change=vm.changeMunicipio() ng-required=vm.sabeCEP><ui-select-match placeholder="{{ \'@APP-REPAROS-IP-SELECIONE-MUNICIPIO\' | translate}}"><span ng-bind=$select.selected.Nome></span></ui-select-match><ui-select-choices repeat="municipio in vm.municipios | filter: $select.search"><span ng-bind=municipio.Nome></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-search" aria-hidden=true></i></span></div></div></div></div><div ng-if=vm.sabeCEP ng-hide="vm.continuou || vm.showComplementoEndereco" class=row><div class=col-xs-24><button ng-click=vm.naoSeiOCEP(false); id=btnEscolherCEP type=button class="btn btn-link pull-right" translate=@APP-REPAROS-IP-ENCONTRAR-PELO-CEP></button></div></div></div><div ng-hide="vm.continuou || vm.userPossuiEndereco || vm.showComplementoEndereco"><div class=row><div class="col-xs-24 col-md-8 col-md-offset-16"><div class=buttons><button ng-click="vm.continuar(vm.cep, vm.municipio)" id=btnContinuarEndereco type=button class="btn btn-default btn-lg btn-block pull-right" translate=@APP-REPAROS-IP-CONTINUAR></button></div></div></div></div></div></div></div></div></div><div ng-if="vm.continuou || vm.userPossuiEndereco || vm.showComplementoEndereco || vm.showBuscaCep == \'false\'" id=complementoEndereco><div class=row ng-hide=vm.sabeCEP><div class="col-xs-24 col-md-12"><div class=form-group><label for=estadoResultado translate=@APP-REPAROS-IP-ESTADO class=inputs data-required=true></label><input ng-model=vm.estadoCEP type=text ng-disabled=true class=form-control id=estadoResultado></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=municipioResultado translate=@APP-REPAROS-IP-MUNICIPIO class=inputs data-required=true></label><input ng-model=vm.municipioCEP type=text ng-disabled=true class=form-control id=municipioResultado></div></div></div><div class=row><div class="col-xs-24 col-md-16"><div class=form-group><label for=logradouro translate=@APP-REPAROS-IP-LOGRADOURO class=inputs data-required=true></label><input ng-model=vm.logradouro type=text ng-disabled="vm.instalacaoValida || vm.userPossuiEndereco" class=form-control id=logradouro placeholder="{{\'@APP-COMMON-PLACEHOLDER-ENDERECO\' | translate}}" ng-change="vm.source.logradouro = vm.logradouro" cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-4"><div class=form-group><label for=numero translate=@APP-REPAROS-IP-NUMERO class=inputs data-required=true></label><input ng-model=vm.nrImovel ng-disabled="vm.instalacaoValida || vm.userPossuiEndereco || vm.nrDisabled" type=text class=form-control id=numero placeholder="{{vm.detalharParametros.placeholderNumero | translate}}" cpfl-highlight-input ng-change="vm.source.nrImovel = vm.nrImovel" ui-mask={{vm.detalharParametros.mascaraNumero}} required></div></div><div class="col-xs-24 col-md-4" ng-if="vm.showCheckbox == \'true\'"><div class=form-group><label class=hidden-xs for=divCheckbox>&nbsp</label><div id=divCheckbox class=checkbox><input type=checkbox ng-model=vm.sn ng-change=vm.naoPossui() id=sn ng-disabled="vm.instalacaoValida || vm.userPossuiEndereco"><label for=sn translate=@APP-REPAROS-IP-SN></label></div></div></div><div class=col-xs-24 ng-if="vm.showReferencia == \'true\' && vm.source.form.enderecoSelecionado"><div class=form-group><label for=referencia translate=@APP-DIRETIVA-BUSCA-END-REFERENCIA class=inputs data-required=true></label><input ng-model=vm.source.form.enderecoSelecionado.Referencia type=text class=form-control id=referencia placeholder="{{\'@APP-COMMON-PLACEHOLDER-LOCALIZACAO-REFERENCIA\' | translate}}" cpfl-highlight-input required></div></div></div><div class=row><div ng-if="vm.buscarEnderecoExato != \'false\' && !vm.isInstalacao"><div ng-if=!vm.userPossuiEndereco><div class="col-xs-24 col-md-8 col-md-push-16"><div class=buttons><button ng-click=vm.getEnderecos() id=btnBuscarEndereco type=button class="btn btn-default btn-lg btn-block" translate=@APP-DIRETIVA-BUSCA-END-BOTAO-BUSCAR-ENDERECO></button></div></div><div class="col-xs-24 col-md-8"><div class=buttons><button ng-click=vm.limparBusca() id=btnLimparBusca type=button class="btn btn-default btn-secondary btn-lg btn-block" translate=@APP-DIRETIVA-BUSCA-END-BOTAO-NOVA-BUSCA></button></div></div></div></div></div></div></form></section>');
