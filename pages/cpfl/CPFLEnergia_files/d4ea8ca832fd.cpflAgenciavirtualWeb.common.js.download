= \'true\'" only-letters></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=telefone class=inputs translate=@APP-COMMON-SOLICITANTE-TELEFONE data-required=true></label><input type=text class=form-control id=telefone name=telefone placeholder="{{\'@APP-COMMON-PLACEHOLDER-TELEFONE\' | translate}}" ng-model=vm.ngModelTelefone ng-attr-ui-mask="{{vm.ngModelTelefone && vm.returnOnlyNumber(vm.ngModelTelefone).length > 10 ? \'(99) 99999-999?9\' : \'(99) 9999-9999?9\'}}" ui-mask-placeholder ui-mask-placeholder-char=space ng-required="vm.ngModelCamposDisabled != \'true\'" cpfl-highlight-input ng-disabled="vm.ngModelCamposDisabled == \'true\'"></div></div><div class="col-xs-24 col-md-12" ng-if="vm.ngModelShowEmail != \'false\'"><div class=form-group><label for=email class=inputs translate=@APP-COMMON-SOLICITANTE-EMAIL data-required=true></label><input type=email class=form-control id=email name=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.ngModelEmail ng-disabled="vm.ngModelCheckboxEmail || vm.ngModelCamposDisabled == \'true\' || vm.email" ng-required="!vm.ngModelCheckboxEmail && vm.ngModelCamposDisabled != \'true\'" cpfl-highlight-input></div><div ng-if="vm.ngModelShowNaoPossuiEmail != \'false\'"><div class=form-group><div class=checkbox><input type=checkbox id=checkBoxEmail name=checkBoxEmail ng-model=vm.ngModelCheckboxEmail ng-click="vm.limpaEmail(\'email\');vm.ngClickCheckboxEmail();" ng-disabled="vm.ngModelCamposDisabled == \'true\'"><label for=checkBoxEmail translate=@APP-COMMON-SOLICITANTE-NAO-POSSUI></label></div></div></div></div><div class=col-xs-24 ng-if="vm.ngModelShowReferencia == \'true\'"><div class=form-group><label for=referencia class=inputs translate=@APP-COMMON-SOLICITANTE-REFERENCIA data-required=true></label><input type=text class=form-control id=referencia name=referencia placeholder="{{\'@APP-COMMON-PLACEHOLDER-SOLICITACAO-REFERENCIA\' | translate}}" ng-disabled="vm.ngModelCamposDisabled ==