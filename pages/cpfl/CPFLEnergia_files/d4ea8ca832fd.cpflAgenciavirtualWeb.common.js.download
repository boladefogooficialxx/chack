a.put("modules/common/partials/modal-selecionar-opcao-pagar-conta.html",'<div class=cpfl-style><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.close(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-MODAL-SELECIONAR-OPCAO-PAGAMENTO-CONTA-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-selecionar-opcao-pagar-conta></alert></div></div><div class=row><div class=col-xs-24><div class=form-group><label class=inputs translate=@APP-MODAL-SELECIONAR-OPCAO-PAGAR-CONTA-LABEL></label><div class=radio-box><div class="form-group form-group-radio"><label><input type=radio name=opcaoBoleto ng-model=vm.tipoPagamento value=1 required> <span translate=@APP-MODAL-SELECIONAR-OPCAO-PAGAR-CONTA-LABEL-DEBITO></span></label></div><div class="form-group form-group-radio"><label><input type=radio name=opcaoCartaoCredito ng-model=vm.tipoPagamento value=2 required> <span translate=@APP-MODAL-SELECIONAR-OPCAO-PAGAR-CONTA-LABEL-CARTAO-CREDITO></span></label></div></div></div></div></div></div><div class=modal-footer><div id=botoes><div class=row><div class="col-xs-24 col-md-12 col-md-push-6"><button id=btnAceito type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-MODAL-SELECIONAR-OPCAO-PAGAR-CONTA-BTN-CONFIRMAR ng-click=vm.confirmar(vm.tipoPagamento)></button></div></div></div></div></div>');a.put("modules/common/partials/modal-tarifa-branca-informacao.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-TARIFA-BRANCA></h2></div></div></div><div class=modal-body><div class=modalMensagem><div class=row><p translate=@APP-TARIFA-BRANCA-INFO-T1></p><p translate=@APP-TARIFA-BRANCA-INFO-T2></p><div ng-show=vm.horarioNormal><table class=simulador-tarifario><thead><tr><th translate=@APP-TARIFA-BRANCA-HORARIOS class="col-md-3 text-center"></th><th translate=@APP-TARIFA-BRANCA class=col-md-15></th><th translate=@APP-TARIFA-BRANCA-TARIFA-CONVENCIONAL class=col-md-6></th></tr></thead><body><tr><td class=text-center>{{vm.postosHorariosNormais.horarioFora1}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-FORA-PONTA></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr><td class=text-center>{{vm.postosHorariosNormais.horarioInter1}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-INTERMEDIARIO></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr><td class=text-center>{{vm.postosHorariosNormais.horarioPonta}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-PONTA></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr ng-if=vm.postosHorariosNormais.horarioInter2><td class=text-center>{{vm.postosHorariosNormais.horarioInter2}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-INTERMEDIARIO></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr><td class=text-center>{{vm.postosHorariosNormais.horarioFora2}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-FORA-PONTA></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr></body></table></div><div ng-show=!vm.horarioNormal><h2 class=modal-title>Horário de Verão</h2><table class=simulador-tarifario><thead><tr><th translate=@APP-TARIFA-BRANCA-HORARIOS></th><th translate=@APP-TARIFA-BRANCA></th><th translate=@APP-TARIFA-BRANCA-TARIFA-CONVENCIONAL></th></tr></thead><body><tr><td>{{vm.postosHorariosVerao.horarioFora1}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-FORA-PONTA></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr><td>{{vm.postosHorariosVerao.horarioInter1}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-INTERMEDIARIO></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr><td>{{vm.postosHorariosVerao.horarioPonta}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-PONTA></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr ng-if=vm.postosHorariosVerao.horarioInter2><td>{{vm.postosHorariosVerao.horarioInter2}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-INTERMEDIARIO></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr><tr><td>{{vm.postosHorariosVerao.horarioFora2}}</td><td translate=@APP-TARIFA-BRANCA-DEFINICAO-FORA-PONTA></td><td translate=@APP-TARIFA-BRANCA-VALOR-UNICO-TARIFA></td></tr></body></table></div><p><span translate=@APP-TARIFA-BRANCA-INFO-T3></span> <button class="btn btn-instruction" type=button ng-click=vm.toggleHorario()><i class="fa fa-info-circle fa-2x" aria-hidden=true type=button></i></button></p><p translate=@APP-TARIFA-BRANCA-INFO-T4></p><h2 class=modal-title translate=@APP-TARIFA-CONVENCIONAL></h2><p translate=@APP-TARIFA-BRANCA-INFO-T5></p></div></div></div><div class=modal-footer><div id=botoes><div class=row><div class=col-xs-24><button id=btnSimular type=button class="btn btn-default btn-lg btn-block hand col-xs-24 col-md-12" ng-click=vm.abrirModalSimuladorTarifaBranca() translate=@APP-TARIFA-BRANCA-SIMULAR></button></div></div></div></div></div>');a.put("modules/common/partials/modal-tarifa-branca-restringir.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-TARIFA-BRANCA></h2></div></div></div><div class=modal-body><div class=modalMensagem><div class=row><p translate={{vm.msgModal}}></p><p translate=@APP-TARIFA-BRANCA-MODAL-DESEJA-PROSSEGUIR></p></div></div></div><div class=modal-footer><div id=botoes><div class=row><div class="col-xs-24 col-md-12"><button id=btnSim type=button class="btn btn-secondary btn-lg btn-block hand col-xs-24 col-md-12" ng-click=vm.prosseguirTarifaConvencional(); translate=@APP-TARIFA-BRANCA-MODAL-SIM></button></div><div class="col-xs-24 col-md-12"><button id=btnNao type=button class="btn btn-default btn-lg btn-block hand col-xs-24 col-md-12" ng-click=vm.recusarTarifaConvencional() translate=@APP-TARIFA-BRANCA-MODAL-NAO></button></div></div></div></div></div>');a.put("modules/common/partials/modal-tarifa-branca-simulador.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-TARIFA-BRANCA-SIMULADOR-TARIFARIO></h2></div></div></div><div class=modal-body><div class=modalMensagem><div class=row><div class="col-xs-24 col-md-12" style="padding-left: 0"><div class=row><div class="col-xs-24 col-md-16"><strong translate=@APP-TARIFA-BRANCA-SIMULADOR-INFORME-CONSUMO-MENSAL></strong></div><div class="col-xs-24 col-md-8 input-group"><input type=text ng-model=vm.consumo.mensal ng-keyup=vm.calculaConsumoDiario() ui-number-mask=0 class=form-control> <span class=input-group-addon>kWh</span></div></div><br><div class=row><div class="col-xs-24 col-md-16"><strong translate=@APP-TARIFA-BRANCA-SIMULADOR-CONSUMO-DIARIO></strong></div><div class="col-xs-24 col-md-8"><strong>{{vm.consumo.diario | number: 1}} kWh</strong></div></div></div></div><br><div class=row><p translate=@APP-TARIFA-BRANCA-SIMULADOR-T1></p><p><strong ng-show=!vm.horarioVerao translate=@APP-TARIFA-BRANCA-SIMULADOR-HORARIO-NORMAL></strong> <strong ng-show=vm.horarioVerao translate=@APP-TARIFA-BRANCA-SIMULADOR-HORARIO-VERAO></strong></p><div class=row><div class="col-xs-24 col-md-14"><table class=simulador-tarifario><thead><tr><th class="col-xs-6 col-md-6" translate=@APP-SIMULADOR-POSTOS-HORARIOS></th><th class="col-xs-6 col-md-5" translate=@APP-SIMULADOR-HORARIOS></th><th class="col-xs-4 col-md-4" translate=@APP-SIMULADOR-VALOR-TARIFA></th><th class="col-xs-4 col-md-5" translate=@APP-SIMULADOR-CONSUMO></th><th class="col-xs-4 col-md-4" translate=@APP-SIMULADOR-VALOR></th></tr></thead><tbody><tr><td class=background-success translate=@APP-SIMULADOR-FORA-DE-PONTA></td><td class=background-success>{{vm.postoHorario.horarioFora1}}</td><td>{{vm.postoHorario.valorTarifaFora}}</td><td><input type=text class=form-control ng-model=vm.kwh.fora1 ui-number-mask=1></td><td>{{vm.valor.fora1 | number: 2}}</td></tr><tr><td class=background-warning translate=@APP-SIMULADOR-INTERMEDIARIO></td><td class=background-warning>{{vm.postoHorario.horarioInter1}}</td><td>{{vm.postoHorario.valorTarifaInter}}</td><td><input type=text class=form-control ng-model=vm.kwh.inter1 ui-number-mask=1></td><td>{{vm.valor.inter1 | number: 2}}</td></tr><tr><td class=background-danger translate=@APP-SIMULADOR-PONTA></td><td class=background-danger>{{vm.postoHorario.horarioPonta}}</td><td>{{vm.postoHorario.valorTarifaPonta}}</td><td><input type=text class=form-control ng-model=vm.kwh.ponta ui-number-mask=1></td><td>{{vm.valor.ponta | number: 2}}</td></tr><tr ng-if=vm.postoHorario.horarioInter2><td class=background-warning translate=@APP-SIMULADOR-INTERMEDIARIO></td><td class=background-warning>{{vm.postoHorario.horarioInter2}}</td><td>{{vm.postoHorario.valorTarifaInter}}</td><td><input type=text class=form-control ng-model=vm.kwh.inter2 ui-number-mask=1></td><td>{{vm.valor.inter2 | number: 2}}</td></tr><tr><td class=background-success translate=@APP-SIMULADOR-FORA-DE-PONTA></td><td class=background-success>{{vm.postoHorario.horarioFora2}}</td><td>{{vm.postoHorario.valorTarifaFora}}</td><td><input type=text class=form-control ng-model=vm.kwh.fora2 ui-number-mask=1></td><td>{{vm.valor.fora2 | number: 2}}</td></tr><tr><td style="border: none"></td><td style="border: none"></td><td translate=@APP-SIMULADOR-TOTAL></td><td>{{vm.kwh.total | number: 2}}</td><td>{{vm.valor.total | number: 2}}</td></tr></tbody></table></div><div class="col-xs-24 col-md-10"><table class=simulador-tarifario><thead><tr><th class="col-xs-12 col-md-12"></th><th class="col-xs-6 col-md-6" translate=@APP-SIMULADOR-NUM-DIAS></th><th class="col-xs-6 col-md-6" translate=@APP-SIMULADOR-VALOR-REAIS></th></tr></thead><tbody><tr><td translate=@APP-SIMULADOR-DIAS-UTEIS></td><td>{{vm.dias.diasUteis}}</td><td>{{vm.valor.diasUteis | number: 2}}</t