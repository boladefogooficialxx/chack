slate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-TITLE></h2></div></div></div><div class="modal-body cpfl-style"><div class=row><div class="col-md-24 col-xs-24"><span class=col-md-24 ng-if=vm.primeiraEtapa translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-MENSAGEM-1></span> <span class=col-md-24 ng-if=vm.segundaEtapa translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-MENSAGEM-2></span> <span class=col-md-24 ng-if=vm.terceiraEtapa translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-MENSAGEM-3></span> <span class=col-md-24 ng-if=vm.quartaEtapa translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-MENSAGEM-4></span></div></div><div ng-if=!vm.primeiraEtapa><div class=row><div class="col-md-24 col-xs-24"><div class="carousel slide" data-ride=carousel><ol class=carousel-indicators-custom><li data-target=#carouselExampleIndicators ng-click=vm.continuar(1); data-slide-to=0 ng-class="{\'active\': vm.segundaEtapa}"></li><li data-target=#carouselExampleIndicators ng-click=vm.continuar(2); data-slide-to=1 ng-class="{\'active\': vm.terceiraEtapa}"></li><li data-target=#carouselExampleIndicators ng-click=vm.continuar(3); data-slide-to=2 ng-class="{\'active\': vm.quartaEtapa}"></li></ol><div class=carousel-inner><div class=carousel-item ng-class="{\'active\': vm.segundaEtapa}" ng-if=vm.segundaEtapa><img class="col-md-12 col-xs-24 d-block w-100 espacamento-img" src=assets/images/upload-selfie-img1.png> <img class="col-md-12 col-xs-24 d-block w-100 espacamento-img" src=assets/images/upload-selfie-img2.png></div><div class=carousel-item ng-class="{\'active\': vm.terceiraEtapa}" ng-if=vm.terceiraEtapa><img class="col-md-8 col-xs-24 d-block w-100 espacamento-img" src=assets/images/upload-selfie-img3.png> <img class="col-md-8 col-xs-24 d-block w-100 espacamento-img" src=assets/images/upload-selfie-img4.png> <img class="col-md-8 col-xs-24 d-block w-100 espacamento-img" src=assets/images/upload-selfie-img5.png></div><div class=carousel-item ng-class="{\'active\': vm.quartaEtapa}" ng-if=vm.quartaEtapa><img class="col-md-12 col-xs-24 col-md-push-6 d-block w-100 espacamento-img" src=assets/images/upload-selfie-img6.png></div></div></div></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-12"><button type=button class="btn btn-default btn-lg btn-block hand" data-dismiss=modal translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-BTN-CONTINUAR ng-if=vm.primeiraEtapa ng-click=vm.continuar(1);></button> <button type=button class="btn btn-default btn-lg btn-block hand" data-dismiss=modal translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-BTN-CONTINUAR ng-if=vm.segundaEtapa ng-click=vm.continuar(2);></button> <button type=button class="btn btn-default btn-lg btn-block hand" data-dismiss=modal translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-BTN-CONTINUAR ng-if=vm.terceiraEtapa ng-click=vm.continuar(3);></button> <button type=button class="btn btn-default btn-lg btn-block hand" data-dismiss=modal translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-BTN-TIRAR-FOTO ng-if="vm.quartaEtapa && !vm.enviarArquivo" ng-click=vm.continuar(4);></button> <button type=button translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-BTN-ENVIAR-FOTO ng-if="vm.quartaEtapa && vm.enviarArquivo" ngf-select=vm.enviarArquivoUpload($file) ngf-resize-if="$width > 1024 || $height > 768" ngf-resize="{width: 1024, height: 768}" class="btn btn-default btn-default btn-lg btn-block"></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button id=btnVoltar type=button class="btn btn-secondary btn-lg btn-block hand" data-dismiss=modal translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-SELFIE-BTN-CANCELAR ng-click=vm.cancelar();></button></div></div></div></div></div>');a.put("modules/common/partials/modal-envio-documentos-instrucoes.html",'<div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-TITLE></h2><span class=modal-subtitle-envio-docs-instrucoes translate={{vm.listaInformacoesInstrucoes.Nome}}></span></div></div></div><div class="modal-body cpfl-style"><div id=modalMensagem><div class=modalEnvioDocumentosInstrucoes ng-if="!vm.exibirImagemFotoPadraoCertaErrada && vm.listaInformacoesInstrucoes.Codigo != \'Selfie\'"><div class=row><div class=col-xs-24><div class=row><div ng-if=vm.temPeloMenosUmaImagem ng-class="{\'col-xs-24\': vm.temAsDuasImagens == true, \'col-xs-24 col-md-12\': vm.temSomenteUmaImagem == true}"><div class=row><p class="col-xs-24 txtBoldModalEnvioDocumentosInstrucoes">Exemplo:</p><div class=modalEnvioDocumentosDivImagens ng-class="{\'col-xs-24 col-md-12\': vm.temAsDuasImagens == true, \'col-xs-24\': vm.temSomenteUmaImagem == true}"><img ng-src={{vm.imagemCampo1}}></div><div ng-if=!vm.temSomenteUmaImagem ng-class="{\'col-xs-24 col-md-12 modalEnvioDocumentosDivImagens\': vm.temAsDuasImagens == true}"><img ng-src={{vm.imagemCampo2}}></div></div></div><div class="col-xs-24 modalEnvioDocumentosDivInstrucoesTexto" ng-class="{\'col-md-12\': vm.temSomenteUmaImagem == true}"><div id=blocoInformacoesInstrucoes><p class=txtBoldModalEnvioDocumentosInstrucoes>Por que precisamos desta foto?</p><span translate={{vm.listaInformacoesInstrucoes.Motivo}}></span><br><br><p class=txtBoldModalEnvioDocumentosInstrucoes translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-COMO-VOCE-DEVE-FAZER></p><span translate={{vm.listaInformacoesInstrucoes.ComoObter}}></span></div><div class=buttons><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.fecharModal() translate=@APP-ENVIO-DOCUMENTOS-OK-ENTENDI></button></div></div></div></div></div></div><div class=modalEnvioDocumentosInstrucoes ng-if=vm.exibirImagemFotoPadraoCertaErrada><div class=row><div class=col-xs-24><div class=row><div ng-if=vm.temPeloMenosUmaImagem class="col-xs-24 col-md-12"><div class=row><p class="col-xs-24 txtBoldModalEnvioDocumentosInstrucoes">Exemplo:</p><div class="modalEnvioDocumentosDivImagens col-xs-24"><img ng-src={{vm.imagemCampo1}}></div></div></div><div class="col-xs-24 modalEnvioDocumentosDivInstrucoesTexto" ng-class="{\'col-md-12\': vm.temSomenteUmaImagem == true}"><div id=Div1><p class=txtBoldModalEnvioDocumentosInstrucoes>Por que precisamos desta foto?</p><span translate={{vm.listaInformacoesInstrucoes.Motivo}}></span><br><br><p class=txtBoldModalEnvioDocumentosInstrucoes translate=@APP-ENVIO-DOCUMENTOS-MODAL-INSTRUCOES-COMO-VOCE-DEVE-FAZER></p><span translate={{vm.listaInformacoesInstrucoes.ComoObter}}></span></div></div></div><div class=row><div ng-if=vm.temPeloMenosUmaImagem class=col-xs-24><div class=row><div class="modalEnvioDocumentosDivImagensFotoPadrao hidden-xs hidden-sm"><div class="modalEnvioDocumentosDivImagens col-xs-24 col-md-12"><div id=iconeCerto><i class="icon-image-success fa fa-check fa-3x" aria-hidden=true></i></div><span translate={{vm.fotoPadrao.MensagemCerto}}></span> <img ng-src={{vm.fotoPadrao.ImagemCerto}}></div><div class="modalEnvioDocumentosDivImagens col-xs-24 col-md-12" ng-class="{\'modalEnvioDocumentosDivImagensFotoPadraoCaixaMedicao\' : vm.fotoPadraoCaixaMedicao == true }"><div id=iconeErrado><i class="icon-image-error fa fa-close fa-3x" aria-hidden=true></i></div><span translate={{vm.fotoPadrao.MensagemErrado}}></span><br><br ng-if=!vm.fotoPadraoCaixaMedicao><img ng-src={{vm.fotoPadrao.ImagemErrado}}></div></div><div class="col-md-24 hidden-xs hidden-sm"><span translate={{vm.fotoPadrao.TextoImagemIlustrativa}} style="font-size: 0.8em"></span><br><br></div><div class=buttons><br><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.fecharModal() translate=@APP-ENVIO-DOCUMENTOS-OK-ENTENDI></button></div></div></div></div></div></div></div></div></div></div>');a.put("modules/common/partials/modal-incluir-equipamento.html",'<div class="modal-content cpfl-style"><div class=modal-body><div id=modalMensagem><div class=row><div class=col-xs-24><alert target=modal-incluir-equipamento></alert></div></div><div class=row><div class=col-xs-24><h2 translate=@APP-MODAL-INCLUIR-EQUIPAMENTO-ADICIONAR-EQUIPAMENTO></h2></div></div><div class=row><div class="col-xs-24 col-sm-24"><div class=form-group><label for=equip translate=@APP-MODAL-INCLUIR-EQUIPAMENTO-EQUIPAMENTO class=inputs data-required=true></label><ui-select ng-model=vm.equipamento theme=selectize name=equip id=equip><ui-select-match placeholder="{{\'@APP-MODAL-INCLUIR-EQUIPAMENTO-PLACEHOLDER-EQUIPAMENTO\' | translate}}"><span ng-bind=$select.selected.Nome></span></ui-select-match><ui-select-choices repeat="equip in vm.equips | filter: $select.search"><span ng-bind=equip.Nome></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-angle-down" aria-hidden=true></i></span></div></div></div><div class=row ng-if="vm.equipamento && vm.equipamento.ExigeTipoPartida"><div class="col-xs-24 col-sm-24"><div class=form-group><label for=equip translate=@APP-MODAL-INCLUIR-EQUIPAMENTO-TIPOPARTIDA class=inputs data-required=true></label><ui-select ng-model=vm.equipamento.TipoPartida theme=selectize name=partida id=partida required><ui-select-match placeholder="{{\'@APP-MODAL-INCLUIR-EQUIPAMENTO-PLACEHOLDER-TIPOPARTIDA\' | translate}}"><span ng-bind=$select.selected.Nome></span></ui-select-match><ui-select-choices repeat="partida in vm.tiposPartida | filter: $select.search"><span ng-bind=partida.Nome></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-angle-down" aria-hidden=true></i></span></div></div></div><div class=row><div class="col-xs-24 col-sm-24"><div 