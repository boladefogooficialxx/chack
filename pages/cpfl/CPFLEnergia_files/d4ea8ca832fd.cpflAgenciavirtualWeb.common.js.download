nputs for=endereco translate=@APP-CONTINGENCIA-ENDERECO data-required=true></label><input type=text class=form-control name=nome id=endereco ng-model=vm.input.endereco readonly required cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=cidade translate=@APP-CONTINGENCIA-CIDADE data-required=true></label><input type=text class=form-control name=cidade id=cidade ng-model=vm.input.cidade readonly required cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=selectBoxServicos><div class=form-group><label class=inputs translate=@APP-CONTINGENCIA-TIPO-SOLICITACAO data-required=true></label><ui-select id=cpflSelectizeAlt ng-model=vm.input.tipoSolicitacao theme=selectize name=listaTipoSolicitacao required><ui-select-match placeholder="{{ \'@APP-CONTINGENCIA-SELECIONE-TIPO\' | translate}}"><span ng-bind=$select.selected.TipoSolicitacao></span></ui-select-match><ui-select-choices repeat="tipoSolicitacao in vm.listaTipoSolicitacao | filter: $select.search"><span ng-bind=tipoSolicitacao.TipoSolicitacao></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-search" aria-hidden=true></i></span></div></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=telefone data-required=true translate=@APP-CONTINGENCIA-TELEFONE></label><input type=tel class=form-control name=telefone id=telefone ng-model=vm.input.telefone ng-attr-ui-mask="{{vm.input.Telefone && vm.returnOnlyNumber(vm.input.telefone).length > 10 ? \'(99) 99999-999?9\' : \'(99) 9999-9999?9\'}}" ui-mask-placeholder ui-mask-placeholder-char=space ng-required=true cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=email data-required=true translate=@APP-CONTINGENCIA-EMAIL></label><input type=email class=form-control name=email id=email ng-model=vm.input.email required cpfl-highlight-input maxlength=100></div></div></div><div class=row><div class=col-xs-24><div class=form-group><label class=inputs for=observacao translate=@APP-CONTINGENCIA-OBSERVACAO-SOLICITACAO data-required=true><span translate=@APP-CONTINGENCIA-OBSERVACAO-SOLICITACAO></span></label><textarea class=form-control id=observacao ng-model=vm.input.observacao style="resize: none" rows=4 maxlength=400 ng-required=true></textarea></div></div></div><div class=buttons><div class=row><div class="col-xs-24 col-md-8 col-md-offset-16"><button id=btnEnviar type=submit ng-click=vm.registrarSolicitacao(form) class="btn btn-default btn-lg btn-block" translate=@APP-CONTINGENCIA-REGISTRAR-SOLICITACAO></button></div></div></div></form></div></div></div>');a.put("modules/common/views/contingencia-mobile.html","<style>.contingencia {\r"+"\n"+"        margin-top: 1.5em;\r"+"\n"+"    }</style><div class=contingencia><form name=contigenciaForm novalidate><div class=row><div class=col-xs-24><h2 translate=@APP-BANNER-TEXTO1></h2><span translate=@APP-BANNER-TEXTO2></span><div class=row style=margin-top:1em><div class=col-xs-24><span>CPFL Paulista - 0800 010 1010</span></div></div><div class=row style=margin-top:0.5em><div class=col-xs-24><span>CPFL Piratininga - 0800 010 2570</span></div></div><div class=row style=margin-top:0.5em><div class=col-xs-24><span>CPFL Santa Cruz - 0800 772 2196</span></div></div><div class=row style=margin-top:0.5em><div class=col-xs-24><span>RGE - 0800 970 0900</span></div></div></div></div></form></div>");a.put("modules/common/views/dicas-economia.html","<div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-DICAS-ECONOMIA-TITULO></li></ol></div></div><div class=row><div class=col-xs-24><h1 translate=@APP-FOOTER-DICAS-ECONOMIA-TITULO></h1></div></div><div class=row><div class=col-xs-24><span translate=@APP-FOOTER-DICAS-ECONOMIA-TEXTO></span></div></div>");a.put("modules/common/views/direitos-deveres.html","<style>.saiba-mais .titulo {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 18px;\r"+"\n"+"        margin-bottom: 3px;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .subtitulo {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 14px;\r"+"\n"+"        margin-bottom: 5px;\r"+"\n"+"        text-decoration: underline;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .subtitulo-verde {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"        font-size: 14px;\r"+"\n"+"        margin-bottom: 5px;\r"+"\n"+"        color: #C8D748;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .separador {\r"+"\n"+"        margin-bottom: 2em;\r"+"\n"+"        border-top: 5px solid #C8D748;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais #demonstrativo span {\r"+"\n"+"        display: inline-block;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais ul.setas {\r"+"\n"+"        list-style: none;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .setas li:before {\r"+"\n"+'        content: "» ";\r'+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas {\r"+"\n"+"        background-color: #F2F0F0;\r"+"\n"+"        text-align: center;\r"+"\n"+"        border-collapse: collapse;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas tr:nth-child(even) {\r"+"\n"+"        background-color: #F7F7F7;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .tabela-aliquotas tr, td {\r"+"\n"+"        padding: 9px;\r"+"\n"+"        border: 1px solid #FFF;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .green {\r"+"\n"+"        color: #C8D748 !important;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .saiba-mais .bold {\r"+"\n"+"        font-weight: bold;\r"+"\n"+"    }</style><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-DIREITOS-DEVERES-TITULO></li></ol></div></div><div class=row><div class=col-xs-24><h1>Direitos e Deveres</h1></div></div><div class=row><div class=col-xs-24><h4 class=titulo></h4><div class=separador></div><p>Resolução Normativa 414 / ANEEL</p><p>A Agência Nacional de Energia Elétrica (ANEEL) consolidou os direitos e deveres dos consumidores de energia elétrica na nova Resolução nº. 414/2010, de 09 de setembro de 2010, que trata das Condições Gerais de Fornecimento de Energia Elétrica.</p><p>A nova norma substitui a Resolução nº. 456/2000, bem como outros regulamentos. Organizada para servir como um guia ao consumidor, a nova norma apresenta e trata, dentre outros, aspectos relativos à classificação e à titularidade de unidades consumidoras, de prazos para ligação, das modalidades tarifárias, dos contratos, dos procedimentos para leitura e faturamento, de procedimentos irregulares e do ressarcimento por danos elétricos.</p><ul><li><a ng-click=\"$root.openExternalLink('http://www.cpfl.com.br/atendimento-a-consumidores/direitos-e-deveres/Documents/Seus_direitos_Deveres.pdf', '_blank')\" class=green><b>Seus Direitos e Deveres</b></a></li><li><a ng-click=\"$root.openExternalLink('http://www.cpfl.com.br/atendimento-a-consumidores/direitos-e-deveres/Documents/REN414-ANEEL_Nova_Compilacao_REN_416-418-419.pdf', '_blank')\" class=green><b>Resolução Nº 414 / ANEEL</b></a></li><li><a ng-click=\"$root.openExternalLink('http://www.cpflempresas.com.br/', '_blank')\" class=green><b>Portal CPFL Empresas - Orientações aos grandes clientes</b></a></li><li><a ng-click=\"$root.openExternalLink('http://www.cpfl.com.br/atendimento-a-consumidores/direitos-e-deveres/Documents/Cod_Defesa_Consumidor.pdf', '_blank')\" class=green><b>Código de Defesa do Consumidor</b></a></li></ul><p>Importante:</p><p>As publicações disponibilizadas se encontram no formato PDF.</p><p>Para que seja visualizada, é necessário que o software Acrobat Reader esteja instalado em seu equipamento.</p><p>Se você não o possui ou se deseja atualizá-lo, clique em <a ng-click=\"$root.openExternalLink('http://www.adobe.com/br/products/reader.html', '_blank')\" class=green>\"Get Acrobat Reader\"</a>.</p></div></div>");a.put("modules/common/views/error.html",'<div class="error-page-route container"><cabecalho-pagina titulo-cabecalho=@APP-COMMON-BREADCRUMB-ERROR sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-ERROR></cabecalho-pagina><div class=row><div class=col-xs-24><p><span translate=@APP-COMMON-ERROR-DEP-LOAD-DESCRIPTION-1></span></p><p><span translate=@APP-COMMON-ERROR-DEP-LOAD-DESCRIPTION-2></span></p><p><span translate=@APP-COMMON-ERROR-DEP-LOAD-DESCRIPTION-3></span></p></div></div><div class=row><div class="col-xs-24 col-md-16"><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=errorCtrl.loadAllDependencies() translate=@APP-COMMON-ERROR-DEP-LOAD-BTN-RELOAD-APP></button></div></div></div></div>');a.put("modules/common/views/faq-tire-suas-duvidas-sobre-geracao-distribuida.html",'<div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-FOOTER-MICRO-MINI-GERACAO-TITULO></li></ol></div></div><div class=row><div class=col-xs-24><h1>Micro e Minigeração</h1></div></div><div class=row><div class=col-xs-24><p>Para entender sobre as principais dúvidas referentes ao tema Geração Distribuída, <a target=_blank ng-href=https://www.cpfl.com.br/atendimento-a-consumidores/SiteAssets/servicos-online/agencia/CentralAjuda/faq-geracao-distribuida-CPFL.pdf>clique aqui </a>e conheça o nosso FAQ.</p></div></div><script>window.location.replace("https://www.cpfl.com.br/atendimento-a-consumidores/SiteAssets/servicos-online/agencia/CentralAjuda/faq-geracao-distribuida-CPFL.pdf");</script>');a.put("modules/common/views/home.html",'<div class="row alert-home"><div class=col-xs-24><alert></alert></div></div><div ng-if="!vm.hasAccessToken && !vm.hasRefreshToken && vm.clientId != vm.clientIdsConstants.agenciaVirtualCpflCredenciados"><div class=row><div class=col-xs-24><div id=Div1><div class=row><div class=col-xs-24><div class=selectBox><div class=form-group><label class=inputs></label><ui-select ng-model=vm.servicos.selected theme=selectize name=selectBuscaServicos><ui-select-match placeholder="{{ \'@APP-PAINEL-INICIAL-GOSTARIA-DE\' | translate}}"><span ng-bind=$select.selected.value.palavrasBusca></span></ui-select-match><ui-select-choices repeat="servico in vm.servicos | filter: $select.search | orderBy:\'nomeServico\' track by $index"><a ng-click=vm.redirectServico(servico) class=hand><div ng-bind=servico.nomeServico></div><div style=display:none ng-bind=servico.palavrasBusca></div></a></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-search" aria-hidden=true></i></span></div></div></div></div></div></div></div><div class=row><div class=col-xs-24><div class=row><div class=col-xs-12><section class="visible-md visible-lg"><grid-cards-row cards=vm.OqueEuPreciso header-title="{{\'@APP-COMMON-O-QUE-EU-PRECISO\'}}"></grid-cards-row></section></div><div class=col-xs-10><section class="visible-md visible-lg"><servicos-em-destaque-row cards=vm.servicosEmDestaque header-title="{{\'@APP-COMMON-TITLE-SERVICOS-EM-DESTAQUE\'}}"></servicos-em-destaque-row></section></div><div class=row><div class="visible-xs visible-sm hidden-md hidden-lg" ng-if="vm.clientId != \'agencia-virtual-cpfl-terminal\'"><grid-cards-row cards=vm.OqueEuPreciso header-title="{{\'@APP-COMMON-O-QUE-EU-PRECISO\'}}"></grid-cards-row></div></div><div class=row><div class="visible-xs visible-sm hidden-md hidden-lg" ng-if="vm.clientId != \'agencia-virtual-cpfl-terminal\'"><servicos-em-destaque cards=vm.servicosEmDestaque header-title="{{\'@APP-COMMON-TITLE-SERVICOS-EM-DESTAQUE\'}}"></servicos-em-destaque></div></div><div class="visible-xs visible-sm hidden-md hidden-lg" ng-if="vm.clientId == \'agencia-virtual-cpfl-terminal\'"><grid-cards cards=vm.servicosEmDestaque header-title="{{\'@APP-COMMON-TITLE-SERVICOS-EM-DESTAQUE\'}}"></grid-cards></div></div></div></div><div class="visible-xs visible-sm hidden-md hidden-lg"><div class=row><div class=col-xs-24><div class=panel-mais-servicos><div class=panel-group><div class="panel panel-default"><div class=panel-heading data-toggle=collapse data-target=#maisServicos ng-init="vm.accordion_1 = true" ng-click="vm.accordion_1 = !vm.accordion_1;" data-parent=#accordion><h4 class=panel-title><span>Mais serviços</span> <i id=iconeMaisServicos class="iconeMaisServicos pull-right fa" ng-class="{\'fa-plus\': vm.accordion_1, \'fa-minus\': !vm.accordion_1}"></i></h4></div><div id=maisServicos class="panel-collapse collapse"><div class="panel-body panel-body-np"><table ng-table=vm.tableMaisServicos class=table><tbody><tr ng-repeat="servico in $data track by $index" class=panel-mais-servicos-servico><td><div class=row><div class=col-xs-24><span class=descricaoServicos ng-bind=servico.nomeServico></span> <button type=button class="btn btn-default btn-secondary btn-sm pull-right" ng-click=vm.redirectServico(servico)><span translate=@APP-COMMON-BTN-ACESSAR></span></button></div></div></td></tr></tbody></table></div></div></div></div></div></div></div></div><div class="hidden-xs hidden-sm visible-md visible-lg"><div class=row><div class=col-xs-24><div class=panel-mais-servicos><div class=panel-group><div class="panel panel-default"><div class=panel-heading data-toggle=collapse data-target=#demaisServicos ng-init="vm.accordion_1 = true" ng-click="vm.accordion_1 = !vm.accordion_1;" data-parent=#accordion><h1 class=panel-title><span class=span-vertical>Mais serviços</span> <i id=iconeMaisServicos class="iconeMaisServicos pull-right fa" ng-class="{\'fa-plus\': vm.accordion_1, \'fa-minus\': !vm.accordion_1}"></i></h1></div><div id=demaisServicos class="demais-servicos-area panel-collapse collapse"><div class=row><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == false"><h2 class=demais-sevicos-area-titulo translate="{{\'@APP-COMMON-MENU-MINHA-FATURA\' + vm.sufixoLabelMenu}}"></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuMinhaFatura suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == false"><h2 class=demais-sevicos-area-titulo translate=@APP-COMMON-MENU-MINHA-INSTALACAO></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuMinhaEnergia suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == false"><h2 class=demais-sevicos-area-titulo translate=@APP-COMMON-MENU-MEU-CADASTRO></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuMeuCadastro suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == false"><h2 class=demais-sevicos-area-titulo translate=@APP-COMMON-MENU-OUTROS-SERVICOS></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuOutrosServicos suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == false"><h2 class=demais-sevicos-area-titulo translate=@APP-COMMON-MENU-AJUDA-ONLINE></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuAjudaOnline suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == true"><h2 class="demais-sevicos-area-titulo ng-scope" translate=@APP-COMMON-MENU-CREDENCIADOS-FATURA></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuFaturaCredenciados suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == true"><h2 class="demais-sevicos-area-titulo ng-scope" translate=@APP-COMMON-MENU-CREDENCIADOS-CADASTRO></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuCadastroCredenciados suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == true"><h2 class="demais-sevicos-area-titulo ng-scope" translate=@APP-COMMON-MENU-CREDENCIADOS-SERVICOS-TECNICOS></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuServicosTecnicosCredenciados suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == true"><h2 class=demais-sevicos-area-titulo translate=@APP-COMMON-MENU-OUTROS-SERVICOS></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuOutrosServicosCredenciados suffix={{vm.sufixoLabelMenu}}></acn-menu></div><div class="col-xs-24 col-md-6" ng-if="vm.isCredenciado == true"><h2 class=demais-sevicos-area-titulo translate=@APP-CREDENCIADOS-MENU-PERFIL-CLIENTE></h2><acn-menu class=demais-servicos-area-lista-servicos name=menuPerfilClienteCredenciados suffix={{vm.sufixoLabelMenu}}></acn-menu></div></div></div></div></div></div></div></div></div><div class=row><div class=col-xs-24><a class=hand ng-click="$root.openExternalLink(\'https://www.cpfl.com.br/pix\', \'_blank\')"><div class=banners-cpfl-solucoes></div></a></div></div><section class="informacoesInstitucionais visible-md visible-lg"><div class=row><div class=col-sm-24><div class=row><div class=col-sm-5><div class="panel panel-default"><h3>Micro e Minigeração</h3><p>Esclarecimentos sobre o faturamento - Micro e Minigeração</p><a ui-sref=app.informacoes-micro-mini-geracao class="link-default hand" title="Saiba Mais">Saiba Mais</a></div></div><div class=col-sm-5><div class="panel panel-default"><h3>Tarifa Social</h3><p>Veja como aderir a este programa.</p><a ui-sref=app.tarifa-social class="link-default hand" title="Saiba Mais">Saiba Mais</a></div></div><div class=col-sm-5><div class="panel panel-default"><h3>Tributos</h3><p>Conheça os tributos que fazem parte da conta de energia.</p><a ui-sref=app.tributos class="link-default hand" title="Saiba Mais">Saiba Mais</a></div></div><div class=col-sm-5><div class="panel panel-default"><h3>Direitos e Deveres</h3><p>Conheça os direitos e deveres do consumidor.</p><a ui-sref=app.direitos-deveres class="link-default hand" title="Saiba Mais">Saiba Mais</a></div></div><div class="col-sm-4 np"><div class="panel panel-default"><h3>Dicas de Economia</h3><p>Descubra como economizar de maneira consciente.</p><a ng-click="$root.openExternalLink(\'https://www.cpfl.com.br/energias-sustentaveis/eficiencia-energetica/uso-consciente/dicas-de-consumo/paginas/default.aspx\', \'_blank\')" title="Saiba Mais" class="link-default hand">Saiba Mais</a></div></div></div></div></div></section></div><div ng-if="vm.hasAccessToken && vm.hasRefreshToken && vm.clientId != vm.clientIdsConstants.agenciaVirtualCpflCredenciados"><div><form name=formProtocoloAtendimentoAutenticado novalidate><div><div class=row ng-if="vm.cpfCnpjExibir == \'CNPJ\'  && vm.clientId != \'agencia-virtual-cpfl-app\'"><div class=col-xs-18 ng-if=vm.showpesquisa><h2 translate=@APP-CREDENCIADOS-TITLE-PESQUISA></h2><p translate=@APP-CREDENCIADOS-SUBTITLE-PESQUISA></p></div><div class=col-xs-6 ng-if="vm.acessoAdmimCnpj == \'Y\' && vm.cpfCnpjExibir == \'CNPJ\'"><div class=buttons><button class="btn btn-default btn-lg btn-block" ng-click=vm.permissoesAcesso() translate=@APP-COMMON-MENU-PERMISSOES-ACESSO></button></div></div></div></div><div ng-if="vm.cpfCnpjExibir == \'CPF\' && vm.exibirBotaoInstalacoes"><div class=row><div class="col-xs-24 col-md-6 col-md-push-18"><div class=buttons><button class="btn btn-default btn-lg btn-block" ng-click=vm.minhasInstalacoes() translate=@APP-COMMON-MENU-MINHAS-INSTALACOES></button></div></div></div></div><div class=row ng-if="(vm.cpfCnpjExibir == \'CNPJ\') && vm.showpesquisa && vm.clientId != \'agencia-virtual-cpfl-app\'"><div class=col-xs-24><ul class="nav nav-pills nav-justified" ng-init="vm.isInstalacao = true; vm.isDocumento = false; vm.isEndereco = false; vm.isMedidor = false; vm.isNome = false;"><li ng-class="{active: vm.isInstalacao}"><a ng-click="vm.isInstalacao = true; vm.isDocumento = false; vm.isEndereco = false; vm.isMedidor = false;\r'+"\n"+"                            vm.isNome = false; vm.form.instalacao = ''; vm.form.estado = undefined; vm.form.municipio = undefined;\r"+"\n"+'                            vm.alteraStatusForm(formProtocoloAtendimentoAutenticado, \'Unsubmitted\')" data-toggle=tab translate=@APP-COMMON-INSTALACAO></a></li><li ng-class="{active: vm.isDocumento}"><a ng-click="vm.isInstalacao = false; vm.isDocumento = true; vm.isEndereco = false; vm.isMedidor = false;\r'+"\n"+"                            vm.isNome = false; vm.form.documento = ''; vm.form.estado = undefined; vm.form.municipio = undefined; vm.alteraStatusForm(formProtocoloAtendimentoAutenticado, 'Unsubmitted')\" data-toggle=tab translate=@APP-CREDENCIADOS-TAB-DOCUMENTO></a></li><li ng-class=\"{active: vm.isEndereco}\"><a ng-click=\"vm.isInstalacao = false; vm.isDocumento = false; vm.isEndereco = true; vm.isMedidor = false;\r"+"\n"+"                            vm.isNome = false; vm.form.endereco = ''; vm.form.estado = undefined; vm.form.municipio = undefined;vm.alteraStatusForm(formProtocoloAtendimentoAutenticado, 'Unsubmitted')\" data-toggle=tab translate=@APP-CREDENCIADOS-TAB-ENDERECO></a></li><li ng-class=\"{active: vm.isMedidor}\"><a ng-click=\"vm.isInstalacao = false; vm.isDocumento = false; vm.isEndereco = false; vm.isMedidor = true;\r"+"\n"+'                            vm.isNome = false; vm.form.medidor = \'\'; vm.form.estado = undefined; vm.form.municipio = undefined;vm.alteraStatusForm(formProtocoloAtendimentoAutenticado, \'Unsubmitted\')" data-toggle=tab translate=@APP-CREDENCIADOS-TAB-MEDIDOR></a></li><li></li></ul></div></div><div class="tab-content clearfix"><div ng-if="vm.isInstalacao && vm.showpesquisa"><div><div class=row><div class=col-xs-12><div class=form-group><label for=instalacao class=inputs translate=@APP-COMMON-INSTALACAO data-required=true></label><input type=text class=form-control id=instalacao ng-model=vm.form.instalacao cpfl-highlight-input required autocomplete=off></div></div><div class=col-xs-12><button type=submit ng-click="vm.iniciarAutoAtendimento(vm.form.instalacao, formProtocoloAtendimentoAutenticado)" class="btn btn-default btn-lg btn-block btn-iniciar-atendimento ng-scope" translate=@APP-CREDENCIADOS-INICIAR-ATENDIMENTO></button></div></div></div></div><div ng-if="vm.isDocumento && vm.showpesquisa"><div class=row><div class=col-xs-12><div class=form-group><label class=inputs translate=@APP-COMMON-CNPJ data-required=true></label><input type=tel class=form-control id=cnpj placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=vm.form.documento ng-cnpj autocomplete=off cpfl-highlight-input custom-cnpj-mask required></div></div><div class=col-xs-12><button type=submit ng-click=vm.pesquisarAutoDocumento(formProtocoloAtendimentoAutenticado); class="btn btn-default btn-lg btn-block btn-iniciar-atendimento ng-scope" translate=@APP-CREDENCIADOS-PESQUISAR-INSTALACAO></button></div></div></div><div ng-if="vm.isEndereco && vm.showpesquisa"><busca-endereco source=vm selected-callback=vm.enderecoAutoDiretivaHome buscar-endereco-exato=true apenas-concessao=true auto-leitura=true auto-agrupamento=true></busca-endereco></div><div ng-if="vm.isMedidor && vm.showpesquisa"><div><div class=row><div class=col-xs-12><div class=form-group><label for=medidor class=inputs translate=@APP-CREDENCIADOS-TAB-MEDIDOR data-required=true></label><input type=text class=form-control id=medidor ng-model=vm.form.medidor cpfl-highlight-input required></div></div><div class=col-xs-12><button type=submit ng-click=vm.pesquisarAutoMedidor(formProtocoloAtendimentoAutenticado) class="btn btn-default btn-lg btn-block btn-iniciar-atendimento ng-scope" translate=@APP-CREDENCIADOS-PESQUISAR-INSTALACAO></button></div></div></div></div></div></form></div><div class=row><div class=col-xs-24><h2 ng-if="vm.cpfCnpjExibir == \'CNPJ\' && vm.showpesquisa && vm.clientId != \'agencia-virtual-cpfl-app\'" translate=@APP-CREDENCIADOS-TITLE-OUTRAS-OPCOES-PESQUISA></h2><p ng-if="vm.cpfCnpjExibir == \'CNPJ\' && vm.showpesquisa && vm.clientId != \'agencia-virtual-cpfl-app\'" translate=@APP-CREDENCIADOS-SUBTITLE-OUTRAS-OPCOES-PESQUISA></p><div id=pesquisaServicosLogado><div class=row><div class=col-xs-24><div class=selectBox><div class=form-group><label class=inputs></label><ui-select ng-model=vm.servicos.selected theme=selectize name=selectBuscaServicos><ui-select-match placeholder="{{ \'@APP-PAINEL-INICIAL-GOSTARIA-DE\' | translate}}"><span ng-bind=$select.selected.value.palavrasBusca></span></ui-select-match><ui-select-choices repeat="servico in vm.servicos | filter: $select.search | orderBy:\'nomeServico\' track by $index"><a ng-click=vm.redirectServico(servico) class=hand><div ng-bind=servico.nomeServico></div><div style=display:none ng-bind=servico.palavrasBusca></div></a></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-search" aria-hidden=true></i></span></div></div></div></div></div></div></div><div class="row visible-xs visible-sm hidden-md hidden-lg"><div class=col-xs-24><div class=row><div class=row><div class="visible-xs visible-sm hidden-md hidden-lg" ng-if="vm.clientId != \'agencia-virtual-cpfl-terminal\'"><grid-cards-row cards=vm.OqueEuPreciso header-title="{{\'@APP-COMMON-O-QUE-EU-PRECISO\'}}"></grid-cards-row></div></div><div class=row><div class="visible-xs visible-sm hidden-md hidden-lg" ng-if="vm.clientId != \'agencia-virtual-cpfl-terminal\'"><servicos-em-destaque cards=vm.servicosEmDestaque header-title="{{\'@APP-COMMON-TITLE-SERVICOS-EM-DESTAQUE\'}}"></servicos-em-destaque></div></div><div class="visible-xs visible-sm hidden-md hidden-lg" ng-if="vm.clientId == \'agencia-virtual-cpfl-terminal\'"><grid-cards cards=vm.servicosEmDestaque header-title="{{\'@APP-COMMON-TITLE-SERVICOS-EM-DESTAQUE\'}}"></grid-cards></div></div></div></div><div class="visible-xs visible-sm hidden-md hidden-lg"><div class=row><div class=col-xs-24><div class=panel-mais-servicos><div class=panel-group><div class="panel panel-default"><div class=panel-heading data-toggle=collapse data-target=#maisServicos ng-init="vm.accordion_1 = true" ng-click="vm.accordion_1 = !vm.accordion_1;" data-parent=#accordion><h4 class=panel-title><span>Mais serviços</span> <i id=iconeMaisServicos class="iconeMaisServicos pull-right fa" ng-class="{\'fa-plus\': vm.accordion_1, \'fa-minus\': !vm.accordion_1}"></i></h4></div><div id=maisServicos class="panel-collapse collapse"><div class="panel-body panel-body-np"><table ng-table=vm.tableMaisServicos class=table><tbody><tr ng-repeat="servico in $data track by $index" class=panel-mais-servicos-servico><td><div class=row><div class=col-xs-24><span class=descricaoServicos ng-bind=servico.nomeServico></span> <button type=button class="btn btn-default btn-secondary btn-sm pull-right" ng-click=vm.redirectServico(servico)><span translate=@APP-COMMON-BTN-ACESSAR></span></button></div></div></td></tr></tbody></table></div></div></div></div></div></div></div></div><div class="row debitos-aberto-div" ng-if="vm.isAuthenticated && vm.debitosAbertos"><div class=loader ng-hide=!vm.loaderHistoricoContas></div><div class=col-xs-24><div class=row ng-if=vm.parcelamentoEmProcessamento><div class=col-xs-24><div class="alert alert-warning" role=alert><div class="alert-icon warning-icon"></div><span class=alert-message translate=@APP-COMMON-MENSAGEM-PARCELAMENTO-EM-PROCESSAMENTO></span></div></div></div><div ng-if="(vm.historicoContas && !vm.historicoContas.PossuiDebitos) || (vm.historicoContas && vm.historicoContas.PossuiDebitos)"><div class=debitosEmAberto><div class=row><div class=col-xs-24 style="margin-bottom: -27px !important; margin-top: -30px !important"><h1 class=home-titulo-secao translate=@APP-PAINEL-INICIAL-MINHA-CONTA-ATUAL></h1></div></div><div class=row><div class=col-xs-24><div class=resultadoDebitos ng-if=vm.historicoContas style="margin-bottom: -5px !important"><div class=row style="margin-bottom: -5px !important; margin-top: -5px !important"><div class=col-xs-24><form class=form-horizontal><div class=row><div class="col-xs-24 col-md-13"><div class="row hidden-xs hidden-sm"><div class=col-md-10><span class=totalDebitos style="text-align:left !important" translate=@APP-PAINEL-INICIAL-VENCIMENTO></span></div><div class=col-md-6><span>&nbsp;</span></div><div class=col-md-5 ng-if="(vm.historicoContas && ((vm.historicoContas.PossuiDebitos && vm.historicoContas.DebitoAutomatico) || (!vm.historicoContas.PossuiDebitos)))"><span class=totalDebitos style="text-align:left !important" translate=@APP-PAINEL-INICIAL-STATUS-FATURA></span></div></div><div class="row hidden-md hidden-lg" ng-if=!vm.historicoContas.PossuiDebitos><div class=col-xs-8><span class=totalDebitos style="text-align:left !important" translate=@APP-PAINEL-INICIAL-VENCIMENTO></span></div><div class=col-xs-8><span>&nbsp;</span></div><div class=col-xs-8 ng-if="(vm.historicoContas && ((vm.historicoContas.PossuiDebitos && vm.historicoContas.DebitoAutomatico) || (!vm.historicoContas.PossuiDebitos)))"><span class=totalDebitos style="text-align:left !important" translate=@APP-PAINEL-INICIAL-STATUS-FATURA></span></div></div><div class="row hidden-md hidden-lg" ng-if=vm.historicoContas.PossuiDebitos><div class=col-xs-14><span class=totalDebitos style="text-align:left !important" translate=@APP-PAINEL-INICIAL-VENCIMENTO></span></div><div class=col-xs-14><span>&nbsp;</span></div></div><div class="row hidden-xs hidden-sm" ng-if=vm.historicoContas.PossuiDebitos><div class=col-md-8><span class=totalDebitosAberto style="font-size: 1.5em !important" ng-bind=vm.historicoContas.DtVencimentoUltDebPendente></span></div><div class=col-md-8><span class=totalDebitosAberto style="font-size: 1.5em !important; font-weight: bolder" ng-bind="vm.historicoContas.ValorUltDebPendente | currency"></span></div><div class=col-md-7 ng-if="(vm.historicoContas && vm.historicoContas.PossuiDebitos && vm.historicoContas.DebitoAutomatico)"><span class=totalDebitosAberto style="font-size: 1.5em !important">Em aberto</span></div></div><div class="row hidden-md hidden-lg" ng-if=vm.historicoContas.PossuiDebitos><div class=col-xs-10><span class=totalDebitosAberto style="font-size: 1.2em !important; font-weight: bold" ng-bind=vm.historicoContas.DtVencimentoUltDebPendente></span></div><div class=col-xs-14><span class=totalDebitosAberto style="font-size: 1.2em !important; font-weight: bolder" ng-bind="vm.historicoContas.ValorUltDebPendente | currency"></span></div></div><div class="row hidden-xs hidden-sm" ng-if=!vm.historicoContas.PossuiDebitos><div class=col-md-8><span class=totalDebitosAberto style="font-size: 1.5em !important" ng-bind="vm.tableDebitosPagos.Vencimento | date:\'dd/MM/yyyy\'"></span></div><div class=col-md-8><span class=totalDebitosAberto style="font-size: 1.5em !important; font-weight: bolder" ng-bind="vm.tableDebitosPagos.Valor | currency"></span></div><div class=col-md-8 ng-if=!vm.historicoContas.PossuiDebitos><span class=totalDebitosAberto style="font-size: 1.5em !important">Pago</span></div></div><div class="row hidden-md hidden-lg" ng-if=!vm.historicoContas.PossuiDebitos><div class=col-xs-8><span class=totalDebitosAberto style="font-size: 0.8em !important; text-align:left !important" ng-bind="vm.tableDebitosPagos.Vencimento | date:\'dd/MM/yyyy\'"></span></div><div class=col-xs-8><span class=totalDebitosAberto style="font-size: 0.8em !important; font-weight: bolder !important; text-align:center !important" ng-bind="vm.tableDebitosPagos.Valor | currency"></span></div><div class=col-xs-8><span class=totalDebitosAberto style="font-size: 0.8em !important; text-align:left !important" ng-bind=vm.pago></span></div></div></div><div class="col-md-10 hidden-xs hidden-sm"><div class=buttons><div class=row style="margin-left: -36px !important; margin-right: -90px !important; margin-top: 7px !important"><div class=col-md-11><button ng-if="vm.historicoContas && vm.historicoContas.QuantidadeDebitos > 0 && !vm.historicoContas.DebitoAutomatico &&\r'+"\n"+"                                                                               !vm.historicoContas.ContasAberto[0].NaoExibirBotaoCartaoCredito && !vm.historicoContas.ContasAberto[0].FaturaVencidaParcelamento &&\r"+"\n"+"                                                                               vm.historicoContas.ContasAberto[0].TipoFatura != 'MK' && vm.historicoContas.ContasAberto[0].TipoFatura != 'MQ' &&\r"+"\n"+"                                                                               vm.historicoContas.ContasAberto[0].TipoFatura != 'MF' && vm.historicoContas.ContasAberto[0].TipoFatura != 'MI' &&\r"+"\n"+'                                                                               vm.historicoContas.ContasAberto[0].ContaMinima != \'CMA\' && vm.historicoContas.ContasAberto[0].ContaMinima != \'CM\'" ng-click=vm.pagarFaturaCartaoCreditoHome(vm.historicoContas.ContasAberto[0]) type=submit class="btn btn-primary-blue btn-lg btn-block" id=btnPagar translate=@APP-PAINEL-INICIAL-PAGAR></button></div><div class=col-md-11><button ng-if=!vm.historicoContas.PossuiDebitos ng-click=vm.selecionarContaQuitada(vm.tableDebitosPagos) type=submit class="btn btn-link btn-lg btn-block" id=btnSegundaVia translate=@APP-PAINEL-INICIAL-2-VIA-DE-CONTA></button> <button ng-if=vm.historicoContas.PossuiDebitos ng-click="vm.selecionarContaAberta(vm.historicoContas.ContasAberto[0], vm.historicoContas.instalacao._nrInst, vm.historicoContas.DebitoAutomatico)" type=submit class="btn btn-link btn-lg btn-block" id=btnSegundaVia translate=@APP-PAINEL-INICIAL-2-VIA-DE-CONTA><