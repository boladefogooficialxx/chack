odelCheckboxCadastro><label for=checkBoxCadastro translate=@APP-COMMON-MENSAGEM-IMPORTANTE-OPCAO></label></div></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class=col-xs-24><button id=btnFechar ng-click=vm.fechar() class="btn btn-default btn-lg btn-block" translate=@APP-COMMON-BTN-FECHAR></button></div></div></div></div></div></div>');a.put("modules/common/partials/modal-regulamento-promocao.html",'<div class="modal-content cpfl-style"><div class=modal-header></div><div class=modal-body id=modalTermo><div class=row><div class=col-xs-24><object id=iFrameRegulamentoPdf data={{vm.regulamento}} type=application/pdf style="width:100%; height:500px">Parece que o seu navegador não consegue visualizar o regulamento, para visualizá-lo precisará efetuar o download.</object></div></div></div><div class=modal-footer style="padding-top: 0"><div class=row><div class="col-xs-24 col-md-6"><button class="btn btn-default btn-lg btn-block" ng-click=vm.closeModal(true) translate=@APP-MODAL-REGULAMENTO-ACEITO></button></div><div class="col-xs-24 col-md-6"><button class="btn btn-default btn-lg btn-block" ng-click=vm.closeModal(false) translate=@APP-MODAL-REGULAMENTO-NAO-ACEITO></button></div><div class="col-xs-24 col-md-10"><button class="btn btn-default btn-lg btn-block" ng-click=vm.baixarRegulamento() translate=@APP-MODAL-BAIXAR-REGULAMENTO></button></div></div></div></div>');a.put("modules/common/partials/modal-revisao-cadastral.html",'<div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-COMMON-MODAL-ATUALIZACAO-CADASTRAL-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><div class=cpfl-style><span translate=@APP-COMMON-MODAL-ATUALIZACAO-CADASTRAL-TEXTO></span></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-12"><button id=btnEnviar type=button clas