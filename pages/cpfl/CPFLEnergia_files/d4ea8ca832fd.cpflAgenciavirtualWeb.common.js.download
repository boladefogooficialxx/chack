ura suffix={{menuCtrl.sufixoLabelMenu}}></acn-menu></div></div></section><section class="menu-section panel" ng-if="menuCtrl.getClientId() != \'agencia-virtual-cpfl-credenciados\'"><a data-toggle=collapse data-parent=#boxMenusMobiles data-target=#menuMinhaEnergia aria-expanded=false translate="{{\'@APP-COMMON-MENU-MINHA-INSTALACAO\' + menuCtrl.sufixoLabelMenu}}"></a><div class=collapse id=menuMinhaEnergia><div ng-if=menuCtrl.itemsMenuLoaded><acn-menu class="site-menu menu-section-list list-menu-sub" name=menuMinhaEnergia suffix={{menuCtrl.sufixoLabelMenu}}></acn-menu></div></div></section><section class="menu-section panel" ng-if="menuCtrl.getClientId() != \'agencia-virtual-cpfl-credenciados\'"><a data-toggle=collapse data-parent=#boxMenusMobiles data-target=#menuMeuCadastro aria-expanded=false translate="{{\'@APP-COMMON-MENU-MEU-CADASTRO\' + menuCtrl.sufixoLabelMenu}}"></a><div class=collapse id=menuMeuCadastro><div ng-if=menuCtrl.itemsMenuLoaded><acn-menu class="site-menu menu-section-list list-menu-sub" name=menuMeuCadastro suffix={{menuCtrl.sufixoLabelMenu}}></acn-menu></div></div></section><section class="menu-section panel" ng-if="menuCtrl.getClientId() != \'agencia-virtual-cpfl-credenciados\'"><a data-toggle=collapse data-parent=#boxMenusMobiles data-target=#menuOutrosServicos aria-expanded=false translate="{{\'@APP-COMMON-MENU-OUTROS-SERVICOS\' + menuCtrl.sufixoLabelMenu}}"></a><div class=collapse id=menuOutrosServicos><div ng-if=menuCtrl.itemsMenuLoaded><acn-menu class="site-menu menu-section-list list-menu-sub" name=menuOutrosServicos suffix={{menuCtrl.sufixoLabelMenu}}></acn-menu></div></div></section><section class="menu-section panel" ng-if="menuCtrl.getClientId() != \'agencia-virtual-cpfl-credenciados\'"><a data-toggle=collapse data-parent=#boxMenusMobiles data-target=#menuAjudaOnline aria-expanded=false translate="{{\'@APP-COMMON-MENU-AJUDA-ONLINE\' + menuCtrl.sufixoLabelMenu}}"></a><div class=collapse id=menuAjudaOnline><div ng-if=menuCtrl.itemsMenuL