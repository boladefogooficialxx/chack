\'@APP-COMMON-PLACEHOLDER-SOLICITACAO-OBSERVACAO\' | translate}}" ng-model=vm.observacao cpfl-highlight-input></textarea></div></div></div><div id=dadosContato><div class=row><div class=col-xs-24><h2 translate=@APP-RELIGACAO-ENERGIA-SOLICITANTE></h2></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label for=nomeCompleto translate=@APP-RELIGACAO-ENERGIA-NOME-COMPLETO class=inputs data-required=true></label><input type=text class=form-control name=nomeCompleto id=nomeCompleto placeholder="{{\'@APP-COMMON-PLACEHOLDER-NOME\' | translate}}" ng-model=vm.nomeContato ng-class="{invalid: form.nomeCompleto.$invalid && form.nomeCompleto.$dirty}" required cpfl-highlight-input only-letters></div></div></div><div class=row><div ng-if=vm.possuiSmsCadastrado><div class=col-xs-24><div uib-alert class="alert alert-info" id=alertaSuperiorAnaliseTecnica><div class="alert-icon info-icon"></div><span translate=@APP-COMMON-DIRECTIVE-CADASTRO-SMS-POSSUI-TELEFONE-CADASTRADO class=alert-message></span></div></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=celular class=inputs translate=@APP-COMMON-DIRECTIVE-CADASTRO-SMS-CELULAR data-required=true></label><input type=tel class=form-control id=celular placeholder="{{\'@APP-COMMON-PLACEHOLDER-TELEFONE\' | translate}}" ng-model=vm.cadastroSmsCelular ng-required=vm.cadastroSmsCheckboxDesejoCadastrar ng-attr-ui-mask="{{vm.cadastroSmsCelular && vm.returnOnlyNumber(vm.cadastroSmsCelular).length > 10 ? \'(99) 99999-999?9\' : \'(99) 9999-9999?9\'}}" ui-mask-placeholder ui-mask-placeholder-char=space cpfl-highlight-input></div></div><div ng-if=!vm.possuiSmsCadastrado><div class=col-xs-24><div class=form-group><div class=checkbox><input type=checkbox id=checkboxCadastroSms value=true ng-model=vm.cadastroSmsCheckboxDesejoCadastrar ng-click=vm.limparCamposCelular()><label for=checkboxCadastroSms translate=@APP-COMMON-DIRECTIVE-CADASTRO-SMS-CHECKBOX-NAO-INFORMAR></label></div></div></div></div>