></span></td><td><span translate=@APP-RELIGACAO-ENERGIA-TABLE-VENC></span></td><td><span translate=@APP-RELIGACAO-ENERGIA-TABLE-VALOR></span></td><td ng-show="vm.dadosValidacao.ExisteBlackList == \'N\' && !vm.perfilRedeFacil && vm.clientId != \'agencia-virtual-cpfl-terminal\'"><span translate=@APP-RELIGACAO-ENERGIA-TABLE-COMPROVANTE></span><br><button class="btn btn-instruction" style=margin-top:0;margin-bottom:0;padding-left:35px ng-click=vm.abrirmodalInstrucoesDocumentos() type=button><i class="fa fa-info-circle fa-1x" aria-hidden=true type=button></i></button></td></tr></thead><tbody><tr ng-repeat="conta in $data"><td ng-bind=conta.MesReferencia></td><td ng-bind="conta.Vencimento | date:\'dd/MM/yy\'"></td><td ng-bind="conta.Valor | currency"></td><td ng-show="vm.dadosValidacao.ExisteBlackList == \'N\' && !vm.perfilRedeFacil && vm.clientId != \'agencia-virtual-cpfl-terminal\'"><div class=upload-box style="max-width: 100px!important;min-height: 1px;padding: 1px;margin-top: 1px;margin-bottom: 1px" ng-class="{\'upload-box-success\': conta.ArquivoCarregado && conta.ArquivoCarregado.ValidarIA && !conta.isUploading, \'upload-box-error\': conta.ArquivoCarregado && !conta.ArquivoCarregado.ValidarIA && !conta.isUploading}"><div class=upload-box-error ng-if="conta.ArquivoCarregado && !conta.ArquivoCarregado.ValidarIA && !conta.isUploading && conta.ArquivoCarregado.ErrorMessage"><i class="upload-box-image-error fa fa-danger fa-3x" aria-hidden=true uib-tooltip={{conta.ArquivoCarregado.ErrorMessage}}></i></div><div class=upload-box-button ng-if=!conta.ArquivoCarregado ng-hide=conta.isUploading><div class=buttons ng-show=!conta.captureImage><div class="visible-md visible-lg"><button type=button uib-tooltip="{{\'@APP-COMMON-ENVIO-DOCUMENTOS-ENVIAR-ARQUIVO\' | translate}}" ngf-select="vm.upload($file, conta)" class="btn btn-default btn-secondary upload-box-file-uploaded-button"><img width=15 height=20 ng-src={{vm.uploadIcone}}></button> <button type=button uib-tooltip="{{\'@APP-COMMON-ENVIO-DOCUMENTOS-CAPTURAR-IMAGEM\' | translate}}" ng-click=vm.abrimodalWebcam(conta) class="btn btn-default btn-secondary upload-box-file-uploaded-button"><span class="glyphicon glyphicon-camera"></span></button></div><div class="visible-xs visible-sm hidden-md hidden-lg"><button type=button uib-tooltip="{{\'@APP-COMMON-ENVIO-DOCUMENTOS-ENVIAR-ARQUIVO\' | translate}}" ngf-select="vm.upload($file, conta)" class="btn btn-default btn-secondary upload-box-file-uploaded-button"><img width=15 height=20 ng-src={{vm.uploadIcone}}></button> <button type=button uib-tooltip="{{\'@APP-COMMON-ENVIO-DOCUMENTOS-CAPTURAR-IMAGEM\' | translate}}" ng-click=vm.clickUpload(conta.NumeroContaEnergia) ng-if="vm.clientId == \'agencia-virtual-cpfl-web\'" class="btn btn-default btn-secondary upload-box-file-uploaded-button"><span class="glyphicon glyphicon-camera"></span></button> <input id=uploadCamera{{conta.NumeroContaEnergia}} type=file accept=image/* capture=camera style=display:none ngf-select="vm.upload($file, conta)" ngf-resize-if="$width > 1024 || $height > 768" ngf-resize="{width: 1024, height: 768}"></div></div></div><div class=loader ng-hide=!conta.isUploading></div><div class=upload-box-file-uploaded ng-if=conta.ArquivoCarregado && ng-hide=conta.isUploading><div><button type=button class="btn btn-default btn-secondary upload-box-file-uploaded-button" ng-click="vm.delete(conta.ArquivoCarregado, conta)"><i class="fa fa-trash hand upload-box-file-uploaded-icon" aria-hidden=true></i></button></div></div></div></td></tr></tbody></table></div></div></section><div class=buttons ng-if="!vm.validacaoInvalida && !vm.perfilRedeFacil && vm.clientId != \'agencia-virtual-cpfl-terminal\'"><div class=row><div class="col-xs-24 col-md-8"><button id=btnApresentarEletricista ng-show="vm.dadosValidacao.ExisteBlackList == \'N\'" type=button class="btn btn-link" ng-click="vm.debitosPagos(false, vm.tableParams.data, vm.dadosValidacao.ExisteBlackList, vm.dadosValidacao.ValidaRegraLiberacao.RegraCon