a.put("modules/login/templates/modal-login-orientacoes-cnpj-socio.html",'<div class=cpfl-style><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-SOCIO-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-SOCIO-MENSAGEM-P1></p><br><p translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-SOCIO-MENSAGEM-P2></p><br><p translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-SOCIO-MENSAGEM-P3></p></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12 col-md-offset-6"><button id=btnOK type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.entender() translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-SOCIO-ENTENDI></button></div></div></div></div></div>');a.put("modules/login/templates/modal-login-remover-conta-acesso.html",'<div class=modal-header><div class=row><div class=col-xs-24></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-EXCLUI-CONTA-CNPJ></p></div></div><div class=row><div class="col-xs-24 col-sm-12 col-md-12 col-lg-12"><span translate=@APP-MODAL-LOGIN-EXCLUI-EMAIL></span> <span ng-bind=::vm.documento.UsuarioEmail></span></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12 col-md-push-12"><button class="btn btn-default btn-lg btn-block" ng-click=vm.confirmar() translate=@APP-MODAL-LOGIN-DESASSOCIAR-INSTALACAO-BTN-CONFIRMAR></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button class="btn btn-secondary btn-lg btn-block" ng-click=vm.cancelar() translate=@APP-MODAL-LOGIN-DESASSOCIAR-INSTALACAO-BTN-CANCELAR></button></div></div></div></div>');a.put("modules/login/templates/modal-login-sem-documento.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-SEM-DOCUMENTO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-login-sem-documento></alert><h3 translate=@APP-MODAL-LOGIN-SEM-DOCUMENTO-LABEL></h3></div></div><div class=row><form name=form novalidate><div class="col-md-24 col-md-12"><div class=form-group><div class=radio ng-init="vm.atividadeSelecionada = \'true\'"><label class=radio><input type=radio value=true ng-model=vm.atividadeSelecionada required data-required=true style=top:-4px> <span translate=@APP-MODAL-LOGIN-SEM-DOCUMENTO-ENTREGAR-DEPOIS-LABEL></span></label><label class=radio-inline><input type=radio value=false ng-model=vm.atividadeSelecionada required data-required=true style=top:-4px> <span translate=@APP-MODAL-LOGIN-SEM-DOCUMENTO-ENTREGAR-AGORA-LABEL></span></label></div></div></div><div class="row col-md-24"><div class=col-md-12><button class="btn btn-default btn-lg btn-block" ng-click=vm.confirmar(form) translate=@APP-MODAL-LOGIN-REDIRECT-BTN-OK></button></div><div class=col-md-12><button class="btn btn-secondary btn-lg btn-block" ng-click=vm.cancelar() translate=@APP-MODAL-LOGIN-VALIDACAO-TOKEN-CADASTRO-BTN-CANCELAR></button></div></div></form></div></div></div>');a.put("modules/login/templates/modal-login-status-conta-acesso.html",'<div class="modal-content cpfl-style" ng-if="vm.codigoStatusConta != \'3\'"><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.close() aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-VALIDA-ACESSO-TITLE></h2></div></div></div><div class=modal-body><div class=row ng-if="vm.codigoStatusConta == \'7\'"><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-VALIDA-ACESSO-1></p><p>Para concluir o seu cadastro acesse em nosso site o serviço <a class=hand ng-click=vm.redirecionamento();>Envio de documentos</a> e anexe a documentação solicitada.</p></div></div><div class=row ng-if="vm.codigoStatusConta == \'8\' || vm.codigoStatusConta == \'6\'"><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-VALIDA-ACESSO-2></p><br></div></div><div class=row ng-if="vm.codigoStatusConta == \'9\'"><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-VALIDA-ACESSO-4></p><p>Para concluir o seu cadastro acesse em nosso site o serviço <a class=hand ng-click=vm.redirecionamento();>Envio de documentos</a> e anexe a documentação solicitada.</p></div></div><div class=row ng-if="vm.codigoStatusConta == \'10\'"><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-DOCUMENTOS-ACEITOS-REENVIO-EMAIL-MENSAGEM translate-values="{nome: \'{{vm.nome}}\', email: \'{{vm.emailFake}}\'}"></p><br><p>Atenção: Caso não tenha recebido <a class=hand ng-click=vm.reenviarEmailCadastro();>clique aqui</a> para reenvio.</p></div></div></div></div><div class="modal-content cpfl-style" ng-if="vm.codigoStatusConta != \'3\'"><div class=modal-body><div class=row><div class="col-md-12 col-md-push-6"><div class=buttons><button class="btn btn-default btn-lg btn-block" ng-click=vm.close() translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-INDIVIDUAL-ENTENDI></button></div></div></div><div class=modal-footer></div></div></div><div class="modal-content cpfl-style" ng-if="(vm.statusDocumento == \'docNaoEnviado\' || vm.statusDocumento == \'docEnviado\') && vm.codigoStatusConta == \'3\'"><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.close() aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-CONFIRMACAO-REENVIO-EMAIL-CADASTRO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-VALIDA-CADASTRO-REENVIO-EMAIL-MENSAGEM translate-values="{nome: \'{{vm.nome}}\', email: \'{{vm.emailFake}}\'}"></p><br><p>Atenção: Caso não tenha recebido <a class=hand ng-click=vm.reenviarEmailCadastro();>clique aqui</a> para reenvio.</p></div></div><div class=modal-footer><div class=row><div class=buttons></div></div></div></div></div><div class="modal-content cpfl-style" ng-if="vm.statusDocumento == \'docNaoEnviadoConfirmado\' && vm.codigoStatusConta == \'3\'"><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.close() aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-VALIDA-ACESSO-TITLE></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-VALIDA-ACESSO-1></p><p>Para concluir o seu cadastro acesse em nosso site o serviço <a class=hand ng-click=vm.redirecionamento();>Envio de documentos</a> e anexe a documentação solicitada.</p></div></div></div><div class=modal-body><div class=row><div class="col-md-12 col-md-push-6"><div class=buttons><button class="btn btn-default btn-lg btn-block" ng-click=vm.close() translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-INDIVIDUAL-ENTENDI></button></div></div></div><div class=modal-footer></div></div></div>');a.put("modules/login/templates/modal-login-sucesso-adicionar-instalacoes-documento.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-SUCESSO-ADICIONAR-INSTALACOES-DOCUMENTO-TITLE></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-login-sucesso-adicionar-instalacoes-documento></alert></div></div><div class=row><div class=col-xs-24><span translate=@APP-MODAL-LOGIN-SUCESSO-ADICIONAR-INSTALACOES-DOCUMENTO-MENSAGEM></span></div></div><div class=row><div class=col-xs-24><table ng-table=vm.tableParams class=table show-filter=true><tr ng-repeat="instalacao in $data"><td title="\'\'"><div class=form-group><div class="checkbox checkbox-table"><input type=checkbox id=instalacaoSelecionada_{{$index}} ng-model=instalacao.Selecionada ng-click=vm.selecionarInstalacao(instalacao)><label for=instalacaoSelecionada_{{$index}}></label></div></div></td><td style=text-align:center title="\'Instalação\'" filter="{ Uc: \'text\'}" sortable>{{::instalacao.Uc}}</td><td style=text-align:center title="\'Endereço\'" filter="{ Endereco: \'text\'}" sortable>{{::instalacao.Endereco}}</td></tr></table></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-12"><button class="btn btn-default btn-lg btn-block" id=btnConfirm ng-click=vm.vincularInstalacoes() translate=@APP-MODAL-LOGIN-SUCESSO-ADICIONAR-INSTALACOES-DOCUMENTO-BTN-VINCULAR></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=vm.cancelar() translate=@APP-MODAL-LOGIN-SUCESSO-ADICIONAR-INSTALACOES-DOCUMENTO-BTN-CANCELAR></button></div></div></div></div></div>');a.put("modules/login/templates/modal-login-sucesso-cadastro-email.html",'<div class="modal-content cpfl-style"><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.fechar(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-TITLE></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-login-sucesso-cadastrar-email></alert></div></div><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-ATIVACAO ng-if=vm.aguardandoAtivacao></p><p translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-VALIDACAO ng-if=vm.aguardandoCadastro></p><p translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-SOLICITADO-RESET-SENHA translate-values="{nome: \'{{vm.nome}}\', email: \'{{vm.emailFake}}\'}" ng-if=vm.aguardandoResetSenha></p><p translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-REJEITADO ng-if=vm.rejeitada></p><p translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-DOCUMENTO ng-if=vm.aguardandoDocumento></p><p translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-ANALISE ng-if=vm.aguardandoAnaliseDocumento></p><p translate=@APP-MODAL-LOGIN-DOCUMENTOS-ACEITOS-REENVIO-EMAIL-MENSAGEM translate-values="{nome: \'{{vm.nome}}\', email: \'{{vm.emailFake}}\'}" ng-if=vm.aguardandoAtivacaoDocumentoOk></p></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12 col-md-push-6"><div ng-if=vm.aguardandoAnaliseDocumento><button class="btn btn-default btn-lg btn-block" ng-click=vm.fechar(); translate=@APP-MODAL-LOGIN-REPONSAVEL-CNPJ-ENTENDI></button></div><div ng-if=vm.aguardandoAtivacao><button class="btn btn-default btn-lg btn-block" ng-click=vm.reenviarEmailCadastro(); translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-ATIVACAO-BTN></button></div><div ng-if=vm.aguardandoDocumento><button class="btn btn-default btn-lg btn-block" ng-click=vm.reenviarDocumentoCadastro(); translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-DOCUMENTO-BTN></button></div><div ng-if=vm.rejeitada><button class="btn btn-default btn-lg btn-block" ng-click=vm.reenviarDocumentoCadastro(); translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-REJEITADO-BTN></button></div><div ng-if=vm.aguardandoAtivacaoDocumentoOk><button class="btn btn-default btn-lg btn-block" ng-click=vm.reenviarEmailCadastro(); translate=@APP-MODAL-LOGIN-SUCESSO-CADASTRAR-EMAIL-CNPJ-AGUARDANDO-ATIVACAO-BTN></button></div><div ng-if=vm.aguardandoResetSenha><button class="btn btn-default btn-lg btn-block" ng-click=vm.recuperarSenha(); translate=@APP-LOGIN-RESET-SENHA-LABEL-SENHA></button></div></div></div></div></div></div>');a.put("modules/login/templates/modal-login-sucesso-cadastro.html",'<div class=modal-header><div class=row><div class=col-xs-24><h2 class