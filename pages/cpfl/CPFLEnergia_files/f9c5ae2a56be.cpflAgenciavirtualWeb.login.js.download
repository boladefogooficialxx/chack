orm><div class="col-xs-24 col-md-20" style=margin-bottom:2em><span translate=@APP-MODAL-LOGIN-VERIFICACAO-CODIGO-ACESSO-SMS-LABEL-NAO-RECEBEU></span> <a class=hand translate=@APP-MODAL-LOGIN-VERIFICACAO-CODIGO-ACESSO-SMS-LINK-REENVIAR-CODIGO ng-click=vm.reenviarCodigo()></a></div></div></div></div>');a.put("modules/login/templates/modal-nao-permite-login-instalacao.html",'<div class=cpfl-style><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.fechar(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-LOGIN-MUNICIPIO-NAO-PERMITE-LOGIN-INSTALACAO-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p style=font-size:1.1em translate=@APP-LOGIN-MUNICIPIO-NAO-PERMITE-LOGIN-INSTALACAO-RESULTADO></p></div></div></div><div class=modal-footer style=margin-top:-3em><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-6"><button class="btn btn-default btn-lg btn-block" ng-click=vm.redirect() translate=@APP-LOGIN-MUNICIPIO-NAO-PERMITE-LOGIN-INSTALACAO-BTN-CADASTRAR></button></div></div></div></div><div class=modal-body style=margin-top:-1em><div class=row><div class=col-xs-24><p style=font-size:0.9em translate=@APP-LOGIN-MUNICIPIO-NAO-PERMITE-LOGIN-INSTALACAO-ALERT-TEXTO></p></div></div></div></div>');a.put("modules/login/templates/modal-tarifa-social-covid.html",'<div class=cpfl-style><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.close(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-MODAL-TARIFA-SOCIAL-COVID-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><div class=panel-body><p translate=@APP-MODAL-TARIFA-SOCIAL-COVID></p></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12"><button class="btn btn-default btn-lg btn-block" ng-click=vm.consultarMinhasContas() translate=@APP-MODAL-TARIFA-SOCIAL-COVID-BTN-CONSULTAR></button></div><div class="col-xs-24 col-md-12" ng-if=!vm.isCredenciado><button class="btn btn-default btn-lg btn-block" ng-click=vm.detalhesTarifaSocial() translate=@APP-MODAL-TARIFA-SOCIAL-COVID-BTN-TARIFA></button></div><div class="col-xs-24 col-md-12"><button class="btn btn-default btn-lg btn-block" ng-click=vm.outrosServicos() translate=@APP-MODAL-TARIFA-SOCIAL-COVID-BTN-OUTROS></button></div></div></div></div></div>');a.put("modules/login/views/login-ativar.html",'<div class=login><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-LOGIN></a></li><li class=active translate=@APP-COMMON-BREADCRUMB-LOGIN-ATIVAR></li></ol></div></div><div class=row><div class=col-xs-24><h2 translate=@APP-LOGIN-RESULTADO-ATIVAR-TITLE></h2></div></div><div class=row><div class=col-xs-24><alert></alert></div></div><div class=row ng-if="loginAtivarCtrl.ativado === true"><div class=col-xs-24><div class=obrigadoCadastro><h2 translate=@APP-LOGIN-RESULTADO-ATIVAR-SUBTITLE></h2><p translate=@APP-LOGIN-RESULTADO-ATIVAR-MESSAGE ng-if=!loginAtivarCtrl.isAuthenticated></p></div></div></div></div>');a.put("modules/login/views/login-atualizar-dados-usuario.html",'<div class=login><div ng-if="vm.cpfCnpj == \'CNPJ\'"><cabecalho-pagina titulo-cabecalho={{vm.titulo}} sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.login.login titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-LOGIN sref-breadcrumb3="" titulo-breadcrumb3={{vm.breadcrumb3}}></cabecalho-pagina></div><div ng-if="!vm.cpfCnpj || vm.cpfCnpj == \'CPF\'"><cabecalho-pagina titulo-cabecalho={{vm.titulo}} sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.login.login titul