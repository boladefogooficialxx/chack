a.put("modules/login/views/login-configurar-reset-senha.html",'<div class=login><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li><a ui-sref=app.login.configurar translate=@APP-COMMON-BREADCRUMB-LOGIN-CONFIGURAR-CONTA></a></li><li class=active translate=@APP-COMMON-BREADCRUMB-LOGIN-RESET-SENHA></li></ol></div></div><div class=row><div class=col-xs-24><h1 translate=@APP-LOGIN-RESET-SENHA-TITLE></h1></div></div><div class=row><div class=col-xs-24><alert></alert></div></div><div class=row><div class=col-xs-24><form name=formLoginConfigurarResetSenha novalidate><div class=row ng-hide=!loginConfigurarResetSenhaCtrl.cadastrousuario><div class=col-xs-24><h2 translate=@APP-LOGIN-RESET-SENHA-SUBTITLE></h2></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=email translate=@APP-LOGIN-RESET-SENHA-LABEL-EMAIL data-required=true></label><input type=email class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=loginConfigurarResetSenhaCtrl.reset.email required cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label ng-if=!loginConfigurarResetSenhaCtrl.cadastro class=inputs for=password translate=@APP-LOGIN-RESET-SENHA-LABEL-SENHA data-required=true></label><label ng-if=loginConfigurarResetSenhaCtrl.cadastro class=inputs for=password translate=@APP-LOGIN-ALTERAR-SENHA-LABEL-SENHA data-required=true></label><input type={{loginConfigurarResetSenhaCtrl.passwordInputType}} class=form-control id=password autocomplete=new-password ng-model=loginConfigurarResetSenhaCtrl.reset.senha required cpfl-highlight-input></div><div class=form-group><div class=checkbox><input type=checkbox id=showPasswordCheckbox ng-model=loginConfigurarResetSenhaCtrl.showPassword ng-click=loginConfigurarResetSenhaCtrl.hideShowPassword()><label for=showPasswordCheckbox>{{"@APP-LOGIN-RESET-SENHA-LABEL-MOSTRAR-SENHA" | translate}}</label></div></div></div></div><div class=row><div class="col-xs-24 col-md-6 col-md-offset-18"><div class=buttons><button class="btn btn-default btn-lg btn-block" ng-click=loginConfigurarResetSenhaCtrl.resetarSenha() ng-disabled=formLoginConfigurarResetSenha.$invalid translate=@APP-LOGIN-RESET-SENHA-BTN-RESETAR></button></div></div></div></form></div></div></div>');a.put("modules/login/views/login-credenciados-poder-publico.html",'<div class="login container homeCredenciadosDeslogada"><cabecalho-pagina titulo-cabecalho="" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-LOGIN></cabecalho-pagina><div class=row><div class=col-xs-24><div uib-alert ng-repeat="mensagem in loginCtrl.mensagens" ng-class=mensagem.type close="mensagem.close(loginCtrl.mensagens, $index)"><i class="alert-icon fa fa-2x" ng-class=mensagem.icon></i> <span id=msg-alerta class=alert-message>{{mensagem.message}}</span></div></div></div><div class=row><div class=col-xs-24><div class=loginSection><div class=row><div class="col-xs-24 col-md-11"><div class=loginArea><h2 class=modal-title id=modal-title translate=@APP-LOGIN-CREDENCIADOS-PODER-PUBLICO></h2><br><p translate=@APP-LOGIN-CREDENCIADOS-PODER-PUBLICO-DESCRICAO></p><p class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-PODER-PUBLICO-INFORMACOES></p></div></div><div id=linhaVertical><div class="col-xs-24 col-md-2"><div class="loginArea nb np"><div class="lineOu text-center"><span class="topo hidden-xs hidden-sm"></span> <span class="bottom hidden-xs hidden-sm"></span></div></div></div></div><div class="col-xs-24 col-md-11"><div ng-if=vm.mostrarFormLogin class=loginArea><p translate=@APP-LOGIN-CREDENCIADOS-LOGIN-SECTION-ENTRAR-MENSAGEM></p><form name=poderPublicoForm novalidate><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><label for=cnpj translate=@APP-LOGIN-CREDENCIADOS-INPUT-CNPJ data-required=true class=inputs></label><input id=cnpj class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CNPJ\' | translate}}" ng-model=vm.cnpj ng-cnpj custom-cnpj-mask cpfl-highlight-input autocomplete=off required></div></div><div class=col-xs-24><div class=form-group><label for=password translate=@APP-LOGIN-CREDENCIADOS-INPUT-SENHA data-required=true class=inputs></label><input type=password class=form-control id=password ng-model=vm.password required cpfl-highlight-input></div><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.loginPoderPublico(poderPublicoForm) translate=@APP-LOGIN-BTN-ENTRAR></button></div><div class=buttons><button id=btnEsqueciSenha type=button class="btn btn-link pull-right" ng-click=vm.mostrarReceberSenhaPorEmail() translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR-RECUPERAR-SENHA></button></div></div></div></form></div><div ng-if=vm.mostrarFormResetSenha class=loginArea><h2 class=modal-title id=modal-title translate=@APP-LOGIN-CREDENCIADOS-RECUPERAR-SENHA></h2><p translate=@APP-LOGIN-CREDENCIADOS-PRENCHER-CAMPOS></p><form name=recuperarSenhaPoderPublicoForm novalidate><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><label for=cnpj translate=@APP-LOGIN-CREDENCIADOS-INPUT-CNPJ data-required=true class=inputs></label><input id=cnpj class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=vm.cnpj ng-cnpj custom-cnpj-mask cpfl-highlight-input autocomplete=off required></div></div><div class="col-xs-24 col-md-24"><div class=form-group><label for=email translate=@APP-LOGIN-CREDENCIADOS-INPUT-EMAIL data-required=true class=inputs></label><input id=email class=form-control type=email placeholder="{{\'@APP-LOGIN-PLACEHOLDER-EMAIL\' | translate}}" cpfl-highlight-input ng-model=vm.email autocomplete=off required></div></div><div class=col-xs-24><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.recuperarSenhaPoderPublico(recuperarSenhaPoderPublicoForm) translate=@APP-LOGIN-CREDENCIADOS-RECEBER-NOVA-SENHA></button></div></div></div></form></div></div></div></div></div></div></div>');a.put("modules/login/views/login-credenciados.html",'<div class="login container homeCredenciadosDeslogada"><cabecalho-pagina titulo-cabecalho="" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-LOGIN></cabecalho-pagina><div class=row><div class=col-xs-24><div uib-alert ng-repeat="mensagem in loginCtrl.mensagens" ng-class=mensagem.type close="mensagem.close(loginCtrl.mensagens, $index)"><i class="alert-icon fa fa-2x" ng-class=mensagem.icon></i> <span class=alert-message>{{mensagem.message}}</span></div></div></div><div class=row><div class=col-xs-24><div class=loginSection><div class=row><div class="col-xs-24 col-md-11"><div class=loginArea><h2 translate={{vm.parceiro.nome}} class=modal-title></h2><br><p translate={{vm.parceiro.descricaoLogin}}></p><p ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro != 4 && vm.parceiro.tipoParceiro != 10" class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-INFORMACOES-DUVIDAS></p><p ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro == 10" class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-INFORMACOES-DUVIDAS-SP></p><p ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro == 4" class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-INFORMACOES-DUVIDAS-IMOBILIARIA></p><p ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro == 36" class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-USUARIOS-RGE></p><p ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro == 36" class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-INFORMACOES-DUVIDAS-DEMAIS-INSTITUICOES></p><p ng-if=vm.parceiro.email translate={{vm.parceiro.email}} class=custom-paragrafo-credenciados></p><br ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro == 10"><p ng-if="vm.parceiro.email && vm.parceiro.tipoParceiro == 10" class=custom-paragrafo-credenciados translate=@APP-LOGIN-CREDENCIADOS-INFORMACOES-DUVIDAS-RS></p><p ng-if=vm.parceiro.emailRS translate={{vm.parceiro.emailRS}} class=custom-paragrafo-credenciados></p><br ng-if="vm.parceiro.emailRge && vm.parceiro.tipoParceiro != 4"><p ng-if="vm.parceiro.emailRge && vm.parceiro.tipoParceiro != 4" translate=@APP-LOGIN-CREDENCIADOS-DESCRICAO-EMAIL-RGE translate-values="{nomeTipoParceiro: \'{{vm.parceiro.nomeTraduzido}}\'}" class=custom-paragrafo-credenciados></p><p ng-if="vm.parceiro.emailRge && vm.parceiro.tipoParceiro == 4" translate=@APP-LOGIN-CREDENCIADOS-DESCRICAO-EMAIL-RGE-IMOBILIARIAS translate-values="{nomeTipoParceiro: \'{{vm.parceiro.nomeTraduzido}}\'}" class=custom-paragrafo-credenciados></p><p ng-if=vm.parceiro.emailRge translate={{vm.parceiro.emailRge}} class=custom-paragrafo-credenciados></p><p ng-if=vm.parceiro.primeiroAcesso class=custom-paragrafo-credenciados>Clique <a ui-sref="app.login.primeiro-acesso-seguradoras({\'parceiro\': {{vm.parceiro}}})" class=hand>aqui</a> se este for seu primeiro acesso.</p></div></div><div id=linhaVertical><div class="col-xs-24 col-md-2"><div class="loginArea nb np"><div class="lineOu text-center"><span class="topo hidden-xs hidden-sm"></span> <span class="bottom hidden-xs hidden-sm"></span></div></div></div></div><div class="col-xs-24 col-md-11"><div ng-if=vm.mostrarFormLogin class=loginArea><p translate=@APP-LOGIN-CREDENCIADOS-LOGIN-SECTION-ENTRAR-MENSAGEM></p><form name=loginCredenciadoForm novalidate><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><label for=usuario class=inputs translate=@APP-LOGIN-CREDENCIADOS-INPUT-USUARIO data-required=true></label><input class=form-control type=text id=usuario ng-model=vm.loginUsername autocomplete=off required cpfl-highlight-input maxlength=10></div></div><div class=col-xs-24><div class=form-group><label for=password class=inputs translate=@APP-LOGIN-CREDENCIADOS-INPUT-SENHA data-required=true></label><input type=password class=form-control id=password ng-model=vm.loginPassword required cpfl-highlight-input></div><div vc-recaptcha on-create=vm.setCaptchaWidgetId(widgetId) on-success=vm.setCaptchaResponse(response)></div><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.login(loginCredenciadoForm) translate=@APP-LOGIN-BTN-ENTRAR></button></div><div class=buttons><button id=btnInstrucoesCodigo type=button class="btn btn-link pull-right" ng-click=vm.mostrarReceberSenhaPorEmail() translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR-RECUPERAR-SENHA></button></div></div></div></form></div><div ng-if=vm.mostrarFormResetSenha class=loginArea><h2 class=modal-title id=modal-title translate=@APP-LOGIN-CREDENCIADOS-RECUPERAR-SENHA></h2><p translate=@APP-LOGIN-CREDENCIADOS-PRENCHER-CAMPOS></p><form name=recuperarSenhaCredenciadoForm novalidate><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><label for=usuarioEsqueciSenha class=inputs translate=@APP-LOGIN-CREDENCIADOS-INPUT-USUARIO data-required=true></label><input class=form-control type=tel id=usuarioEsqueciSenha ng-model=vm.usuario cpfl-highlight-input autocomplete=off required maxlength=10></div></div><div class=col-xs-24><div class=form-group><label for=documentoEsqueciSenha class=inputs translate=@APP-LOGIN-CREDENCIADOS-INPUT-DOCUMENTO data-required=true></label><input type=text class=form-control id=documentoEsqueciSenha ng-model=vm.documento required></div><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.recuperarSenha(recuperarSenhaCredenciadoForm) translate=@APP-LOGIN-CREDENCIADOS-RECEBER-NOVA-SENHA></button></div></div></div></form></div><div ng-if=vm.mostrarFormSenhaEspirada class=loginArea><h2 class=modal-title id=modal-title translate=@APP-LOGIN-CREDENCIADOS-REDEFINIR-SENHA></h2><p translate=@APP-LOGIN-CREDENCIADOS-REDEFINIR-SENHA-TEXTO></p><form name=alterarSenhaExpiradaCrenciadosForm novalidate><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><label for=matriculaSenhaExpirada class=inputs translate=@APP-LOGIN-CREDENCIADOS-INPUT-MATRICULA data-required=true></label><input id=matriculaSenhaExpirada class=form-control type=text ng-model=vm.loginUsername disabled></div></div><div class=col-xs-24><div class=form-group><label for=senhaAtual class=inputs translate=@APP-LOGIN-CREDENCIADOS-REDEFINIR-SENHA-LABEL-SENHA-ATUAL data-required=true></label><input type=password class=form-control id=senhaAtual ng-model=vm.loginPassword disabled></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=novaSenha class=inputs translate=@APP-LOGIN-CREDENCIADOS-REDEFINIR-SENHA-LABEL-NOVA-SENHA data-required=true></label><input type=password class=form-control id=novaSenha ng-model=vm.passwordNovaSenha required cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=confirmarNovaSenha class=inputs translate=@APP-LOGIN-CREDENCIADOS-REDEFINIR-SENHA-LABEL-CONFIRMAR-SENHA data-required=true></label><input type=password class=form-control id=confirmarNovaSenha ng-model=vm.passwordNovaSenhaConfirm required></div></div><div class=col-xs-24><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.alterarSenhaExpirada(alterarSenhaExpiradaCrenciadosForm) translate=@APP-LOGIN-CREDENCIADOS-REDEFINIR-SENHA-MINUSCULO></button></div></div></div></form></div></div></div></div></div></div></div>');a.put("modules/login/views/login-email.html",'<div class=login><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-LOGIN></a></li><li class=active translate=@APP-COMMON-BREADCRUMB-LOGIN-EMAIL></li></ol></div></div><div class=row><div class=col-xs-24><h2 translate=@APP-LOGIN-EMAIL-TITLE></h2></div></div><div class=row><div class=col-xs-24><alert></alert></div></div><div class=row><div class=col-xs-24><uib-tabset type=pills active=activePill justified=true><uib-tab index=0 heading="{{\'@APP-LOGIN-EMAIL-TAB-LOGIN\' | translate}}"><form id=loginEmailForm novalidate><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h2 translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR></h2></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=email translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR-INPUT-EMAIL data-required=true></label><input type=email class=form-control id=email ng-model=loginEmailCtrl.login.username placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=password translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR-INPUT-SENHA data-required=true></label><input type=password class=form-control id=password ng-model=loginEmailCtrl.login.password cpfl-highlight-input required><div class=buttons><button id=btnInstrucoesCodigo type=button class="btn btn-link" ng-click=loginEmailCtrl.recuperarSenha() translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR-RECUPERAR-SENHA></button></div></div></div></div></div></div><div class=row><div class="col-xs-24 col-md-6 col-md-offset-18"><div class=buttons><button id=btnEntrarEmail type=submit class="btn btn-default btn-lg btn-block" ng-click=loginEmailCtrl.loginEmail() translate=@APP-LOGIN-EMAIL-TAB-LOGIN-BTN-ENTRAR></button></div></div></div></form></uib-tab><uib-tab index=1 heading="{{\'@APP-LOGIN-EMAIL-TAB-CADASTRAR\' | translate}}"><div class=row><div class=col-xs-24><div uib-alert class=alert-info><div class="alert-icon info-icon"></div><span translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-ALERT class=alert-message></span></div></div></div><div class=row><div class=col-xs-24><form name=cadastrarEmailForm><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h2 translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-USUARIO></h2></div></div><div class=row><div class="col-xs-24 col-md-8"><div class=form-group><label class=inputs for=nome translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-USUARIO-INPUT-NOME data-required=true></label><input type=text class=form-control id=nome placeholder="{{\'@APP-COMMON-PLACEHOLDER-NOME\' | translate}}" ng-model=loginEmailCtrl.usuario.nome cpfl-highlight-input required only-letters></div></div><div class="col-xs-24 col-md-8"><div class=form-group><label class=inputs for=email translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-USUARIO-INPUT-EMAIL data-required=true></label><input type=email class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=loginEmailCtrl.usuario.email cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-8"><div class=form-group><label class=inputs for=password translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-USUARIO-INPUT-SENHA data-required=true></label><input type={{loginEmailCtrl.passwordInputType}} class=form-control id=password ng-model=loginEmailCtrl.usuario.senha cpfl-highlight-input required></div><div class=form-group><div class=checkbox><input type=checkbox id=checkboxShowPassword ng-model=loginEmailCtrl.showPassword ng-click=loginEmailCtrl.hideShowPassword();><label for=checkboxShowPassword><div ng-if=loginEmailCtrl.showPassword><span translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-USUARIO-INPUT-SENHA-ESCONDER></span></div><div ng-if=!loginEmailCtrl.showPassword><span translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-USUARIO-INPUT-SENHA-MOSTRAR></span></div></label></div></div></div></div></div></div><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h2 translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-TITULAR></h2></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=codigoImovel translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-TITULAR-INPUT-INSTALACAO data-required=true></label><input type=tel class=form-control id=codigoImovel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CODIGO-IMOVEL\' | translate}}" ng-model=loginEmailCtrl.usuario.Instalacao cpfl-highlight-input required autocomplete=off><div class=buttons><button id=encontrarInstalacao type=button class="btn btn-link" ng-click=loginEmailCtrl.encontrarInstalacao() translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-SECTION-DADOS-TITULAR-INPUT-INSTALACAO-ENCONTRAR></button></div></div></div><div class="col-xs-24 col-md-12"><div class=form-group><div class="radio-box-horizontal radioBoxTelaLoginEmail" ng-init="loginEmailCtrl.cpfCnpj = \'cpf\'"><label class=radio-inline><input type=radio name=localFaltaEnergia id=selectCpf value=cpf ng-change="loginEmailCtrl.usuario.documento = undefined" ng-model=loginEmailCtrl.cpfCnpj> <span translate=@APP-COMMON-CPF></span></label><label class=radio-inline><input type=radio name=localFaltaEnergia id=selectCnpj value=cnpj ng-change="loginEmailCtrl.usuario.documento = undefined" ng-model=loginEmailCtrl.cpfCnpj> <span translate=@APP-COMMON-CNPJ></span></label></div><div ng-if="loginEmailCtrl.cpfCnpj == \'cpf\'"><input id=documentoCpf class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=loginEmailCtrl.usuario.documento ng-cpf custom-cpf-mask cpfl-highlight-input autocomplete=off required></div><div ng-if="loginEmailCtrl.cpfCnpj == \'cnpj\'"><input id=documentoCnpj class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CNPJ\' | translate}}" ng-model=loginEmailCtrl.usuario.documento ng-cnpj custom-cnpj-mask cpfl-highlight-input autocomplete=off required></div></div></div></div></div></div><div class=row><div class="col-xs-24 col-md-6 col-md-offset-18"><div class=buttons><button id=btnCadastrar type=submit class="btn btn-default btn-lg btn-block" ng-click=loginEmailCtrl.cadastrarEmail() ng-disabled=cadastrarEmailForm.$invalid translate=@APP-LOGIN-EMAIL-TAB-CADASTRAR-BTN-CADASTRAR></button></div></div></div></form></div></div></uib-tab></uib-tabset></div></div></div>');a.put("modules/login/views/login-permissao-acesso-credenciado.html",'<div class=login><div><cabecalho-pagina titulo-cabecalho=@APP-LOGIN-CONFIGURAR-CONTA-TITLE-CONTA-ACESSO-CNPJ sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.login.login titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-LOGIN sref-breadcrumb3="" titulo-breadcrumb3=@APP-COMMON-BREADCRUMB-LOGIN-CONFIGURAR-CONTA-CNPJ></cabecalho-pagina></div><div class=row><div class=col-xs-24><div class=row><div class=col-xs-12><p translate=@APP-LOGIN-CONFIGURAR-CONTA-TITLE-CONTA-ACESSO-CRED-MENSAGEM-P1></p><br><p translate=@APP-LOGIN-CONFIGURAR-CONTA-TITLE-CONTA-ACESSO-CRED-MENSAGEM-P2></p></div><div class=col-xs-12 style="margin-top: -50px"><h1 translate=@APP-LOGIN-CONFIGURAR-CONTA-TITLE-GESTAO-CONTA-ACESSO-CNPJ></h1><div ng-if=vm.tableParams><h2>Você possui {{vm.totalRegistro}} contas em seu perfil</h2></div></div></div><div class=row><form name=form novalidate><div class=col-xs-12><div class=row style=margin-top:1.5em><div class="col-xs-24 col-md-24"><div class=form-group><label for=nome class=inputs translate=@APP-LOGIN-CADASTRAR-SECTION-DADOS-ACESSO-INPUT-NOME data-required=true></label><input type=text class=form-control id=nome placeholder="{{\'@APP-COMMON-PLACEHOLDER-NOME\' | translate}}" ng-model=vm.nomeCompleto cpfl-highlight-input required nome-composto only-letters></div></div><div class="col-xs-24 col-md-24"><div class=form-group><label for=email class=inputs translate=@APP-LOGIN-CADASTRAR-SECTION-DADOS-ACESSO-INPUT-EMAIL data-required=true></label><input type=email class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.email maxlength=50 cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-24"><div class=form-group><label for=email class=inputs translate=@APP-LOGIN-CADASTRAR-CNPJ-INPUT-CONFIRMAR-EMAIL data-required=true></label><input type=email class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.confirmaemail maxlength=50 cpfl-highlight-input required acn-confirmation-validator=vm.email></div></div><div class="col-xs-24 col-md-24"><div class=form-group><label for=cpf class=inputs translate=@APP-LOGIN-CADASTRAR-SECTION-DADOS-ACESSO-INPUT-CPF data-required=true></label><input id=cpf class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=vm.cpf ng-cpf custom-cpf-mask autocomplete=off cpfl-highlight-input required></div></div></div><div><div class=row><div class=col-xs-12></div><div class=col-xs-12><button type=submit class="btn btn-default btn-lg btn-block hand" name=dados ng-click=vm.enviarPermissao(form) translate=@APP-LOGIN-CONFIGURAR-CONTA-TITLE-GESTAO-CONTA-ACESSO-CNPJ-ENVIAR-PERMISSAO></button></div></div></div></div></form><div class=col-xs-12 ng-if=vm.tableParams><table class=table ng-table=vm.tableParams><thead><tr><th>Login</th><th>Nome</th><th>Status</th><th></th><th>Acesso</th></tr></thead><tbody><tr ng-repeat="credenciado in $data"><td ng-bind=credenciado.UsuarioCP></td><td ng-bind=credenciado.UsuarioNome></td><td ng-bind=credenciado.Status></td><td></td><td><button class="btn btn-default btn-remover" ng-if="credenciado.Status == \'ATIVO\'" ng-click=vm.removerPermissao(credenciado) uib-tooltip="Remover Acesso"><span class="fa fa-times"></span></button></td></tr></tbody></table></div></div></div></div></div>');a.put("modules/login/views/login-primeiro-acesso-seguradoras.html",'<div class=login><cabecalho-pagina titulo-cabecalho=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-TITULO sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-TITULO-BREADCRUMB></cabecalho-pagina><div class=row><div class=col-xs-24><br><p translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-MENSAGEM-1></p><p translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-MENSAGEM-2></p><br><form name=primeiroAcessoSeguradorasForm novalidate><div class=row><div class=col-xs-24><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=razaoSocial translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-INPUT-RAZAO-SOCIAL data-required=true></label><input type=text class=form-control id=razaoSocial placeholder="{{\'@APP-COMMON-PLACEHOLDER-RAZAO-SOCIAL\' | translate}}" ng-model=vm.razaoSocial nome-composto cpfl-highlight-input required only-letters></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=cnpj translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-INPUT-CNPJ data-required=true></label><input id=cnpj class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CNPJ\' | translate}}" ng-model=vm.cnpj ng-cnpj custom-cnpj-mask cpfl-highlight-input autocomplete=off required></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=nomeContato translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-INPUT-CONTATO data-required=true></label><input type=text class=form-control id=nomeContato placeholder="{{\'@APP-COMMON-PLACEHOLDER-NOME-CONTATO\' | translate}}" ng-model=vm.nomeContato nome-composto cpfl-highlight-input required only-letters></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=telefone class=inputs translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-INPUT-TELEFONE-CONTATO data-required=true></label><input type=text class=form-control id=telefone placeholder="{{\'@APP-COMMON-PLACEHOLDER-TELEFONE\' | translate}}" ng-model=vm.telefoneContato ng-attr-ui-mask="{{vm.telefoneContato && vm.returnOnlyNumber(vm.telefoneContato).length > 10 ? \'(99) 99999-999?9\' : \'(99) 9999-9999?9\'}}" ui-mask-placeholder ui-mask-placeholder-char=space cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs for=emailContato translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-INPUT-EMAIL-CONTATO data-required=true></label><input type=email class=form-control id=emailContato placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.emailContato acn-email-validator required cpfl-highlight-input></div></div></div></div></div><div class=row><div class="col-xs-24 col-md-8 col-md-offset-16"><div class=buttons><button id=btnEnviar type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.enviar(primeiroAcessoSeguradorasForm) translate=@APP-LOGIN-PRIMEIRO-ACESSO-SEGURADORAS-BTN-ENVIAR></button></div></div></div></form></div></div></div>');a.put("modules/login/views/login-resultado.html","<head><style type=text/css>.progressbar {\r"+"\n"+"            counter-reset: step;\r"+"\n"+"        }\r"+"\n"+"\r"+"\n"+"        #paramcnpj li {\r"+"\n"+"            list-style-type: none;\r"+"\n"+"            width: 20%;\r"+"\n"+"            float: left;\r"+"\n"+"            font-size: 12px;\r"+"\n"+"            position: relative;\r"+"\n"+"            text-align: center;\r"+"\n"+"            text-transform: uppercase;\r"+"\n"+"            color: #7d7d7d;\r"+"\n"+"        }\r"+"\n"+"\r"+"\n"+"        .progressbar li {\r"+"\n"+"            list-style-type: none;\r"+"\n"+"            width: 25%;\r"+"\n"+"            float: left;\r"+"\n"+"            font-size: 12px;\r"+"\n"+"            position: relative;\r"+"\n"+"            text-align: center;\r"+"\n"+"            text-transform: uppercase;\r"+"\n"+"            color: #7d7d7d;\r"+"\n"+"        }\r"+"\n"+"\r"+"\n"+"            .progressbar li:before {\r"+"\n"+"                width: 30px;\r"+"\n"+"                height: 30px;\r"+"\n"+"                content: counter(step);\r"+"\n"+"                counter-increment: step;\r"+"\n"+"                line-height: 30px;\r"+"\n"+"                border: 2px solid #01A9DB;\r"+"\n"+"                display: block;\r"+"\n"+"                text-align: center;\r"+"\n"+"                margin: 0 auto 10px auto;\r"+"\n"+"                border-radius: 50%;\r"+"\n"+"                background-color: white;\r"+"\n"+"            }\r"+"\n"+"\r"+"\n"+"            .progressbar li:after {\r"+"\n"+"                width: 100%;\r"+"\n"+"                height: 2px;\r"+"\n"+"                content: '';\r"+"\n"+"                position: absolute;\r"+"\n"+"                background-color: #01A9DB;\r"+"\n"+"                top: 15px;\r"+"\n"+"                left: -50%;\r"+"\n"+"                z-index: -1;\r"+"\n"+"            }\r"+"\n"+"\r"+"\n"+"            .progressbar li:first-child:after {\r"+"\n"+"                content: none;\r"+"\n"+"            }\r"+"\n"+"\r"+"\n"+"            .progressbar li.active {\r"+"\n"+"                color: #FF8000;\r"+"\n"+"            }\r"+"\n"+"\r"+"\n"+"                .progressbar li.active:before {\r"+"\n"+"                    border-color: #FF8000;\r"+"\n"+"                }\r"+"\n"+"\r"+"\n"+"                .progressbar li.active + li:after {\r"+"\n"+"                    background-color: #FF8000;\r"+"\n"+'                }</style></head><div class=login><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li><a ui-sref=app.login.login translate=@APP-COMMON-BREADCRUMB-LOGIN></a></li><li class=active translate={{::loginResultadoCtrl.breadcrumb}}></li></ol></div></div><div ng-if="loginResultadoCtrl.cnpjcpf == \'CNPJ\'"><ul class=progressbar id=paramcnpj><li class=active translate=@APP-LOGIN-CADASTRAR-STEP1-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP2-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP3-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP4-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP5-IDENTIFICACAO></li></ul></div><div ng-if="loginResultadoCtrl.cnpjcpf == \'CPF\'"><ul class=progressbar><li class=active translate=@APP-LOGIN-CADASTRAR-STEP1-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP2-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP3-IDENTIFICACAO></li><li class=active translate=@APP-LOGIN-CADASTRAR-STEP4-IDENTIFICACAO-CPF></li></ul></div><br><br><div class=row><div class=col-xs-24><h2 translate={{::loginResultadoCtrl.title}}></h2></div></div><div class=row ng-if=loginResultadoCtrl.alert.code><div class=col-xs-24><div uib-alert class=alert-success><div class="alert-icon check-icon"></div><span translate={{::loginResultadoCtrl.alert.code}} translate-values={{::loginResultadoCtrl.alert.params}} class=alert-message></span></div></div></div><div class=row ng-if="loginResultadoCtrl.cnpjcpf == \'CNPJ\' || loginResultadoCtrl.cnpjcpf == \'CPF\'"><div class=col-xs-24><section id=info-protocolo ng-if=loginResultadoCtrl.protocolo><div class=protocolo><div class=protocolo-primary><span translate=@APP-LOGIN-CADASTRO-ENVIO-DOCUMENTO-RESULTADO-PROTOCOLO></span> <span class=numero-protocolo ng-bind=loginResultadoCtrl.protocolo></span></div></div></section></div></div><div class=row><div class=col-xs-24><div class=obrigadoCadastro><h2 translate={{::loginResultadoCtrl.subtitle}} ng-if=loginResultadoCtrl.subtitle></h2><p translate={{::loginResultadoCtrl.message.code}} translate-values={{::loginResultadoCtrl.message.params}} ng-if=loginResultadoCtrl.message.code></p></div></div></div><div class=buttons style=margin-top><div class=row><div ng-if=loginResultadoCtrl.exibirBotaoChat><div class="col-xs-24 col-md-8 col-md-offset-8"><button type=submit class="btn btn-default btn-lg btn-block" ng-click=loginResultadoCtrl.iniciarChat() translate=@APP-LOGIN-RESULTADO-BTN-INICIAR-CHAT></button></div></div><div ng-if="loginResultadoCtrl.externalProvider == \'Google\' && loginResultadoCtrl.cnpjcpf == \'CPF\'"><div class="col-xs-24 col-md-10 col-md-offset-8" ng-controller="LoginController as loginCtrl"><button class="btn btn-google btn-lg btn-block" ng-click=loginCtrl.loginGoogle()><div class="row np"><div class="col-xs-4 col-md-6 col-xs-offset-2 np"><i class="fa fa-2x fa-google-plus" aria-hidden=true></i></div><div class="col-xs-18 col-md-16 np"><span translate=@APP-LOGIN-BTN-GOOGLE></span></div></div></button></div></div><div ng-if="loginResultadoCtrl.externalProvider == \'Facebook\' && loginResultadoCtrl.cnpjcpf == \'CPF\'"><div class="col-xs-24 col-md-10 col-md-offset-8" ng-controller="LoginController as loginCtrl"><button class="btn btn-facebook btn-lg btn-block" ng-click=loginCtrl.loginFacebook()><div class="row np"><div class="col-xs-4 col-md-6 col-xs-offset-2 np"><i class="fa fa-2x fa-facebook-official" aria-hidden=true></i></div><div class="col-xs-18 col-md-16 np"><span translate=@APP-LOGIN-BTN-FACEBOOK></span></div></div></button></div></div></div></div></div>');
a.put("modules/login/views/login-terminal-atendimento.html","<style>.btn-center {\r"+"\n"+"        margin-left: 25%;\r"+"\n"+"    }\r"+"\n"+"\r"+"\n"+"    .mensagem-inicial {\r"+"\n"+"        text-align: center;\r"+"\n"+"        margin-bottom: 2.5em;\r"+"\n"+'    }</style><div class=login><cabecalho-pagina titulo-cabecalho="" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-LOGIN></cabecalho-pagina><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h1 translate={{vm.loginTitle}}></h1></div></div><div ng-if=vm.redirectToService><div class=row><div class=col-xs-24><div class="visible-xs visible-sm hidden-md hidden-lg"><div class=panel-help-servicos><div class=panel-group><div class="panel panel-default"><div class=panel-heading data-toggle=collapse data-target=#entendaServico ng-init="vm.accordion_1 = true" ng-click="vm.accordion_1 = !vm.accordion_1;" data-parent=#accordion><h4 class=panel-title><span translate=@APP-LOGIN-ENTENDA-SERVICO></span> <i id=iconeEntendaServico class="iconeEntendaServico pull-right fa" ng-class="{\'fa-plus\': vm.accordion_1, \'fa-minus\': !vm.accordion_1}"></i></h4></div><div id=entendaServico class="panel-collapse collapse"><div class=panel-body><div class=row><div class=col-xs-24><div class=panel-body-help-servico-descricao><span ng-bind=vm.redirectToService.descricao></span></div></div></div></div></div></div></div></div></div><div class="hidden-xs hidden-sm visible-md visible-lg"><div class=mensagemHelpServico><p ng-bind=vm.redirectToService.descricao></p></div></div></div></div></div></div><div class=col-xs-24><div class=loginSection><form name=loginForm novalidate><div class=row><div class="col-xs-24 mensagem-inicial"><span translate=@APP-LOGIN-TERMINAL-MENSAGEM></span></div><div class="col-xs-24 col-md-11"><div class=loginArea><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><div class=radio-box-horizontal ng-init="vm.cpfCnpj = \'cpf\'"><label class=radio-inline><input type=radio id=selectCpf value=cpf ng-change="vm.documento = undefined" ng-model=vm.cpfCnpj> <span translate=@APP-COMMON-CPF></span></label><label class=radio-inline><input type=radio id=selectCnpj value=cnpj ng-change="vm.documento = undefined" ng-model=vm.cpfCnpj> <span translate=@APP-COMMON-CNPJ></span></label></div><div ng-if="vm.cpfCnpj == \'cpf\'"><input id=documentoCpf class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=vm.documento ng-cpf custom-cpf-mask cpfl-highlight-input autocomplete=off ng-required="vm.instalacao == undefined"></div><div ng-if="vm.cpfCnpj == \'cnpj\'"><input id=documentoCnpj class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CNPJ\' | translate}}" ng-model=vm.documento ng-cnpj custom-cnpj-mask cpfl-highlight-input autocomplete=off ng-required="vm.instalacao == undefined"></div></div></div></div></div></div><div id=linhaVertical><div class="col-xs-24 col-md-2"><div class="loginArea nb np"><div class="lineOu text-center"><span class="topo hidden-xs hidden-sm"></span> <span class="hidden-md hidden-lg">ou</span></div></div></div></div><div class="col-xs-24 col-md-11" id=loginRedesSociais><div class=loginArea><div class=form-group><label for=senha class=inputs translate=@APP-LOGIN-INPUT-CODIGO-IMOVEL></label><input type=tel class=form-control id=seuCodigo placeholder="{{\'@APP-COMMON-PLACEHOLDER-CODIGO-IMOVEL\' | translate}}" ng-model=vm.instalacao only-numbers cpfl-highlight-input autocomplete=off ng-required="vm.documento == undefined"><div class=buttons><button id=encontrarInstalacao type=button class="btn btn-link" ng-click=vm.encontrarInstalacao() translate=@APP-LOGIN-CADASTRO-SENHA-LINK-ENCONTRAR-INSTALACAO></button></div></div></div></div><div class=col-xs-24><div class=buttons><button type=submit class="btn btn-default btn-lg btn-block" ng-click=vm.login(loginForm) translate=@APP-LOGIN-BTN-ENTRAR></button></div></div></div></form></div></div></div></div>');a.put("modules/login/views/login.html",'<div class=login><cabecalho-pagina titulo-cabecalho="" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-COMMON-BREADCRUMB-LOGIN></cabecalho-pagina><div class=row><div class=col-xs-24><div uib-alert ng-repeat="mensagem in loginCtrl.mensagens" ng-class=mensagem.type close="mensagem.close(loginCtrl.mensagens, $index)"><i class="alert-icon fa fa-2x" ng-class=mensagem.icon></i> <span class=alert-message>{{mensagem.message}}</span></div></div></div><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h1 translate={{loginCtrl.loginTitle}}></h1></div><div class=col-xs-24><p translate=@APP-LOGIN-SUBTITLE ng-if=!loginCtrl.redirectToService></p></div></div><div ng-if=loginCtrl.redirectToService><div class=row><div class=col-xs-24><div class="visible-xs visible-sm hidden-md hidden-lg"><div class=panel-help-servicos><div class=panel-group><div class="panel panel-default"><div class=panel-heading data-toggle=collapse data-target=#entendaServico ng-init="vm.accordion_1 = true" ng-click="vm.accordion_1 = !vm.accordion_1;" data-parent=#accordion><h4 class=panel-title><span translate=@APP-LOGIN-ENTENDA-SERVICO></span> <i id=iconeEntendaServico class="iconeEntendaServico pull-right fa" ng-class="{\'fa-plus\': vm.accordion_1, \'fa-minus\': !vm.accordion_1}"></i></h4></div><div id=entendaServico class="panel-collapse collapse"><div class=panel-body><div class=row><div class=col-xs-24><div class=panel-body-help-servico-descricao><span ng-bind=loginCtrl.redirectToService.descricao></span></div></div></div></div></div></div></div></div></div><div class="hidden-xs hidden-sm visible-md visible-lg"><div class=mensagemHelpServico><p ng-bind=loginCtrl.redirectToService.descricao></p></div></div></div></div></div></div><div class=col-xs-24><div class=loginSection><div class=row><div class="col-xs-24 col-md-11"><div class=loginArea><h2 translate=@APP-LOGIN-MENSAGEM-JA-SOU-CADASTRADO></h2><form name=loginInstalacaoForm novalidate><div class=row><div class="col-xs-24 col-md-24"><div class=form-group><div class=radio-box-horizontal ng-init="loginCtrl.cpfCnpj = \'email\'" ng-show="loginCtrl.ambiente == \'QA\'"><label class=radio-inline><input type=radio id=selectEmail value=email ng-change="loginCtrl.nmDocumento = undefined" ng-model=loginCtrl.cpfCnpj> <span translate=@APP-COMMON-EMAIL></span></label><label class=radio-inline><input type=radio id=selectCpf value=cpf ng-change="loginCtrl.nmDocumento = undefined" ng-model=loginCtrl.cpfCnpj> <span translate=@APP-COMMON-CPF></span></label><label class=radio-inline><input type=radio id=selectCnpj value=cnpj ng-change="loginCtrl.nmDocumento = undefined" ng-model=loginCtrl.cpfCnpj> <span translate=@APP-COMMON-CNPJ></span></label></div><div><label class=inputs data-required=true translate=@APP-LOGIN-LABEL-EMAIL-PROD ng-show="loginCtrl.ambiente != \'QA\'"></label></div><div ng-if="loginCtrl.cpfCnpj == \'email\'"><input id=documentoEmail class=form-control type=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=loginCtrl.nmDocumento cpfl-highlight-input autocomplete=off required></div><div ng-if="loginCtrl.cpfCnpj == \'cpf\'"><input id=documentoCpf class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=loginCtrl.nmDocumento ng-cpf custom-cpf-mask cpfl-highlight-input autocomplete=off required></div><div ng-if="loginCtrl.cpfCnpj == \'cnpj\'"><input id=documentoCnpj class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CNPJ\' | translate}}" ng-model=loginCtrl.nmDocumento ng-cnpj custom-cnpj-mask cpfl-highlight-input autocomplete=off required></div></div></div><div class=col-xs-24><div class=form-group ng-if="loginCtrl.cpfCnpj == \'email\'"><label for=senha class=inputs translate=@APP-LOGIN-INPUT-SENHA data-required=true></label><input type=password class=form-control id=password placeholder="{{\' @APP-COMMON-PLACEHOLDER-SENHA\' | translate}}" ng-model=loginCtrl.password cpfl-highlight-input autocomplete=off required><br><div style="position:relative initial"><div vc-recaptcha on-create=loginCtrl.setCaptchaWidgetId(widgetId) on-success=loginCtrl.setCaptchaResponse(response)></div></div><div class=buttons><button id=btnInstrucoesCodigo type=button class="btn btn-link btn-link-rigth" ng-click=loginCtrl.recuperarSenha() translate=@APP-LOGIN-EMAIL-TAB-LOGIN-SECTION-ENTRAR-RECUPERAR-SENHA></button></div></div><div class=form-group ng-if="loginCtrl.cpfCnpj == \'cpf\' || loginCtrl.cpfCnpj == \'cnpj\'"><label for=senha class=inputs translate=@APP-LOGIN-INPUT-CODIGO-IMOVEL data-required=true></label><input type=tel class=form-control id=seuCodigo placeholder="{{\'@APP-COMMON-PLACEHOLDER-CODIGO-IMOVEL\' | translate}}" ng-model=loginCtrl.instalacao only-numbers cpfl-highlight-input required autocomplete=off><div style="position:relative initial"><div vc-recaptcha on-create=loginCtrl.setCaptchaWidgetId(widgetId) on-success=loginCtrl.setCaptchaResponse(response)></div></div><div class=buttons><button id=encontrarInstalacao type=button class="btn btn-link btn-link-rigth" ng-click=loginCtrl.encontrarInstalacao() translate=@APP-LOGIN-LINK-ENCONTRAR-INSTALACAO></button></div></div></div><div class=col-xs-24 style=margin-top:0.9em><div class=buttons><button valeutype=submit class="btn btn-default btn-lg btn-block" ng-click="loginCtrl.cpfCnpj == \'email\' ? loginCtrl.loginEmail(loginInstalacaoForm) : loginCtrl.loginInstalacao(loginInstalacaoForm)" translate=@APP-LOGIN-BTN-ENTRAR></button></div></div></div></form><div class=row><div class="col-xs-24 col-md-12"><button class="btn btn-facebook-2 btn-lg btn-block" ng-click=loginCtrl.loginFacebook()><div class="row np"><div class="col-xs-4 col-xs-offset-2 np"><i class="fa fa-2x fa-facebook-official" aria-hidden=true style=margin-left:-0.4em></i></div><div class="col-xs-18 col-md-16 np"><span translate=@APP-LOGIN-BTN-FACEBOOK style=left:1%></span></div></div></button></div><div class="col-xs-24 col-md-12"><button class="btn btn-google-gray btn-lg btn-block" ng-click=loginCtrl.loginGoogle()><div class="row np"><div class="col-xs-4 col-xs-offset-2 np"><img style="width:30px; height:30px; margin-left:-0.4em" src=assets/images/ico/google-favicon.png></div><div class="col-xs-18 col-md-16 np"><span translate=@APP-LOGIN-BTN-GOOGLE style=left:3%></span></div></div></button></div></div></div></div><div id=linhaVertical><div class="col-xs-24 col-md-2"><div class="loginArea nb np"><div class="lineOu text-center"><span class="topo hidden-xs hidden-sm"></span> <span class="hidden-md hidden-lg">ou</span> <span class="bottom hidden-xs hidden-sm"></span></div></div></div></div><div class="col-xs-24 col-md-11" id=loginRedesSociais><div class=loginArea><h2 translate=@APP-LOGIN-NAO-SOU-CADASTRADO-TITULO></h2><p translate=@APP-LOGIN-NAO-SOU-CADASTRADO-MENSAGEM-CURTA></p><div class="buttons btn-rede-sociais" style=margin-top:-0.5em><div class=row><div class="col-xs-24 col-sm-24 col-md-24"><button class="btn btn-default btn-lg btn-block" ng-click=loginCtrl.cadastrar() translate=@APP-LOGIN-BTN-CADASTRO></button></div><div class="col-xs-24 col-sm-24 col-md-24 col-sm-24 col-xs-24"><div class="btn btn-via-pagamento btn-lg btn-block tooltip-alter" ng-click=loginCtrl.viaPagamento() style="height:150px; font-size:25px; align-content:center; white-space: normal"><span translate=@APP-LOGIN-BTN-VIA-PAGAMENTO-CHAMATIVO style=left:-3%></span><div class=top style="color:white; width:350px"><h2 style=color:white translate=@APP-LOGIN-VIA-SIMPLIFICADA-TOOLTIP></h2></div></div></div></div></div><p style=font-size:0.9em translate=@APP-LOGIN-LINK-NAO-CLIENTE></p></div></div></div></div></div></div></div>')};a.$inject=["$templateCache"];if(angular.element(document.body).injector()){var b=angular.element(document.body).injector().get("$templateCache");a(b)}angular.module("cpflAgenciavirtualWeb.login").run(a)})();