ired=true></label><input type=email class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.email maxlength=50 cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-24"><div class=form-group><label for=email class=inputs translate=@APP-LOGIN-CADASTRAR-CNPJ-INPUT-CONFIRMAR-EMAIL data-required=true></label><input type=email class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.confirmaemail maxlength=50 cpfl-highlight-input required acn-confirmation-validator=vm.email></div></div><div class="col-xs-24 col-md-24"><div class=form-group><label for=cpf class=inputs translate=@APP-LOGIN-CADASTRAR-SECTION-DADOS-ACESSO-INPUT-CPF data-required=true></label><input id=cpf class=form-control type=tel placeholder="{{\'@APP-COMMON-PLACEHOLDER-CPF\' | translate}}" ng-model=vm.cpf ng-cpf custom-cpf-mask autocomplete=off cpfl-highlight-input required></div></div></div><div><div class=row><div class=col-xs-12></div><div class=col-xs-12><button type=submit class="btn btn-default btn-lg btn-block hand" name=dados ng-click=vm.enviarPermissao(form) translate=@APP-LOGIN-CONFIGURAR-CONTA-TITLE-GESTAO-CONTA-ACESSO-CNPJ-ENVIAR-PERMISSAO></button></div></div></div></div><div class=col-xs-12 ng-if=vm.tableParams><table class=table ng-table=vm.tableParams><thead><tr><th>E-mail do usuário</th><th>Nome do usuário</th><th></th></tr></thead><tbody><tr ng-repeat="instalacao in $data"><td ng-bind=instalacao.UsuarioEmail style=color:darkblue></td><td ng-bind=instalacao.UsuarioNome></td><td><button class="btn btn-default btn-remover" ng-click=vm.removerPermissao(instalacao)><span class="fa fa-times"></span></button></td></tr></tbody></table></div></div></form></div></div></div>');a.put("modules/login/views/login-configurar-conta.html",'<div class=login><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li class=active translate=@APP-COMMON-BREADCRUMB-LOGIN-CONFIGURAR-CONTA-ACESSO></li></ol></div></div><div class=row><div class=col-xs-24><h1 translate=@APP-LOGIN-CONFIGURAR-ADICIONAR-INSTALACAO-TITLE></h1></div></div><div class=row><div class=col-xs-24><alert></alert></div></div><div class=row><div class=col-xs-24><form name=formLoginConfigurarConta novalidate><section id=dadosInstalacoes><div class=row><div class=col-xs-24><h2>Instalações Disponíveis</h2></div><div class=col-xs-24><table ng-table=loginConfigurarContaCtrl.tableParams class="table table-condensed hidden-xs hidden-sm"><tbody><tr ng-repeat="instalacao in $data"><td title="\'Instalação\'" ng-bind=instalacao.InstalacaoReal class=hidden-xs></td><td title="\'Endereço\'" ng-bind=instalacao.EnderecoCompleto></td></tr></tbody></table></div></div></section><section id=botoes><div class=row><div class=buttons><div class="col-xs-24 col-md-12"><button class="btn btn-default btn-lg btn-block" ng-click=loginConfigurarContaCtrl.descadastrarUsuario()>Remover Conta de Acesso</button></div><div ng-if="loginConfigurarContaCtrl.provider != \'Google\' && loginConfigurarContaCtrl.provider != \'Facebook\'"><div class="col-xs-24 col-md-12"><button class="btn btn-default btn-lg btn-block" ui-sref=app.login.alterarSenha>Alterar Senha</button></div></div></div></div></section></form></div></div></div>');a.put("modules/login/views/login-configurar-envio-documento.html","<div class=login><div class=row><div class=col-xs-24><ol class=breadcrumb><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-HOME></a></li><li><a ui-sref=app.home translate=@APP-COMMON-BREADCRUMB-LOGIN></a></li><li class=active translate=@APP-COMMON-BREADCRUMB-LOGIN-ATIVAR></li></ol></div></div><div class=row><div class=col-xs-24><h2 translate=@APP-LOGIN-RESULTADO-ATIVAR-TITLE></h2></div></div><div class=row><div class=col-xs-24><alert></alert></div></div><div class=row><div class=col-xs-24><div class=obrigadoCadastro><h2 translate=@APP-LOGIN-RESULTADO-CADASTRAR-SUBTI