</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-LOGIN-CADASTRAR-TITLE></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-ERRO-MENSAGEM></p></div></div><div class=row><div class=col-xs-24><button id=btnInstrucoesCodigo type=button class="btn btn-link" ng-click="vm.redirect(\'atualizarCadastro\')" translate=@APP-MODAL-LOGIN-ERRO-LINK-TENHO-CONTA-DIGITAL></button></div><div class=col-xs-24><button id=btnInstrucoesCodigo type=button class="btn btn-link" ng-click="vm.redirect(\'esqueciSenha\')" translate=@APP-MODAL-LOGIN-ERRO-LINK-ESQUECI-MINHA-SENHA></button></div><div class=col-xs-24><button id=btnInstrucoesCodigo type=button class="btn btn-link" ng-click="vm.redirect(\'novoCadastro\')" translate=@APP-MODAL-LOGIN-ERRO-LINK-NOVO-CADASTRO></button></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-12"><button class="btn btn-default btn-lg btn-block" id=btnConfirm ng-click=vm.iniciarChat() translate=@APP-MODAL-LOGIN-ERRO-BTN-INICIAR-CHAT></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=vm.voltar() translate=@APP-MODAL-LOGIN-ERRO-BTN-VOLTAR></button></div></div></div></div>');a.put("modules/login/templates/modal-login-orientacoes-cnpj-individual.html",'<div class=cpfl-style><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-INDIVIDUAL-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-LOGIN-ORIENTACOES-CNPJ-INDIVIDUAL-MENSAGEM></p></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12 col-md-offset-6"><button id=btnOK type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.entender() translate