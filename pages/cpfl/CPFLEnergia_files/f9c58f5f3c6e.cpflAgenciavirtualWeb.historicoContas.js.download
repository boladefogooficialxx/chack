text size=50 class="bpmpi_billTo_state ng-hide" ng-model=vm.cielo3dsInfo.BillToState> <input type=text size=50 class="bpmpi_billto_zipcode ng-hide" ng-model=vm.cielo3dsInfo.BilltoZipcode> <input type=text size=50 class="bpmpi_billto_country ng-hide" ng-model=vm.cielo3dsInfo.BilltoCountry><section id=dadosCartaoCredito><div class=row ng-if=!vm.isParcelamento><div class=col-xs-24><span translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-MENSAGEM></span></div></div><div class=row><div class=col-xs-24 ng-if=vm.isParcelamento><label translate=APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-VALOR-TOTAL></label><p ng-bind=vm.labelTotalParcelamento></p></div><div class=col-xs-24 style=margin-top:1em ng-if=!vm.isParcelamento><label translate=APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-VALOR-TOTAL-A-VISTA></label><p ng-bind=vm.labelTotalParcelamento></p></div></div><div class=row><div class=col-xs-24 id=simulacaoParcelamento><h2 ng-if=!vm.auxilioEmergencial translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-TITULO></h2><h2 ng-if=vm.auxilioEmergencial translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-DEBITO-TITULO></h2></div></div><div class=row><div class="col-xs-24 col-md-12"><img ng-if=!vm.auxilioEmergencial style=width:30%;margin-bottom:1em src=assets/images/logos/cartao_visa_master.png> <img ng-if=vm.auxilioEmergencial style=width:30%;margin-bottom:1em src=assets/images/logos/bandeira-elo.png></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label for=cardnumber class=inputs translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-INPUT-NUMERO-CARTAO data-required=true></label><input type=tel class="form-control bp-sop-cardnumber bpmpi_cardnumber" placeholder="{{\'@APP-COMMON-PLACEHOLDER-CARTAO-CREDITO\' | translate}}" ng-model=vm.numero ng-blur=vm.verificaBandeiraCartao(vm.numero) cpfl-highlight-input maxlength=16 required></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=cardholdername class=inputs translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-INPUT-NOME-CARTAO data-required=true></label><input class="form-control bp-sop-cardholdername" type=text ng-model=vm.nomeImpresso maxlength=25 cpfl-highlight-input required only-letters ng-blur=vm.removeAcentuacao(vm.nomeImpresso)></div></div></div><div class=row><div class="col-xs-24 col-md-6"><div class=form-group><label for=cardexpirationdate class=inputs translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-INPUT-VALIDADE-CARTAO data-required=true></label><input class="form-control bp-sop-cardexpirationdate" type=text placeholder="{{\'@APP-COMMON-PLACEHOLDER-DATA-VALIDADE-CARTAO\' | translate}}" ng-model=vm.documento ng-blur=vm.separarValidadeCartao(vm.documento) maxlength=7 ui-mask=99/9999 ui-mask-placeholder cpfl-highlight-input required></div></div><div class="col-xs-24 col-md-6"><div class=form-group><label for=cardcvvc class=inputs translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-INPUT-CODIGO-SEGURANCA-CARTAO data-required=true></label><input class="form-control bp-sop-cardcvv" type=text placeholder="{{\'@APP-COMMON-PLACEHOLDER-CODIGO-SEGURANCA\' | translate}}" ng-model=vm.codigoSeguranca maxlength=3 cpfl-highlight-input required only-numbers></div></div></div></section><section id=botoes><div class=row><div class=buttons><div class="col-xs-24 col-md-8 col-md-push-16"><button data-btn-pagar class="btn btn-default btn-lg btn-block" ng-click=vm.pagar(formPagamentoCartaoCredito) translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-BTN-PAGAR></button></div><div class="col-xs-24 col-md-8"><button id=btnFechar type=button class="btn btn-secondary btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-BTN-VOLTAR ng-click=vm.voltar()></button></div></div></div></section><section id=mensagem_parcelamento><div class=row><div class=col-xs-24 id=texto_parcelamento><h2 translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-TEXTO></h2></div></div></section></form></div></div></div>');a.put("modules/historico-contas/views/historico-contas-parcelar-debitos-entrada.html",'<div class=historico-contas-parcelar-debitos><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO></cabecalho-pagina><section id=debitosPendentes class=historicoContas ng-if=vm.tabelaDebitosAbertosParams><div class="panel panel-default"><div class=panelHistoricoContasHeader><div class=panel-heading><span translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-ENTRADA-TITULO class=historicoContasTitulo style=font-size:0.9em></span> <span translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-ENTRADA-TITULO-VALOR-ENTRADA class=historicoContasTitulo style="text-align: center !important;font-size:0.75em"></span> <span ng-bind=vm.valorEntrada class=historicoContasValor style="text-align: center !important;font-size:1.5em"></span></div></div><div class=panel-body><table ng-table=vm.tabelaDebitosAbertosParams class="table tabela-debitos-desktop"><thead><tr></tr><tr><th></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-DESCRICAO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VALOR></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VENCIMENTO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VISUALIZAR></th></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td><div class=form-group><div class="checkbox checkbox-table"><input type=checkbox id=debitoSelecionado_{{$index}} ng-model=registro.Selecionado><label for=debitoSelecionado_{{$index}}></label></div></div></td><td ng-bind=registro.MesReferencia></td><td ng-bind=registro.DescricaoFatura></td><td ng-bind="registro.Valor | currency"></td><td ng-bind="registro.Vencimento | date:\'dd/MM/yyyy\'"></td><td class=valign-middle><button class="btn btn-default btn-segunda-via-aberta" ng-click=vm.imprimirBoleto(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA></button></td></tr></tbody></table></div></div><div class=row><div class=buttons><div class="col-xs-24 col-md-8 col-md-push-16"><button data-btn-pagar class="btn btn-default btn-lg btn-block" ng-click=vm.avancar() translate=@APP-HISTORICO-CONTA-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-BTN-AVANCAR></button></div><div class="col-xs-24 col-md-8"><button id=btnFechar type=button class="btn btn-secondary btn-lg btn-block hand" translate=@APP-HISTORICO-CONTA-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-BTN-VOLTAR ui-sref=app.historico-contas></button></div></div></div></section></div>');a.put("modules/historico-contas/views/historico-contas-parcelar-debitos-envio-comprovante-pagamento.html","<style>.cpfl-style .loader {\r"+"\n"+"  width: 2.5em !important;\r"+"\n"+"  height: 2.5em !important;\r"+"\n"+"  margin-right: 2.2em;\r"+"\n"+"  border: 4px solid #d8d8e0;\r"+"\n"+"  border-top: 4px solid #006699;\r"+"\n"+"  border-radius: 50%;\r"+"\n"+"  float: left;\r"+"\n"+"  margin-left: calc(25% - 2.25em);\r"+"\n"+"  -webkit-animation: rotate 1.75s 0s linear infinite;\r"+"\n"+"  animation: rotate 1.75s 0s linear infinite;\r"+"\n"+'}</style><div class=historico-contas-parcelar-debitos><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO></cabecalho-pagina><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24><h2 translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-ENVIO-COMPROVANTE-PAGAMENTO-TITULO></h2></div></div><div class=row><div class=col-xs-24><div class=form-group><table ng-table=vm.tabelaDebitosAbertosParams class="table tabela-debitos-desktop"><thead><tr><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-DESCRICAO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VALOR></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VENCIMENTO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VISUALIZAR></th></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td ng-bind=registro.MesReferencia></td><td ng-bind=registro.DescricaoFatura></td><td ng-bind="registro.Valor | currency"></td><td ng-bind="registro.Vencimento | date:\'dd/MM/yyyy\'"></td><td class=valign-middle><div class=loader ng-hide=!registro.isUploading></div><button type=button ngf-select="vm.adicionarArquivo($file, registro)" ngf-resize-if="$width > 1024 || $height > 768" ngf-resize="{width: 1024, height: 768}" ng-if="!registro.ArquivoCarregado && !registro.isUploading" class="btn btn-default btn-secondary"><span class="glyphicon glyphicon-open"></span></button> <button type=button ng-if="registro.ArquivoCarregado && !registro.isUploading" class="btn btn-default btn-secondary upload-box-file-uploaded-button" ng-click=vm.removerArquivo(registro)><i class="fa fa-trash hand upload-box-file-uploaded-icon" aria-hidden=true></i></button></td></tr></tbody></table></div></div></div><div class=row><div class=buttons><div class="col-xs-24 col-md-8 col-md-push-16"><button ng-disabled=!vm.podeAvancarTelaUpload data-btn-pagar class="btn btn-default btn-lg btn-block" ng-click=vm.avancar() translate=@APP-HISTORICO-CONTA-PARCELAR-DEBITOS-DADOS-CARTAO-CREDITO-BTN-AVANCAR></button></div><div class="col-xs-24 col-md-8"><button id=btnFechar type=button class="btn btn-secondary btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-ENVIO-COMPROVANTE-PAGAMENTO-BTN-ENVIAR-DEPOIS ng-click=vm.apresentarDepois()></button></div></div></div></div></div></div>');a.put("modules/historico-contas/views/historico-contas-parcelar-debitos-envio-documentos.html",'<div class=historico-contas-parcelar-debitos><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO></cabecalho-pagina><form name=formEnvioDocumentosCredenciados novalidate><div class=row><div class=col-xs-24><h1 translate=@APP-CREDENCIADOS-MENU-ENVIO-DOCUMENTOS></h1><section id=dadosCartaoCredito><doc-upload tipo-envio={{vm.tipoEnvioDocumento}} tipo-envio-documentos=vm.tipoEnvioDocumento upload-guid={{vm.guid}} is-form-submitted=formEnvioDocumentosCredenciados.$submitted doc-upload-webcam=true></doc-upload></section><section id=botoes><div class=row><div class=buttons><div class="col-xs-24 col-md-8 col-md-push-16"><button data-btn-pagar class="btn btn-default btn-lg btn-block" ng-click=vm.solicitar(formEnvioDocumentosCredenciados) translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TERMO-ACEITE-BTN-SOLICITAR></button></div></div></div></section></div></div></form></div>');a.put("modules/historico-contas/views/historico-contas-parcelar-debitos-pagamento-processamento.html","<style>#menu-header {\r"+"\n"+"        display:none;\r"+"\n"+"    }\r"+"\n"+"    #menu-footer {\r"+"\n"+"        display:none;\r"+"\n"+"    }</style><div class=historico-contas-parcelar-debitos-dados-cartao-credito><div class=row><div class=col-xs-24><h2 translate=@APP-HISTORICO-CONTA-PARCELAR-DEBITOS-PAGAMENTO-EM-PROCESSAMENTO></h2></div></div></div>");a.put("modules/historico-contas/views/historico-contas-parcelar-debitos-resultado.html",'<div class=resultadoServico><div id=divBreadcrumb class=row><div class=col-xs-24><ol class=breadcrumb><li></li><li><a class=active ui-sref=app.home>Home</a></li></ol></div></div><div class=resultadoDadosImpressao><h1 translate={{vm.resultado.servico}}></h1><alert target=historico-contas-parcelar-debitos-resultado></alert><div class=row><div class=col-xs-24><h2 translate={{vm.resultado.titulo}}></h2></div></div><div class=row><div class=col-xs-24><span id=textoMensagem translate={{vm.resultado.mensagem}} translate-values={{vm.resultado.parametros}} translate-compile></span></div></div><div ng-if=vm.resultado.protocolo><div class=row><div class=col-xs-24><div id=protocoloAtendimento><h2 translate=@APP-RESULTADO-PROTOCOLO-DE-ATENDIMENTO></h2><p ng-bind=vm.resultado.protocolo></p></div></div></div></div><div ng-if=vm.data><div class=row><div class=col-xs-24><div id=dataSolicitacao><h2 translate=@APP-DATA-LEITURA-DATA-SOLICITACAO></h2><p ng-bind=vm.data></p></div></div></div></div></div><div id=botoes><div class=row><div class=buttons><div ng-if=vm.resultado.protocolo><div class="col-xs-24 col-md-8"><button id=btnBaixarPdf class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-BAIXAR-PDF ng-click=vm.baixarPDF();></button></div></div><div ng-if=!vm.resultado.protocolo><div class="col-xs-24 col-md-8 col-pull-md-16"><button id=btnOK class="btn btn-default btn-lg btn-block" translate=@APP-RESULTADO-BTN-OK ui-sref=app.home></button></div></div></div></div></div><div id=listaCredenciados ng-if=vm.resultado.agenciasCredenciados><agencias-credenciados agencias-credenciados=resultado.resultado.agenciasCredenciados></agencias-credenciados></div></div>');a.put("modules/historico-contas/views/historico-contas-parcelar-debitos.html",'<div class=historico-contas-parcelar-debitos><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO></cabecalho-pagina><style>#divContrato div table {\r'+"\n"+"            min-width: 315px;\r"+"\n"+"            margin: 0 auto;\r"+"\n"+'        }</style><form name=vm.form novalidate ng-if=vm.situacao><section id=homeParcelamento ng-if=!vm.termoAceite><div class=row><div class=col-xs-24><h2 ng-if="vm.tipoParcelamento == 1" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SUB-TITULO-BOLETO></h2><h2 ng-if="vm.tipoParcelamento == 2" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SUB-TITULO-CARTAO></h2></div></div><div class=row><div class=col-xs-24 ng-if=vm.isRGE><div uib-alert class="alert alert-info" id=alertaRGE><div class="alert-icon info-icon"></div><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-ATENCAO-RGE class=alert-message></span></div></div><div class=col-xs-24><span ng-if="vm.tipoParcelamento == 1" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-ATENCAO-ESCOLHA-DATA-PARCELAS></span><br><br></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-DATA-INICIO></label><input type=text class=form-control datepicker placeholder="{{\'@APP-HISTORICO-CONTAS-PARCELAMENTO-PLACEHOLDERE-PARCELAS\' | translate}}" id=dataInicial01 change=true onfocus=blur(); readonly ng-model=vm.parcelamento.DataPrimeiraParcela ng-if="vm.situacao && (vm.tipoParcelamento == 1 || vm.tipoParcelamento == 3|| vm.tipoParcelamento == 6)" ng-change=vm.selecionarData() min-date=vm.situacao.DataInicial max-date=vm.situacao.DataFinal> <input type=text class=form-control placeholder="{{\'@APP-HISTORICO-CONTAS-PARCELAMENTO-PLACEHOLDERE-PARCELAS\' | translate}}" id=dataInicial01 readonly ng-model=vm.situacao.DataInicioPagamento ng-if="vm.situacao && vm.tipoParcelamento == 2"></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label class=inputs translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-NUM-PARCELAS></label><ui-select ng-model=vm.parcelamento.NumeroParcelas theme=selectize ng-change=vm.selecionarNumParcelas() name=numParcelas id=numParcelas ng-disabled=vm.naoHabilitarParcela><ui-select-match placeholder="{{\'@APP-HISTORICO-CONTAS-PARCELAMENTO-PLACEHOLDER-SELECIONE-PARCELAS\' | translate}}"><span ng-bind=$select.selected></span></ui-select-match><ui-select-choices repeat="parcela in vm.situacao.Parcelas | filter: $select.search"><span ng-bind=parcela></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select></div></div></div><div class=row ng-if=vm.showAlertaValorMinimoDebitos><div class=col-xs-24><div uib-alert class="alert alert-warning"><div class="alert-icon warning-icon"></div><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-MSG-VALOR-MIN-DEBITOS-TITULO class=alert-message></span><div class=form-group><div class="checkbox checkbox-warning"><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-MSG-VALOR-MIN-DEBITOS translate-values="{valorMinimo: \'{{vm.valorMinimoLabel}}\'}"></span></div></div></div></div></div><div class=row ng-if=vm.showAlertaParcelarTodosDebitos><div class=col-xs-24><div uib-alert class="alert alert-warning"><div class="alert-icon warning-icon"></div><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-MSG-INSTALACAO-PARCELAR-TODOS-DEBITOS-TITULO class=alert-message></span><div class=form-group><div class="checkbox checkbox-warning"><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-MSG-INSTALACAO-PARCELAR-TODOS-DEBITOS translate-values="{valorMinimo: \'{{vm.valorMinimoLabel}}\'}"></span></div></div></div></div></div><section id=debitosPendentes class=historicoContas ng-if=vm.tabelaDebitosAbertosParams><div class="panel panel-default"><div class=panelHistoricoContasHeader><div class=panel-heading><span ng-bind="vm.situacao.Total | currency" class=historicoContasValor></span> <span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-TITULO class=historicoContasTitulo></span></div></div><div class=panel-body><table ng-table=vm.tabelaDebitosAbertosParams class="table tabela-debitos-desktop"><thead><tr><th class=debitos-header><div class=form-group><div class="checkbox checkbox-table"><input type=checkbox id=selecionarTodosDebitos ng-model=vm.todosDebitosSelecionados ng-click=vm.selecionarTodosDebitos()><label for=selecionarTodosDebitos class=debito-label></label></div></div></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-NUM-CONTA></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-DESCRICAO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VENCIMENTO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VALOR></th></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td><div class=form-group><div class="checkbox checkbox-table"><input type=checkbox id=debitoSelecionado_{{$index}} ng-model=registro.Selecionado ng-click=vm.selecionarDebito(registro)><label for=debitoSelecionado_{{$index}}></label></div></div></td><td ng-bind=registro.NumContaEnergia></td><td ng-bind=registro.DescricaoFatura></td><td ng-bind=registro.MesRef></td><td ng-bind=registro.Vencimento></td><td ng-bind="registro.Valor | currency"></td></tr></tbody></table><table ng-table=vm.tabelaDebitosAbertosParams class="table tabela-debitos-mobile"><thead><tr><th style="padding-left: 4px"><div class=form-group><div class="checkbox checkbox-table"><input type=checkbox id=Checkbox2 ng-model=vm.todosDebitosSelecionados ng-click=vm.selecionarTodosDebitos()><label for=selecionarTodosDebitos style="font-size: 16px;padding-left: 0px"></label></div></div></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-TITULO-MOBILE></th></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td style="vertical-align: inherit"><div class=form-group><div class="checkbox checkbox-table"><input type=checkbox id=Checkbox1 ng-model=registro.Selecionado ng-click=vm.selecionarDebito(registro)><label for=debitoSelecionado_{{$index}}></label></div></div></td><td><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-DESCRICAO-MOBILE style=font-size:13px></span>: <span ng-bind=registro.DescricaoFatura></span><br><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-MES-REF style=font-size:13px></span>: <span ng-bind=registro.MesRef></span><br><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VENCIMENTO style=font-size:13px></span>: <span ng-bind="registro.Vencimento | date:\'dd/MM/yyyy\'"></span><br><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TBL-HEADER-VALOR style=font-size:13px></span>: <span ng-bind="registro.Valor | currency"></span><br></td></tr></tbody></table></div></div></section><section id=tabelaParcelamento class=historicoContas ng-if=vm.tabelaParcelamento><div class=row><div class=col-xs-24 id=simulacaoParcelamento><h2 translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TITULO></h2></div></div><div class=row><div class=col-xs-24><span ng-if="vm.tipoParcelamento == 1" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-DESCRICAO-BOLETO></span> <span ng-if="vm.tipoParcelamento == 2" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-DESCRICAO-CARTAO></span> <span ng-if="vm.tipoParcelamento == 6" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-DESCRICAO-DENTRO-FATURA></span><br><br></div></div><div class=row><div class=col-xs-24><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-DETERMINACAO-ANEEL-IGPM-IPCA></span><br><br></div></div><div class="panel panel-default"><div class=panelHistoricoContasHeader><div class=panel-heading><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TITULO class=historicoContasTitulo></span></div></div><div class=panel-body><table ng-table=vm.tabelaParcelamento class=table><thead><tr><th ng-if="vm.tipoParcelamento != 6" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-HEADER-PARCELA></th><th ng-if="vm.tipoParcelamento == 6" style=width:50% translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-HEADER-PARCELA></th><th ng-if="vm.tipoParcelamento != 6" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-HEADER-VENCIMENTO></th><th translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-HEADER-VALOR></th></tr></thead><tbody><tr ng-repeat="parcela in $data track by $index"><td ng-bind=parcela.NumDaParcela></td><td ng-if="vm.tipoParcelamento != 6" ng-bind="parcela.Vencimento | date:\'dd/MM/yyyy\'"></td><td ng-bind="parcela.Valor | currency"></td></tr></tbody></table></div></div><div class=row><div class="col-xs-12 col-md-12"><div class=form-group><label translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TOTAL-JUROS translate-values="{ TotalJuros : \'{{vm.simulacao.JurosFinanciamento}}\'}" class=inputs></label><p class=texto-descricao-padrao ng-bind="vm.simulacao.TotalJuros | currency"></p></div></div><div class="col-xs-12 col-md-12"><div class=form-group><label translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TOTAL-TAXA translate-values="{ TotalTaxa : \'{{vm.simulacao.TaxaFinanciamento}}\'}" class=inputs></label><p class=texto-descricao-padrao ng-bind="vm.simulacao.TotalTaxas | currency"></p></div></div><div class="col-xs-12 col-md-12"><div class=form-group><label translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TOTAL-MULTA translate-values="{ TotalMulta : \'{{vm.simulacao.MultaFinanciamento}}\'}" class=inputs></label><p class=texto-descricao-padrao ng-bind="vm.simulacao.TotalMulta | currency"></p></div></div><div class="col-xs-12 col-md-12"><div class=form-group><label translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TOTAL-FATURAS class=inputs></label><p class=texto-descricao-padrao ng-bind="vm.simulacao.TotalFaturas | currency"></p></div></div><div class="col-xs-12 col-md-12"><div class=form-group><label translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-ATUALIZACAO-MONET class=inputs></label><p class=texto-descricao-padrao ng-bind="vm.simulacao.TotalCorMonetaria | currency"></p></div></div><div class="col-xs-12 col-md-12"><div class=form-group><label translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SIMULACAO-TBL-TOTAL-GERAL class=inputs></label><p class=texto-descricao-padrao ng-bind="vm.simulacao.TotalParcelamento | currency"></p></div></div></div><div id=dadosContato><div class=row><div class=col-xs-24><h2 translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-SOLICITANTE></h2></div></div><div class=row><div class="col-xs-24 col-md-12"><div class=form-group><label for=email translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-LABEL-EMAIL class=inputs data-required=true></label><input type=email class=form-control name=email id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.parcelamento.Solicitante.Email ng-class="{invalid: form.email.$invalid && form.email.$dirty}" ng-required=true cpfl-highlight-input></div></div><div class="col-xs-24 col-md-12"><div class=form-group><label for=telefone translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-LABEL-TELEFONE class=inputs data-required=true></label><input ng-model=vm.parcelamento.Solicitante.Telefone ng-class="{invalid: form.telefone.$invalid && form.telefone.$dirty}" type=tel required class=form-control name=telefone id=telefone placeholder="{{\'@APP-COMMON-PLACEHOLDER-TELEFONE\' | translate}}" ng-attr-ui-mask="{{vm.telefone && vm.returnOnlyNumber(vm.telefone).length > 10 ? \'(99) 99999-999?9\' : \'(99) 9999-9999?9\'}}" ui-mask-placeholder ui-mask-placeholder-char=space cpfl-highlight-input></div></div></div></div><div class=row><div class="col-xs-24 col-md-8 col-md-push-16"><button type=submit id=btnRecuperarTermoAceite ng-click=vm.recuperarTermoAceite(vm.form) class="btn btn-default btn-lg btn-block" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-RECUPERAR-TERMO-ACEITE></button></div></div></section></section><section id=termoAceite ng-if=vm.termoAceite><div class=row><div class=col-xs-24><h2 translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TERMO-ACEITE-TITULO-SECTION></h2></div></div><contrato-termos-aceite html-conteudo-contrato={{vm.termoAceite.TCD}} is-parcelamento=true></contrato-termos-aceite><div class=row><div class=col-xs-24><div uib-alert class="alert alert-warning"><div class="alert-icon warning-icon"></div><span translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TERMO-ACEITE-ATENCAO class=alert-message></span><p translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TERMO-ACEITE-ATENCAO-2></p><div class=form-group><div class="checkbox checkbox-warning"><input type=checkbox id=aceiteTermoServico value=true ng-model=vm.parcelamento.AceiteTermoServico><label for=aceiteTermoServico translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TERMO-ACEITE-ATENCAO-DECLARACAO></label></div></div></div></div></div><div class=row><div class="col-xs-24 col-md-8 col-md-push-16"><button type=submit id=btnSolicitar ng-click=vm.solicitar(vm.form) class="btn btn-default btn-lg btn-block" ng-if="vm.tipoParcelamento == 1 || vm.tipoParcelamento == 6" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-TERMO-ACEITE-BTN-SOLICITAR></button> <button type=submit id=btnSolicitar ng-click=vm.solicitar(vm.form) class="btn btn-default btn-lg btn-block" ng-if="vm.tipoParcelamento == 2 || vm.tipoParcelamento == 3" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-RECUPERAR-TERMO-ACEITE></button></div><div class="col-xs-24 col-md-8" ng-if="vm.isCredenciado && vm.tipoParcelamento != 6"><button type=submit ng-click=vm.imprimirTCDCredenciado() class="btn btn-default btn-lg btn-block" translate=@APP-HISTORICO-CONTAS-PARCELAMENTO-BAIXAR-TCD></button></div></div></section></form></div>');
a.put("modules/historico-contas/views/historico-contas.html",'<div class=historico-contas><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-TITULO sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2="" titulo-breadcrumb2=@APP-HISTORICO-CONTAS-TITULO></cabecalho-pagina><div class=row><div class=col-xs-24><section id=info-protocolo ng-if=vm.protocolo><div class=protocolo><div class=protocolo-primary><span translate=@APP-HISTORICO-CONTAS-PROTOCOLO></span> <span class=numero-protocolo ng-bind=vm.protocolo></span></div></div></section></div></div><div class=row ng-if=vm.possuiDebitosEmAberto><div class=col-xs-24><div ng-if=vm.possuiDebitoAutomatico class="alert alert-info" role=alert><div class="alert-icon info-icon"></div><span translate=@APP-HISTORICO-CONTAS-MSG-DEBITO-AUTOMATICO class=alert-message></span></div></div></div><div ng-if=vm.situacao><div class=row><div class=col-xs-24><section id=debitosPendentes class=historicoContas><div class=panel-group><div class="panel panel-default" ng-init="status = {isOpen: true}" is-open=status.isOpen><div class=panelHistoricoContasHeader><table width=100%><tr><td data-toggle=collapse data-target=#minhasContas ng-init="vm.accordion_2 = false" ng-click="vm.accordion_2 = !vm.accordion_2" data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-TITULO-INSTALACAO class=tituloEnderecoContas translate-values="{instalacao: vm.instalacao.InstalacaoReal}"></span></td></tr><tr><td data-toggle=collapse data-target=#minhasContas ng-init="vm.accordion_2 = false" ng-click="vm.accordion_2 = !vm.accordion_2" data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-TITULO-ENDERECO class=tituloEnderecoContas></span></td></tr><tr><td data-toggle=collapse data-target=#minhasContas ng-init="vm.accordion_2 = false" ng-click="vm.accordion_2 = !vm.accordion_2" data-parent=#accordion><span class=enderecoContas>{{vm.Endereco}}</span></td></tr><tr><td><div class=panel-heading ng-if=!vm.possuiDebitosEmAberto data-toggle=collapse data-target=#minhasContas ng-init="vm.accordion_2 = false" ng-click="vm.accordion_2 = !vm.accordion_2" data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-SEM-CONTAS-EM-ABERTO class=historicoContasTitulo style="text-align: center !important"></span> <i id=iconeMinhasContas class="iconeMinhasContasPagas pull-right fa" ng-class="{\'fa-plus\': vm.accordion_2, \'fa-minus\': !vm.accordion_2}"></i></div><div class=panel-heading ng-if=vm.possuiDebitosEmAberto data-toggle=collapse data-target=#minhasContas ng-init="vm.accordion_2 = false" ng-click="vm.accordion_2 = !vm.accordion_2" data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-TITULO class=historicoContasTitulo style="text-align: center !important"></span> <span ng-bind="vm.valorDebitos | currency" class=historicoContasValor style="text-align: center !important"></span> <i id=iconeMinhasContas class="iconeMinhasContasPagas pull-right fa" ng-class="{\'fa-plus\': vm.accordion_2, \'fa-minus\': !vm.accordion_2}"></i></div></td></tr></table></div><div id=minhasContas class="panel-collapse collapse in"><div class=panel-body ng-if=vm.possuiDebitosEmAberto><table ng-table=vm.tableDebitosAbertosParams class="table hidden-xs"><thead><tr><th><div class=form-group style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important; margin-left:20px"><input type=checkbox id=chkSelTodos{{vm.instalacao.Instalacao}} ng-model=vm.IsAllChecked[vm.instalacao.Instalacao] ng-change=vm.CheckUncheckAll(vm.instalacao.Instalacao)><label for=chkSelTodos{{vm.instalacao.Instalacao}}></label></div></div></th><th><div class=form-group style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important"><label for=chkSelTodos{{vm.instalacao.Instalacao}} style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold; margin-bottom:0px; margin-left:-30px" translate=@APP-HISTORICO-CONTAS-CHECKBOX-SELECIONAR-TODAS></label></div></div></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA></th><th ng-if=registro.ContaAcumulada></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR></th><th ng-if="registro.ContaMinima == \'CM\'"></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VENCIMENTO></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VISUALIZAR></th></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td class="text-center span-vertical"><div class=form-group style="margin:0px !important"><div class="checkbox span-vertical" style="margin-bottom:0px !important; margin-left:20px"><input type=checkbox class=marcar{{vm.instalacao.Instalacao}} id={{registro.NumeroContaEnergia}} ng-model=vm.Selected[registro.NumeroContaEnergia] ng-change="vm.CheckUncheckHeader(vm.instalacao.InstalacaoReal, registro.NumeroContaEnergia)"><label for={{registro.NumeroContaEnergia}} style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold; vertical-align:middle"></label></div></div></td><td class="text-center span-vertical"><button class="btn btn-default btn-warning btn-lg" style="vertical-align: middle" ng-click=vm.exibirModalReaviso(registro); ng-if="registro.DTLimiteReaviso != \'\'" translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-REAVISO></button></td><td ng-bind=registro.MesReferencia class="text-center span-vertical"></td><td ng-bind=registro.DescricaoFatura class="text-center span-vertical" ng-if=!registro.ContaAcumulada></td><td ng-if=registro.ContaAcumulada class="text-center span-vertical"><a class=hand ng-click=vm.exibirModalContaMinima(registro); translate=@APP-HISTORICO-CONTAS-CONTA-MINIMA></a> <i class="fa fa-info-circle hand" aria-hidden=true type=button style="font-size:1.3em; color:#069; margin-left:0.5em" ng-click=vm.exibirModalContaMinima(registro);></i></td><td ng-bind="registro.Valor | currency" ng-if="registro.ContaMinima == null || registro.ContaMinima == \'CMA\'" class="text-center span-vertical"></td><td ng-if="registro.ContaMinima == \'CM\'" class="text-center span-vertical">**********</td><td ng-bind="registro.Vencimento | date:\'dd/MM/yyyy\'" class="text-center span-vertical"></td><td class="text-center span-vertical formas-de-pagamento desktop"><div class=dropdown ng-if=!registro.OcultarformasPagamento><button class="btn btn-secondary dropdown-toggle" type=button data-toggle=dropdown>Pague sua conta<i class="fa fa-chevron-down"></i></button><ul class=dropdown-menu><li><p><i class="fa hand fa-file-text-o" aria-hidden=true type=button ng-click=vm.selecionarContaAberta(registro); ng-if=registro.showBtnSegundaVia></i> <a class="dropdown-item hand" ng-click=vm.selecionarContaAberta(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA ng-if=registro.showBtnSegundaVia></a></p></li><li><p><i class="fa hand fa-qrcode" aria-hidden=true type=button ng-click=vm.pagarFaturaPIX(registro); ng-if=registro.showBtnPix></i> <a class="dropdown-item hand" ng-click=vm.pagarFaturaPIX(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-PAGAR-PIX ng-if=registro.showBtnPix uib-tooltip="{{\'@APP-HISTORICO-CONTAS-TOOLTIP-BTN-PAGAR-PIX\' | translate}}" tooltip-trigger=hover tooltip-placement=top></a></p></li><li><p><i class="fa hand fa-credit-card-alt" aria-hidden=true type=button ng-click=vm.pagarFaturaCartaoCredito(registro); ng-if="!registro.NaoExibirBotaoCartaoCredito && !registro.FaturaVencidaParcelamento &&\r'+"\n"+"                                                            registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                            !vm.possuiDebitoAutomatico && !vm.isCredenciado"></i> <a class="dropdown-item hand" ng-click=vm.pagarFaturaCartaoCredito(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-CARTAO-CREDITO ng-if="!registro.NaoExibirBotaoCartaoCredito && !registro.FaturaVencidaParcelamento &&\r'+"\n"+"                                                            registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                            !vm.possuiDebitoAutomatico && !vm.isCredenciado" uib-tooltip="{{\'@APP-HISTORICO-CONTAS-TOOLTIP-BTN-CARTAO-CREDITO\' | translate}}" tooltip-trigger=hover tooltip-placement=top></a></p></li><li><p><i class="fa hand fa-exclamation-triangle" aria-hidden=true type=button ng-click=vm.pagarFaturaAuxilioEmergencial(registro); ng-if="registro.PermitirPagamentoAuxilioEmergencial &&\r'+"\n"+"                                                            registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                            !vm.possuiDebitoAutomatico && !vm.isCredenciado"></i> <a class="dropdown-item hand" ng-click=vm.pagarFaturaAuxilioEmergencial(registro); ng-if="registro.PermitirPagamentoAuxilioEmergencial &&\r'+"\n"+"                                                            registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                            registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                            !vm.possuiDebitoAutomatico && !vm.isCredenciado">Auxilio Emergencial</a></p></li></ul></div></td></tr></tbody></table><table ng-table=vm.tableDebitosAbertosParams class="table hidden-sm hidden-md hidden-lg" style="margin-bottom: 5px !important"><thead><tr><div class="form-group table hidden-sm hkidden-md hidden-lg" style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important"><input type=checkbox id=chkSelTodosMob{{vm.instalacao.Instalacao}} ng-model=vm.IsAllCheckedMob[vm.instalacao.Instalacao]><label for=chkSelTodosMob{{vm.instalacao.Instalacao}} style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold; margin-bottom:0px" translate=@APP-HISTORICO-CONTAS-CHECKBOX-SELECIONAR-TODAS></div></div></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td><div class=row><div class=col-xs-3><br><div class=form-group style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important"><input type=checkbox class=marcar-mobile{{vm.instalacao.Instalacao}} id={{registro.NumeroContaEnergia}}-mobile ng-model=vm.SelectedMob[registro.NumeroContaEnergia] ng-change="vm.CheckUncheckHeaderMob(vm.instalacao.Instalacao, registro.NumeroContaEnergia)"><label for={{registro.NumeroContaEnergia}}-mobile style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold"></label></div></div></div><div class=col-xs-21><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF-MOBILE style="font-size: 13px"></span> <span ng-bind=registro.MesReferencia></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA-MOBILE style="font-size: 13px"></span> <span ng-bind=registro.DescricaoFatura ng-if=!registro.ContaAcumulada></span> <a class=hand ng-click=vm.exibirModalContaMinima(registro); translate=@APP-HISTORICO-CONTAS-CONTA-MINIMA ng-if=registro.ContaAcumulada></a> <i class="fa fa-info-circle hand" aria-hidden=true type=button style="font-size:1.3em; color:#069; margin-left:0.5em" ng-click=vm.exibirModalContaMinima(registro); ng-if=registro.ContaAcumulada></i><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VENCIMENTO-MOBILE style="font-size: 13px"></span> <span ng-bind="registro.Vencimento | date:\'dd/MM/yyyy\'"></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR-MOBILE style="font-size: 13px"></span> <span ng-bind="registro.Valor | currency" ng-if="registro.ContaMinima == null || registro.ContaMinima == \'CMA\'"></span> <span ng-if="registro.ContaMinima == \'CM\'">**********</span><br><button class="btn btn-default btn-reaviso" ng-click=vm.exibirModalReaviso(registro); ng-if="registro.DTLimiteReaviso != \'\'" translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-REAVISO></button><br></div></div><div class="row formas-de-pagamento mobile"><div class=col-xs-3></div><div class=col-xs-21 ng-if=!registro.OcultarformasPagamento><div style=font-weight:400><p><i class="fa hand fa-file-text-o" aria-hidden=true type=button ng-click=vm.selecionarContaAberta(registro); ng-if=registro.showBtnSegundaVia></i> <a class=hand ng-click=vm.selecionarContaAberta(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA ng-if=registro.showBtnSegundaVia></a></p><p><i class="fa hand fa-qrcode" aria-hidden=true type=button ng-click=vm.pagarFaturaPIX(registro); ng-if=registro.showBtnPix></i> <a class=hand ng-click=vm.pagarFaturaPIX(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-PAGAR-PIX ng-if=registro.showBtnPix uib-tooltip="{{\'@APP-HISTORICO-CONTAS-TOOLTIP-BTN-PAGAR-PIX\' | translate}}" tooltip-trigger=hover tooltip-placement=top></a></p><p><i class="fa hand fa-credit-card-alt" aria-hidden=true type=button ng-click=vm.pagarFaturaCartaoCredito(registro); ng-if="!registro.NaoExibirBotaoCartaoCredito && !registro.FaturaVencidaParcelamento &&\r'+"\n"+"                                                        registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                        !vm.possuiDebitoAutomatico && !vm.isCredenciado"></i> <a class=hand ng-click=vm.pagarFaturaCartaoCredito(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-CARTAO-CREDITO ng-if="!registro.NaoExibirBotaoCartaoCredito && !registro.FaturaVencidaParcelamento &&\r'+"\n"+"                                                        registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                        !vm.possuiDebitoAutomatico && !vm.isCredenciado" uib-tooltip="{{\'@APP-HISTORICO-CONTAS-TOOLTIP-BTN-CARTAO-CREDITO\' | translate}}" tooltip-trigger=hover tooltip-placement=top></a></p><p><i class="fa hand fa-exclamation-triangle" aria-hidden=true type=button ng-click=vm.pagarFaturaAuxilioEmergencial(registro); ng-if="registro.PermitirPagamentoAuxilioEmergencial &&\r'+"\n"+"                                                        registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                        !vm.possuiDebitoAutomatico && !vm.isCredenciado"></i> <a class=hand ng-click=vm.pagarFaturaAuxilioEmergencial(registro); ng-if="registro.PermitirPagamentoAuxilioEmergencial &&\r'+"\n"+"                                                        registro.ContaMinima != 'CMA' && registro.ContaMinima != 'CM' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MK' && registro.TipoFatura != 'MQ' &&\r"+"\n"+"                                                        registro.TipoFatura != 'MF' && registro.TipoFatura != 'MI' &&\r"+"\n"+'                                                        !vm.possuiDebitoAutomatico && !vm.isCredenciado">Auxilio Emergencial</a></p></div></div></div></td></tr></tbody></table></div><div class="panel-footer panelHistoricoContasFooter" ng-if=vm.possuiDebitosEmAberto><div id=botoes><div class="row panel-body"><div class="col-xs-24 col-md-5 span-vertical" style="margin-top: 5px !important"><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-QUANTIDADE-DEBITOS></span> <span ng-bind=vm.quantidadeDebitos></span></div><div class="col-xs-24 col-md-3 span-vertical"><div class=buttons style="text-align: initial !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click="vm.ImprimirMultiplasContas(vm.tableDebitosAbertosParams, vm.instalacao.InstalacaoReal)"><img src=assets/images/ico/print.png style="width: 50px !important; margin-top: 5px !important; margin-right: -30px !important"></i><a class=hand ng-click="vm.ImprimirMultiplasContas(vm.tableDebitosAbertosParams, vm.instalacao.InstalacaoReal)" translate=@APP-COMMON-MODAL-CONTA-COMPLETA-BTN-IMPRIMIR></a></div></div><div class="col-xs-24 col-md-5 span-vertical" style="margin-right: -30px !important"><div class=buttons style="text-align: initial !important"><i class="fas hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click="vm.salvarContas(vm.tableDebitosAbertosParams, vm.instalacao.InstalacaoReal)"><img src=assets/images/ico/save.png style="width: 50px !important; margin-top: 5px !important; margin-right: -30px !important"></i><a class=hand ng-click="vm.salvarContas(vm.tableDebitosAbertosParams, vm.instalacao.InstalacaoReal)" translate=@APP-COMMON-MODAL-CONTA-COMPLETA-BTN-SALVAR-CONTA-PDF></a></div></div><div class="col-xs-24 col-md-5 span-vertical"><div class=buttons style="text-align: initial !important; margin-top: 4px !important"><i class="fa fa-envelope-open" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click="vm.exibirModalEnviarPorEmail(vm.tableDebitosAbertosParams, vm.instalacao.Instalacao)"></i> <a class=hand ng-click="vm.exibirModalEnviarPorEmail(vm.tableDebitosAbertosParams, vm.instalacao.Instalacao)" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ENVIAR-POR-EMAIL></a></div></div><div class="col-xs-24 col-md-6 col-md-offset-4 span-vertical" ng-if="vm.situacao.PodeParcelar  && vm.situacao.PermitirParcelamento && !vm.visualizarParcelamento"><div class=buttons><button id=btnParcelarDebitos type=button class="btn btn-primary btn-lg btn-block hand" ng-click=vm.parcelarDebitos() style="background: -webkit-linear-gradient(left, #699c33, #97ca33); background: -moz-linear-gradient(left, #699c33, #97ca33);\r'+"\n"+'                                                                background: -o-linear-gradient(left, #699c33, #97ca33); background: linear-gradient(100deg, #699c33, #97ca33)" translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-BTN-PARCELAR-DEBITOS></button></div></div><div class="col-xs-24 col-md-6 col-md-offset-4 span-vertical" ng-if="!vm.situacao.PodeParcelar && vm.visualizarParcelamento"><div class=buttons><button id=btnParcelarDebitos type=button class="btn btn-primary btn-lg btn-block hand" ng-click=vm.naoPodeParcelarDebitos() style="background: -webkit-linear-gradient(left, #699c33, #97ca33); background: -moz-linear-gradient(left, #699c33, #97ca33);\r'+"\n"+'                                                                background: -o-linear-gradient(left, #699c33, #97ca33); background: linear-gradient(100deg, #699c33, #97ca33)" translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-BTN-PARCELAR-DEBITOS></button></div></div><div class="col-xs-24 col-md-5 span-vertical" ng-if=vm.possuiContaAgrupada><div class=buttons><button id=btnPagarDebitos type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.contaAgrupada() translate=@APP-HISTORICO-CONTAS-TOTAL-BTN-CONTA-AGRUPADA></button></div></div><div class="col-xs-24 col-md-24 col-24"><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-BTN-PARCELAR-DEBITOS_INFO></span></div><div class="col-xs-24 col-md-24 col-24" ng-if=!vm.isCredenciado>Participe da nossa pesquisa: são apenas 3 perguntas e leva menos de 1 minuto. Para responder agora, <a href=https://pt.surveymonkey.com/r/cpfl-segunda-via style="color: #006699">clique aqui</a>.</div></div></div></div></div></div></div></section></div></div></div><div ng-if=vm.verOutrosDebitos ng-repeat="listagem in vm.ListaDebitos track by $index"><div class=row><div class=col-xs-24><section id=debitosPendentes{{listagem.instalacao._nrInst}} class=historicoContas><div class=panel-group><div class="panel panel-default"><div class=panelHistoricoContasHeader><table width=100%><tr><td data-toggle=collapse data-target=#minhasContas{{listagem.instalacao._nrInst}} ng-init="vm.listaIcones[listagem.Cont] = true" ng-click=vm.alterarIcone(listagem.Cont) data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-TITULO-INSTALACAO class=tituloEnderecoContas translate-values="{instalacao: {{listagem.instalacao._nrInst}}}"></span></td></tr><tr><td data-toggle=collapse data-target=#minhasContas{{listagem.instalacao._nrInst}} ng-init="vm.listaIcones[listagem.Cont] = true" ng-click=vm.alterarIcone(listagem.Cont) data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-TITULO-ENDERECO class=tituloEnderecoContas></span></td></tr><tr><td data-toggle=collapse data-target=#minhasContas{{listagem.instalacao._nrInst}} ng-init="vm.listaIcones[listagem.Cont] = true" ng-click=vm.alterarIcone(listagem.Cont) data-parent=#accordion><span class=enderecoContas>{{listagem.Endereco}}</span></td></tr><tr><td><div class=panel-heading ng-if=!listagem.possuiDebitosEmAberto data-toggle=collapse data-target=#minhasContas{{listagem.instalacao._nrInst}} ng-init="vm.listaIcones[listagem.Cont] = true" ng-click=vm.alterarIcone(listagem.Cont) data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-SEM-CONTAS-EM-ABERTO class=historicoContasTitulo style="text-align: center !important"></span> <i id=iconeMinhasContas{{listagem.instalacao._nrInst}} class="iconeMinhasContasPagas pull-right fa" ng-class="{\'fa-plus\': vm.listaIcones[listagem.Cont], \'fa-minus\' : !vm.listaIcones[listagem.Cont] }"></i></div><div class=panel-heading ng-if=listagem.possuiDebitosEmAberto data-toggle=collapse data-target=#minhasContas{{listagem.instalacao._nrInst}} ng-init="vm.listaIcones[listagem.Cont] = true" ng-click=vm.alterarIcone(listagem.Cont) data-parent=#accordion><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-TITULO class=historicoContasTitulo style="text-align: center !important"></span> <span ng-bind="listagem.valorDebitos | currency" class=historicoContasValor style="text-align: center !important"></span> <i id=iconeMinhasContas{{listagem.instalacao._nrInst}} class="iconeMinhasContasPagas pull-right fa" ng-class="{\'fa-plus\': vm.listaIcones[listagem.Cont], \'fa-minus\' : !vm.listaIcones[listagem.Cont] }"></i></div></td></tr></table></div><div id=minhasContas{{listagem.instalacao._nrInst}} class="panel-collapse collapse"><div class=panel-body ng-if=listagem.possuiDebitosEmAberto><table ng-table=listagem.debitos[listagem.instalacao._nrInst] class="table hidden-xs"><thead><tr><th><div class=form-group style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important; margin-left:13px"><input type=checkbox id=chkSelTodos{{listagem.instalacao._nrInst}} ng-model=vm.IsAllChecked[listagem.instalacao._nrInst] ng-change=vm.CheckUncheckAll(listagem.instalacao._nrInst)><label for=chkSelTodos{{listagem.instalacao._nrInst}} style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold; margin-bottom:0px" translate=@APP-HISTORICO-CONTAS-CHECKBOX-SELECIONAR-TODAS></label></div></div></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VENCIMENTO></th><th translate=""></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VISUALIZAR></th></tr></thead><tbody><tr ng-repeat="registroDB in $data track by $index"><td class=valign-middle><div class=form-group style="margin:0px !important"><div class="checkbox span-vertical" style="margin-bottom:0px !important; margin-left:15px"><input type=checkbox class=marcar{{listagem.instalacao._nrInst}} id={{registroDB.NumeroContaEnergia}} ng-model=vm.Selected[registroDB.NumeroContaEnergia] ng-change="vm.CheckUncheckHeader(listagem.instalacao._nrInst, registroDB.NumeroContaEnergia)"><label for={{registroDB.NumeroContaEnergia}} style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold"></label></div></div></td><td ng-bind=registroDB.MesReferencia class="text-center span-vertical"></td><td ng-bind=registroDB.DescricaoFatura ng-if=!registroDB.ContaAcumulada class="text-center span-vertical"></td><td ng-if=registroDB.ContaAcumulada class="text-center span-vertical"><a class=hand ng-click=vm.exibirModalContaMinima(registroDB); translate=@APP-HISTORICO-CONTAS-CONTA-MINIMA></a> <i class="fa fa-info-circle hand" aria-hidden=true type=button style="font-size:1.3em; color:#069; margin-left:0.5em" ng-click=vm.exibirModalContaMinima(registroDB);></i></td><td ng-bind="registroDB.Valor | currency" ng-if="registroDB.ContaMinima == null || registroDB.ContaMinima == \'CMA\'" class="text-center span-vertical"></td><td ng-if="registroDB.ContaMinima == \'CM\'" class="text-center span-vertical">**********</td><td ng-bind="registroDB.Vencimento | date:\'dd/MM/yyyy\'" class="text-center span-vertical"></td><td class=valign-middle><button class="btn btn-default btn-warning" ng-click=vm.exibirModalReaviso(registroDB); ng-if="registroDB.DTLimiteReaviso != \'\'" translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-REAVISO></button></td><td class=valign-middle><button class="btn btn-default btn-lg btn-block hand" ng-click="vm.selecionarContaAberta(registroDB, listagem.instalacao._nrInst);" translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA ng-if=registroDB.showBtnSegundaVia></button></td></tr></tbody></table><table ng-table=listagem.debitos[listagem.instalacao._nrInst] class="table hidden-sm hidden-md hidden-lg"><thead><tr><div class=form-group style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important"><input type=checkbox id=chkSelTodosMob{{listagem.instalacao._nrInst}} ng-model=vm.IsAllCheckedMob[listagem.instalacao._nrInst] ng-change=vm.CheckUncheckAllMob(listagem.instalacao._nrInst)><label for=chkSelTodosMob{{listagem.instalacao._nrInst}} style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold; margin-bottom:0px" translate=@APP-HISTORICO-CONTAS-CHECKBOX-SELECIONAR-TODAS></div></div></tr></thead><tbody><tr ng-repeat="registroDB in $data track by $index"><td class=valign-middle><div class=form-group style="margin:0px !important"><div class=checkbox style="margin-bottom:0px !important"><input type=checkbox class=marcar-mobile{{listagem.instalacao._nrInst}} id={{registroDB.NumeroContaEnergia}}-mobile ng-model=vm.SelectedMob[registroDB.NumeroContaEnergia] ng-change="vm.CheckUncheckHeaderMob(listagem.instalacao._nrInst, registroDB.NumeroContaEnergia)"><label for={{registroDB.NumeroContaEnergia}}-mobile style="font-family: \'Lato\', sans-serif; font-size: 13px; color: #444c64; font-weight: bold"></label></div></div></td><td class=valign-middle><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF-MOBILE style="font-size: 13px"></span> <span ng-bind=registroDB.MesReferencia></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA-MOBILE style="font-size: 13px"></span> <span ng-bind=registroDB.DescricaoFatura ng-if=!registroDB.ContaAcumulada></span> <a class=hand ng-click=vm.exibirModalContaMinima(registroDB); translate=@APP-HISTORICO-CONTAS-CONTA-MINIMA ng-if=registroDB.ContaAcumulada></a> <i class="fa fa-info-circle hand" aria-hidden=true type=button style="font-size:1.3em; color:#069; margin-left:0.5em" ng-click=vm.exibirModalContaMinima(registroDB); ng-if=registroDB.ContaAcumulada></i><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VENCIMENTO-MOBILE style="font-size: 13px"></span> <span ng-bind="registroDB.Vencimento | date:\'dd/MM/yyyy\'"></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR-MOBILE style="font-size: 13px"></span> <span ng-bind="registroDB.Valor | currency" ng-if="registroDB.ContaMinima == null || registroDB.ContaMinima == \'CMA\'"></span> <span ng-if="registroDB.ContaMinima == \'CM\'">**********</span><br></td><td class=valign-middle><button class="btn btn-default btn-lg btn-block hand" ng-click="vm.selecionarContaAberta(registroDB, listagem.instalacao._nrInst);" translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA ng-if=registroDB.showBtnSegundaVia></button><br><button class="btn btn-default btn-reaviso" ng-click=vm.exibirModalReaviso(registroDB); ng-if="registroDB.DTLimiteReaviso != \'\'" translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-REAVISO>