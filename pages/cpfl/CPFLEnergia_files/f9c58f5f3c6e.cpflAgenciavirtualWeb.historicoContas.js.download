erto><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-QUANTIDADE-DEBITOS></span> <span ng-bind=listagem.quantidadeDebitos></span></div><div class="col-xs-24 col-md-3"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click="vm.ImprimirMultiplasContas(listagem.debitos[listagem.instalacao._nrInst], listagem.instalacao._nrInst)"><img src=assets/images/ico/print.png style="width: 50px !important; margin-top: 5px !important; margin-right: -30px !important"></i><a class=hand ng-click="vm.ImprimirMultiplasContas(listagem.debitos[listagem.instalacao._nrInst], listagem.instalacao._nrInst)" translate=@APP-COMMON-MODAL-CONTA-COMPLETA-BTN-IMPRIMIR></a></div><div class="col-xs-24 col-md-4"><div class=buttons><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click="vm.salvarContas(listagem.debitos[listagem.instalacao._nrInst], listagem.instalacao._nrInst)"><img src=assets/images/ico/save.png style="width: 50px !important; margin-top: 5px !important; margin-right: -30px !important"></i><a class=hand ng-click="vm.salvarContas(listagem.debitos[listagem.instalacao._nrInst], listagem.instalacao._nrInst)" translate=@APP-COMMON-MODAL-CONTA-COMPLETA-BTN-SALVAR-CONTA-PDF></a></div></div><div class="col-xs-24 col-md-5"><div class=buttons><i class="fa fa-envelope-open" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click="vm.exibirModalEnviarPorEmail(listagem.debitos[listagem.instalacao._nrInst],  listagem.instalacao._nrInst)"></i> <a class=hand ng-click="vm.exibirModalEnviarPorEmail(listagem.debitos[listagem.instalacao._nrInst],  listagem.instalacao._nrInst)" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ENVIAR-POR-EMAIL></a></div></div><div class="col-xs-24 col-md-6" ng-if="listagem.situacao.PodeParcelar && !vm.possuiDebitoAutomatico && vm.situacao.PermitirParcelamento"><div class=buttons><button id=btnParcelarDebitos type=button class="btn btn-primary btn-lg btn-block hand" style="background: -webkit-linear-gradient(left, #699c33, #97ca33); background: -moz-linear-gradient(left, #699c33, #97ca33);\r'+"\n"+'                                                                                background: -o-linear-gradient(left, #699c33, #97ca33); background: linear-gradient(100deg, #699c33, #97ca33)" ng-click=vm.parcelarDebitos() translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-BTN-PARCELAR-DEBITOS></button></div></div><div class="col-xs-24 col-md-5" ng-if=listagem.possuiContaAgrupada><div class=buttons><button id=btnPagarDebitos type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.contaAgrupada() translate=@APP-HISTORICO-CONTAS-TOTAL-BTN-CONTA-AGRUPADA></button></div></div></div></div></div></div></div></div></div></section></div></div></div><div class=row ng-if=vm.situacao.ExibirBotaoDebitosOutras><div class="col-xs-24 col-md-8 col-md-push-8"><div class=buttons><button type=button ng-if=!vm.verDebitosPaginacao class="btn btn-default btn-lg btn-block hand" ng-click=vm.verOutrasInstalacoes() translate="{{vm.verOutrosDebitos ? \'@APP-HISTORICO-CONTAS-TOTAL-BTN-ESCONDER-OUTRAS-INSTALACOES\': \'@APP-HISTORICO-CONTAS-TOTAL-BTN-OUTRAS-INSTALACOES\'}}"></button> <button type=button ng-if=vm.verDebitosPaginacao class="btn btn-default btn-lg btn-block hand" ng-click=vm.buscarRestanteDosDebitosPorPagina() translate="{{\'@APP-HISTORICO-CONTAS-TOTAL-BTN-OUTRAS-PAGINACAO-INSTALACOES\'}}"></button></div></div></div><div ng-if=!vm.possuiDebitosEmAberto><div class=row><div class="col-xs-24 col-md-8 col-md-push-8" ng-if=vm.possuiContaAgrupada><div class=buttons><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.contaAgrupada() translate=@APP-HISTORICO-CONTAS-TOTAL-BTN-CONTA-AGRUPADA></button></div></div></div></div><div ng-if="vm.possuiDebitosQuitados && !vm.ehCredenciadoImobiliaria"><div class=row><div class=col-xs-24><div class=panel-minhas-contas-pagas><div class=panel-group><div class="panel panel-default"><div class=panel-heading data-toggle=collapse data-target=#minhasContasPagas ng-init="vm.accordion_1 = true" ng-click="vm.accordion_1 = !vm.accordion_1;" data-parent=#accordion><h4 class="panel-title text-center"><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-BTN-MINHAS-CONTAS></span> <i id=iconeMinhasContasPagas class="iconeMinhasContasPagas pull-right fa" ng-class="{\'fa-plus\': vm.accordion_1, \'fa-minus\': !vm.accordion_1}"></i></h4></div><div id=minhasContasPagas class="panel-collapse collapse"><div class="panel-body panel-body-np"><div class=panel-padding><table ng-table=vm.tableDebitosPagosParams class=table align=center><thead class=hidden-xs><tr><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-STATUS></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DATA-PAGAMENTO></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VISUALIZAR></th></tr></thead><tbody class=hidden-xs><tr ng-repeat="registro in $data track by $index"><td ng-bind=registro.MesReferencia></td><td ng-bind=registro.DescricaoFatura></td><td ng-bind="registro.Valor | finance:true:2"></td><td translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-PAGO></td><td ng-bind="registro.DataPagamento | date:\'dd/MM/yyyy\'"></td><td class=valign-middle><button class="btn btn-default btn-lg btn-block hand" ng-click=vm.selecionarContaQuitada(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA ng-if=registro.showBtnSegundaVia></button></td></tr></tbody><tbody class="hidden-sm hidden-md hidden-lg"><tr ng-repeat="registro in $data track by $index"><td><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF-MOBILE style="font-size: 13px"></span> <span ng-bind=registro.MesReferencia></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA-MOBILE style="font-size: 13px"></span> <span ng-bind=registro.DescricaoFatura></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR-MOBILE style="font-size: 13px"></span> <span ng-bind="registro.Valor | finance:true:2"></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-STATUS-MOBILE style="font-size: 13px"></span> <span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-PAGO></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DATA-PAGAMENTO-MOBILE style="font-size: 13px"></span> <span ng-bind="registro.DataPagamento | date:\'dd/MM/yyyy\'"></span><br></td><td class=valign-middle><button class="btn btn-default btn-lg btn-block hand" ng-click=vm.selecionarContaQuitada(registro); translate=@APP-HISTORICO-CONTAS-TEXTO-BTN-SEGUNDA-VIA ng-if=registro.showBtnSegundaVia></button></td></tr></tbody></table></div></div></div></div></div></div></div></div></div></div>');
};a.$inject=["$templateCache"];if(angular.element(document.body).injector()){var b=angular.element(document.body).injector().get("$templateCache");a(b)}angular.module("cpflAgenciavirtualWeb.historicoContas").run(a)})();