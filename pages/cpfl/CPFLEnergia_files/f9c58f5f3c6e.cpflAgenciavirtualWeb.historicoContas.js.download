er style="background-color: #FFFFFF; height: 15px"><font face=Tahoma size=1>348</font></td><td align=center style="background-color: #FFFFFF; height: 15px"><font face=Tahoma size=1>396</font></td></tr><tr><td colspan=3 align=center style="background-color: #FFFFFF"><font face=Tahoma size=1><b>Resolução ANEEL nº395, de 15/12/2009</b></font></td></tr><tr><td colspan=3><font face=Tahoma size=1><span translate=@APP-MODAL-VIA-PAGAMENTO-INFORMACOES-CONDICOES-FORNECIMENTO></span></font></td></tr></table></td></tr></table></td></tr></table>');
a.put("modules/historico-contas/views/historico-contas-conta-agrupada.html",'<div class=historico-contas><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.historico-contas titulo-breadcrumb2=@APP-HISTORICO-CONTAS-TITULO sref-breadcrumb3="" titulo-breadcrumb3=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA></cabecalho-pagina><div ng-if=vm.response><div class=row><div class=col-xs-24><div class="panel panel-default"><div class="panel-body panel-body-np"><div class=panel-padding><table ng-table=vm.tableContaAgrupadaParams class=table><thead><tr><th translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-COLHEAD-NUMERO-CONTA></th><th translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-COLHEAD-NUMERO-SEQUENCIAL></th><th translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-COLHEAD-VENCIMENTO></th><th translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-COLHEAD-TOTAL></th><th translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-COLHEAD-DATA></th><th translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-COLHEAD-VISUALIZAR></th></tr></thead><tbody><tr ng-repeat="registro in $data track by $index"><td ng-bind=registro.NumeroContaEnergia></td><td ng-bind=registro.NumeroSequencial></td><td ng-bind=registro.Vencimento></td><td ng-bind=registro.Total></td><td ng-bind=registro.Data></td><td class=valign-middle><button class="btn btn-default" ng-click=vm.detalhesContaAgrupada(registro.NumeroContaEnergia); translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-BTN-DETALHES></button></td></tr></tbody></table></div></div></div></div></div></div></div>');a.put("modules/historico-contas/views/historico-contas-detalhes-conta-quitada.html",'<div class=historico-contas-detalhes-conta-quitada><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-DETALHES-CONTA-TITULO titulo-cabecalho-translate-values="{mes: vm.mesReferencia}" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.historico-contas titulo-breadcrumb2=@APP-HISTORICO-CONTAS-TITULO sref-breadcrumb3="" titulo-breadcrumb3=@APP-HISTORICO-CONTAS-DETALHES-CONTA-TITULO titulo-translate-values-breadcrumb3="{mes: vm.mesReferencia}"></cabecalho-pagina><div class=row><div class=col-xs-24><section id=info-protocolo ng-if=vm.protocolo><div class=protocolo><div class=protocolo-primary><span translate=@APP-HISTORICO-CONTAS-PROTOCOLO></span> <span class=numero-protocolo ng-bind=vm.protocolo></span></div></div></section></div></div><section id=detalheConta class=historicoContas><div class="panel panel-default" id=detalhesDebito><div class=panelHistoricoContasHeader><div class=panel-heading><div class=row><div class="col-xs-24 col-md-8"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-QUITADA-VALOR class=historicoContasTitulo></span> <span ng-bind="vm.dadosConta.Valor | currency" class=historicoContasValor></span></div></div><div class="col-xs-24 col-md-8"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-QUITADA-MES-DE-REFERENCIA class=historicoContasTitulo></span> <span ng-bind=vm.mesReferencia class=historicoContasValor></span></div></div><div class="col-xs-24 col-md-8"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-QUITADA-DATA-VENCIMENTO class=historicoContasTitulo></span> <span ng-bind="vm.dadosConta.Vencimento| date:\'dd/MM/yyyy\'" class=historicoContasValor></span></div></div></div></div></div></div><div class="panel-footer panelHistoricoContasFooter"><div class=buttons><div class=row><div class="col-xs-24 col-md-8" ng-if="vm.dadosConta.Parcela==false"><button id=btnVerContaCompleta type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-QUITADA-BTN-VER-CONTA-COMPLETA ng-click=vm.verContaCompleta();></button></div><div class="col-xs-24 col-md-8" ng-if=vm.exibirBotaoItensConsolidados><button id=btnModalItensConsolidados type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ITENS-CONSOLIDADOS ng-click=vm.exibirModalItensConsolidados();></button></div><div class="col-xs-24 col-md-8"><button id=btnDownloadXML type=button class="btn btn-default btn-lg btn-block hand" ng-if=vm.habilitaDownloadXML translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-DOWNLOAD-XML ng-click=vm.downloadXML(vm.dadosConta);></button></div></div></div></div></section></div>');a.put("modules/historico-contas/views/historico-contas-detalhes-conta.html",'<div class=historico-contas-detalhes-conta><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-DETALHES-CONTA-TITULO titulo-cabecalho-translate-values="{mes: vm.mes}" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.historico-contas titulo-breadcrumb2=@APP-HISTORICO-CONTAS-TITULO sref-breadcrumb3="" titulo-breadcrumb3=@APP-HISTORICO-CONTAS-DETALHES-CONTA-TITULO titulo-translate-values-breadcrumb3="{mes: vm.mes}"></cabecalho-pagina><div class=row><div class=col-xs-24><section id=info-protocolo ng-if=vm.protocolo style="margin-bottom:-10px !important; margin-top:-20px !important"><div class=protocolo><div class=protocolo-primary><span translate=@APP-HISTORICO-CONTAS-PROTOCOLO></span> <span class=numero-protocolo ng-bind=vm.protocolo></span></div></div></section></div></div><div class=row><div class="hidden-sm hidden-xs" style="padding-right: 5px !important; margin-left: 15px !important; margin-right: 15px !important"><div class=border-historico-contas><section id=detalheConta class=historicoContas><div><div class=panel id=detalhesDebito style="margin-top:-5px !important; margin-left:-3px !important"><div class="col-xs-24 col-md-6" style="padding-left: 0px !important"><div class=panelHistoricoContasHeader style="padding-left: 0px !important"><div class=panel-heading><div class=row><div class=col-xs-24 style="margin-top: -35px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-DATA-VENCIMENTO class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind="vm.dadosConta.Vencimento | date:\'dd/MM/yyyy\'" class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-MES-DE-REFERENCIA class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind=vm.dadosConta.MesReferencia class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-VALOR class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind="vm.dadosConta.Valor | currency" class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-NUMERO-CONTA class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind=vm.dadosConta.NumeroContaEnergia class=historicoContasValor style="font-size: 1.2em; text-align:left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-DESCRICAO-FATURA class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind=vm.dadosConta.DescricaoFatura class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class="col-xs-24 col-md-24" style="margin-bottom: -20px !important"><div class=historicoContasInfoGroup><span ng-bind=vm.mensagemNaoReceber class=historicoContasTitulo ng-if=vm.mensagemNaoReceber style="font-size: 1.2em"></span></div></div></div></div></div></div><div class="col-xs-24 col-md-17"><div class="panel-body cpfl-style" style="margin-top: -30px !important"><div class="panelHistoricoContasBody historicoContas"><div class=col-xs-25><div class=codigoBarras style="margin-top: 10px !important"><img ng-src={{vm.dadosConta.QRCodeBase64}} width=160px height=160px ng-if="!vm.dadosConta.FaturarContaAcumulada && vm.exibirPIX"><p ng-if="!vm.dadosConta.FaturarContaAcumulada && vm.exibirPIX">Pague aqui - PIX</p></div></div><div class=buttons ng-if=vm.exibirPIX><div class=row><div class="col-xs-24 col-md-9" ng-if=!vm.dadosConta.FaturarContaAcumulada ngclipboard data-clipboard-text={{vm.dadosConta.strEstaticoPIX}} ng-click=vm.mostrarMensagemCopiadoClipboardPIX(); style="margin-bottom:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069"><img src=assets/images/ico/copiar.svg></i>&nbsp; <a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-COPIAR-CODIGO-PIX></a></div></div></div><br><br><div class="svg-container hidden-xs" style="width:90% !important; height:82px !important; margin-left:32px !important"></div><div class=col-xs-25><div class=codigoBarras style="margin-top: 10px !important"><p ng-bind=vm.dadosConta.CodigoBarras ng-if="!vm.dadosConta.FaturarContaAcumulada && vm.exibirCodigoBarras"></p></div></div><div class=col-xs-24 ng-if=vm.exibirMensagemContaMinima><div class=texto-conta-minima><p translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-MENSAGEM-CONTA-MINIMA></p></div></div><div class=buttons ng-if=vm.exibirCodigoBarras><div class=row><div class="col-xs-24 col-md-9" ng-if=!vm.dadosConta.FaturarContaAcumulada ngclipboard data-clipboard-text={{vm.dadosConta.CodigoBarras}} ng-click=vm.mostrarMensagemCopiadoClipboard(); style="margin-bottom:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069"><img src=assets/images/ico/copiar.svg></i>&nbsp; <a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-COPIAR-CODIGO-DE-BARRAS></a></div></div><br><div class=row><div class="col-xs-24 col-md-8" ng-if="!vm.dadosConta.FaturarContaAcumulada && \r'+"\n"+"                                                         !vm.possuiDebitoAutomatico && !vm.dadosConta.NaoExibirBotaoCartaoCredito &&\r"+"\n"+"                                                        !vm.dadosConta.FaturaVencidaParcelamento && !vm.isCredenciado &&\r"+"\n"+"                                                        vm.dadosConta.ContaMinima != 'CMA' && vm.dadosConta.ContaMinima != 'CM' &&\r"+"\n"+"                                                        vm.dadosConta.TipoFatura != 'MK' && vm.dadosConta.TipoFatura != 'MQ' &&\r"+"\n"+"                                                        vm.dadosConta.TipoFatura != 'MF' && vm.dadosConta.TipoFatura != 'MI' \"><button id=btnPagarConta type=button class=\"btn btn-default btn-lg btn-block hand\" ng-click=vm.pagarFaturaCartaoCredito(vm.dadosConta); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-PAGAR-CONTA ng-if=\"!vm.possuiDebitoAutomatico && !vm.dadosConta.NaoExibirBotaoCartaoCredito &&\r"+"\n"+"                                                        !vm.dadosConta.FaturaVencidaParcelamento && !vm.isCredenciado &&\r"+"\n"+"                                                        vm.dadosConta.ContaMinima != 'CMA' && vm.dadosConta.ContaMinima != 'CM' &&\r"+"\n"+"                                                        vm.dadosConta.TipoFatura != 'MK' && vm.dadosConta.TipoFatura != 'MQ' &&\r"+"\n"+'                                                        vm.dadosConta.TipoFatura != \'MF\' && vm.dadosConta.TipoFatura != \'MI\'"></button></div><div class="col-xs-24 col-md-8" ng-if=vm.dadosConta.FaturarContaAcumulada><span></span></div><div class="col-xs-24 col-md-8"><button id=Button4 type=button ng-if=!vm.ehCredenciadoImobiliaria class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VER-CONTA-COMPLETA ng-click=vm.verContaCompletaPDF()></button></div><div class="col-xs-24 col-md-8"><button id=btnEnviarEmail type=button class="btn btn-default btn-lg btn-block hand" ng-if=!vm.dadosConta.FaturarContaAcumulada translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ENVIAR-POR-EMAIL ng-click=vm.exibirModalEnviarPorEmail();></button></div><div class="col-xs-24 col-md-8"><button id=btnDownloadXML type=button class="btn btn-default btn-lg btn-block hand" ng-if=vm.habilitaDownloadXML translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-DOWNLOAD-XML ng-click=vm.downloadXML(vm.dadosConta);></button></div><div class="col-xs-24 col-md-8"><button id=btnFaturarContaMinima type=button class="btn btn-default btn-lg btn-block hand" ng-if=vm.dadosConta.FaturarContaAcumulada ng-click=vm.faturarContaMinima(); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-CONTA-ACUMULADA></button></div></div><br><div class=row><div class="col-xs-24 col-md-9" style="margin-top:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click=vm.viaPagamento();><img src=assets/images/ico/money.svg></i>&nbsp; <a class=hand ng-click=vm.viaPagamento(); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VIA-PAGAMENTO></a></div><div class="col-xs-24 col-md-9" ng-if="vm.dadosConta.Parcela==false" style="text-align: center; margin-top:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click=vm.reenviarPelosCorreios();><img src=assets/images/ico/envelope.svg></i>&nbsp; <a class=hand ng-click=vm.reenviarPelosCorreios(); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-REENVIAR-PELOS-CORREIOS></a></div></div></div><div class=buttons ng-if=!vm.exibirCodigoBarras><div class=row><div class="col-xs-24 col-md-8" ng-if="vm.dadosConta.Parcela==false"><button id=Button4 type=button ng-if=!vm.ehCredenciadoImobiliaria class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VER-CONTA-COMPLETA ng-click=vm.verContaCompletaPDF()></button></div><div class="col-xs-24 col-md-8"><button id=Button2 type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ENVIAR-POR-EMAIL ng-click=vm.exibirModalEnviarPorEmail();></button></div><div class="col-xs-24 col-md-8 hidden-xs hidden-sm" style="margin-top:-10px !important"><i class="fa fa-money hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click=vm.viaPagamento();></i><div ng-click=vm.viaPagamento();><a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VIA-PAGAMENTO></a></div></div></div></div></div></div></div><div><div class="panel-footer panelHistoricoContasFooter" ng-if="vm.dadosConta.ExibirBotoesHistoricoContas && !vm.dadosConta.FaturarContaAcumulada && vm.exibirCodigoBarras"><div class=buttons><div class=row><div class=col-xs-24><div class=row><div class="panel panel-default"><div class=col-xs-24 ng-if="vm.dadosConta.Parcela==false"><div class=taxaCorreios style="margin-top: -25px !important; margin-left: -15px !important; margin-right: -35px !important"><p translate=@APP-HISTORICO-CONTAS-TAXA-CORREIO translate-values="{taxaCorreio: vm.taxaCorreio}"></p><p style="margin-top:-10px !important"><span translate=@APP-HISTORICO-CONTAS-ADOBE-READER-INICIO></span> <a title="adobe reader" ng-click="$root.openExternalLink(\'https://get.adobe.com/br/reader/\', \'_blank\')">aqui</a> <span translate=@APP-HISTORICO-CONTAS-ADOBE-READER-FIM></span></p></div></div></div></div></div></div></div></div></div></div></section></div></div><div class="col-xs-24 hidden-md hidden-lg" style="padding-right: 5px !important"><section id=detalheConta class=historicoContas><div class="panel panel-default" id=detalhesDebito><div class="col-xs-24 col-md-6" style="padding-left: 0px !important"><div class=panelHistoricoContasHeader style="padding-left: 0px !important"><div class=panel-heading><div class=row><div class=col-xs-24 style="margin-top: -35px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-DATA-VENCIMENTO class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind="vm.dadosConta.Vencimento | date:\'dd/MM/yyyy\'" class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-MES-DE-REFERENCIA class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind=vm.dadosConta.MesReferencia class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-VALOR class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind="vm.dadosConta.Valor | currency" class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-NUMERO-CONTA class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind=vm.dadosConta.NumeroContaEnergia class=historicoContasValor style="font-size: 1.2em; text-align:left !important"></span></div></div></div><div class=row><div class=col-xs-24 style="margin-top: -25px !important"><div class=historicoContasInfoGroup><span translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-DESCRICAO-FATURA class=historicoContasTitulo style="text-align:left !important"></span> <span ng-bind=vm.dadosConta.DescricaoFatura class=historicoContasValor style="font-size: 1.2em; text-align: left !important"></span></div></div></div><div class="col-xs-24 col-md-24" style="margin-bottom: -20px !important"><div class=historicoContasInfoGroup><span ng-bind=vm.mensagemNaoReceber class=historicoContasTitulo ng-if=vm.mensagemNaoReceber style="font-size: 1.2em"></span></div></div></div></div></div></div><div class="col-xs-24 col-md-17"><div class="panel-body cpfl-style" style="margin-top: -30px !important"><div class="panelHistoricoContasBody historicoContas"><div class=col-xs-25><div class=codigoBarras style="margin-bottom: -25px !important; margin-top: 25px !important; font-size: 99% !important"><img ng-src={{vm.dadosConta.QRCodeBase64}} width=160px height=160px ng-if="!vm.dadosConta.FaturarContaAcumulada && vm.exibirPIX"><p ng-if="!vm.dadosConta.FaturarContaAcumulada && vm.exibirPIX">Pague aqui - PIX</p></div></div><div class=buttons ng-if=vm.exibirPIX><div class=row><div class="col-xs-24 col-md-9" style="text-align: center !important; margin-top:25px !important" ng-if=!vm.dadosConta.FaturarContaAcumulada ngclipboard data-clipboard-text={{vm.dadosConta.strEstaticoPIX}} ng-click=vm.mostrarMensagemCopiadoClipboardPIX(); style="margin-bottom:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069"><img src=assets/images/ico/copiar.svg style="Margin-top: 10px !important"></i>&nbsp; <a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-COPIAR-CODIGO-PIX></a></div></div></div><br><div class="svg-container hidden-xs" style="width:90% !important; height:82px !important; margin-left:32px !important" ng-if=!vm.dadosConta.FaturarContaAcumulada></div><div class=col-xs-25><div class=codigoBarras style="margin-bottom: -25px !important; margin-top: 25px !important; font-size: 99% !important"><p ng-bind=vm.dadosConta.CodigoBarras ng-if="!vm.dadosConta.FaturarContaAcumulada && vm.exibirCodigoBarras"></p></div></div><div class=col-xs-24 ng-if=vm.exibirMensagemContaMinima><div class=texto-conta-minima><p translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-MENSAGEM-CONTA-MINIMA></p></div></div><div class=buttons ng-if=vm.exibirCodigoBarras><div class=row><div class="col-xs-24 col-md-9" style="text-align: center !important; margin-top:25px !important" ng-if=!vm.dadosConta.FaturarContaAcumulada ngclipboard data-clipboard-text={{vm.dadosConta.CodigoBarras}} ng-click=vm.mostrarMensagemCopiadoClipboard(); style="margin-bottom:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069"><img src=assets/images/ico/copiar.svg style="Margin-top: 10px !important"></i>&nbsp; <a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-COPIAR-CODIGO-DE-BARRAS></a></div></div><br><div class=row><div class="col-xs-24 col-md-8" ng-if=!vm.dadosConta.FaturarContaAcumulada><button id=btnPagarConta type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.pagarFaturaCartaoCredito(vm.dadosConta); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-PAGAR-CONTA ng-if="!vm.possuiDebitoAutomatico && !vm.dadosConta.NaoExibirBotaoCartaoCredito &&\r'+"\n"+"                                                        !vm.dadosConta.FaturaVencidaParcelamento && !vm.isCredenciado &&\r"+"\n"+"                                                        vm.dadosConta.ContaMinima != 'CMA' && vm.dadosConta.ContaMinima != 'CM' &&\r"+"\n"+"                                                        vm.dadosConta.TipoFatura != 'MK' && vm.dadosConta.TipoFatura != 'MQ' &&\r"+"\n"+'                                                        vm.dadosConta.TipoFatura != \'MF\' && vm.dadosConta.TipoFatura != \'MI\'"></button></div><div class="col-xs-24 col-md-8" ng-if=vm.dadosConta.FaturarContaAcumulada><span></span></div><div class="col-xs-24 col-md-8"><button id=Button4 type=button ng-if=!vm.ehCredenciadoImobiliaria class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VER-CONTA-COMPLETA ng-click=vm.verContaCompletaPDF()></button></div><div class="col-xs-24 col-md-8"><button id=btnEnviarEmail type=button class="btn btn-default btn-lg btn-block hand" ng-if=!vm.dadosConta.FaturarContaAcumulada translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ENVIAR-POR-EMAIL ng-click=vm.exibirModalEnviarPorEmail();></button></div></div><br><div class=row><div class="col-xs-24 col-md-9" style="text-align: center; margin-left:-30px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click=vm.viaPagamento();><img src=assets/images/ico/money.svg></i>&nbsp; <a class=hand ng-click=vm.viaPagamento(); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VIA-PAGAMENTO></a></div></div><br><div class=row><div class="col-xs-24 col-md-9" ng-if="vm.dadosConta.Parcela==false" style="text-align: center; margin-left:9px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click=vm.reenviarPelosCorreios();><img src=assets/images/ico/envelope.svg></i>&nbsp; <a class=hand ng-click=vm.reenviarPelosCorreios(); translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-REENVIAR-PELOS-CORREIOS></a></div></div></div><div class=buttons ng-if=!vm.exibirCodigoBarras><div class=row><div class="col-xs-24 col-md-8" ng-if="vm.dadosConta.Parcela==false"><button id=Button4 type=button ng-if=!vm.ehCredenciadoImobiliaria class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VER-CONTA-COMPLETA ng-click=vm.verContaCompletaPDF()></button></div><div class="col-xs-24 col-md-8"><button id=Button2 type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-ENVIAR-POR-EMAIL ng-click=vm.exibirModalEnviarPorEmail();></button></div><div class="col-xs-24 col-md-8 hidden-xs hidden-sm" style="margin-bottom:-10px !important"><i class="fa fa-money hand" aria-hidden=true type=button style="font-size:1.3em; color:#069" ng-click=vm.viaPagamento();></i><div ng-click=vm.viaPagamento();><a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-VIA-PAGAMENTO></a></div></div></div></div></div></div></div><div class="panel-footer panelHistoricoContasFooter" ng-if="vm.dadosConta.ExibirBotoesHistoricoContas && !vm.dadosConta.FaturarContaAcumulada && vm.exibirCodigoBarras"><div class=buttons><div class=row><div class=col-xs-24><div class=row><div class=col-xs-24 ng-if="vm.dadosConta.Parcela==false"><div class=taxaCorreios style="margin-top: -20px !important; margin-left: -15px !important; margin-right: -35px !important"><p translate=@APP-HISTORICO-CONTAS-TAXA-CORREIO translate-values="{taxaCorreio: vm.taxaCorreio}"></p><p style="margin-top:-10px !important"><span translate=@APP-HISTORICO-CONTAS-ADOBE-READER-INICIO></span> <a title="adobe reader" ng-click="$root.openExternalLink(\'https://get.adobe.com/br/reader/\', \'_blank\')">aqui</a> <span translate=@APP-HISTORICO-CONTAS-ADOBE-READER-FIM></span></p></div></div></div></div></div></div></div></section></div></div></div>');a.put("modules/historico-contas/views/historico-contas-enviar-correio.html",'<div class=historico-contas-enviar-correio><cabecalho-pagina titulo-cabecalho=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-TITULO titulo-cabecalho-translate-values="{mes: vm.mes}" sref-breadcrumb1=app.home titulo-breadcrumb1=@APP-COMMON-BREADCRUMB-HOME sref-breadcrumb2=app.historico-contas titulo-breadcrumb2=@APP-HISTORICO-CONTAS-TITULO sref-breadcrumb3="" titulo-breadcrumb3=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-TITULO titulo-translate-values-breadcrumb3="{mes: vm.mes}"></cabecalho-pagina><div class=row><div class=col-xs-24><section id=enviarCorreios><div class=row><div class=col-xs-24><h2 translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-SUBTITULO></h2></div></div><div class=row><div class=col-xs-24><div class=enviarCorreios><p translate=@APP-HISTORICO-CONTAS-TAXA-CORREIO translate-values="{taxaCorreio: vm.taxaCorreio}"></p></div></div></div><form name=form novalidate><div ng-if="vm.form.endereco == \'optMesmoEnderecoInstalacao\'"><div class=row><div class="col-xs-24 col-md-12"><div id=mesmoEndereco><h2 translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MESMO-ENDERECO-TITULO></h2><div class=enderecoInstalacao><p ng-bind=vm.enderecoEntrega.enderecoCompleto></p></div></div></div></div></div><div id=outroEndereco ng-if="vm.form.endereco == \'optOutroEndereco\'"><div id=consultaPorCEP ng-if=vm.consultarPorCEP><div class=row><div class=col-xs-24><div class=form-group><label for=cep translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-LABEL-CEP data-required=true></label><input type=tel class=form-control id=cep placeholder=09999-999 ng-required=true custom-cep-mask ng-disabled=vm.disableEdit ng-model=vm.form.cep cpfl-highlight-input></div></div></div><div class=row ng-if=vm.showBtnContinuar><div class=col-xs-24><button id=btnEscolherMunicipio class="btn btn-link pull-right" translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-BTN-NAO-SEI-O-CEP ng-click="vm.changeBuscaOutrEndereo(); vm.consultarPorCEP = !vm.consultarPorCEP"></button></div></div></div><div id=consultaPorMunicipio ng-if=!vm.consultarPorCEP><div class=row><div class="col-xs-24 col-md-12"><div class=selectBoxServicos><div class=form-group><label class=inputs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-LABEL-ESTADO data-required=true></label><ui-select ng-model=vm.form.estado theme=selectize name=selectEstado ng-required=true on-select=vm.changeEstado(); ng-disabled=vm.disableEdit><ui-select-match placeholder="{{\'@APP-HISTORICO-CONTAS-SELECIONE-ESTADO\' | translate}}"><span ng-bind=$select.selected.Codigo></span></ui-select-match><ui-select-choices repeat="option in vm.estados | filter: $select.search"><span ng-bind=option.Codigo></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-angle-down" aria-hidden=true></i></span></div></div></div><div class="col-xs-24 col-md-12"><div class=selectBoxServicos><div class=form-group><label class=inputs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-LABEL-MUNICIPIO data-required=true></label><ui-select ng-model=vm.form.municipio theme=selectize name=selectMunicipio ng-required=true ng-disabled="!vm.municipios || vm.disableEdit"><ui-select-match placeholder="{{\'@APP-HISTORICO-CONTAS-SELECIONE-MUNICIPIO\' | translate}}"><span ng-bind=$select.selected.Nome></span></ui-select-match><ui-select-choices repeat="option in vm.municipios | filter: $select.search"><span ng-bind=option.Nome></span></ui-select-choices><ui-select-no-choice ng-hide="($select.search.length <= 0 && $select.items.length <= 0) || $select.items.length > 0" translate=@APP-COMMON-SELECT-NAO-ENCONTROU></ui-select-no-choice></ui-select><span class=arrow-select><i class="fa fa-angle-down" aria-hidden=true></i></span></div></div></div></div><div class=row ng-if=vm.showBtnContinuar><div class=col-xs-24><button id=btnEscolherCEP class="btn btn-link pull-right" translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-BTN-ENCONTRAR-PELO-CEP ng-click="vm.consultarPorCEP = !vm.consultarPorCEP"></button></div></div></div><div class=buttons ng-if=vm.showBtnContinuar><div class=row><div class="col-xs-24 col-md-8"><button id=btnContinuarEndereco type=button class="btn btn-default btn-lg btn-block" translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-BTN-CONTINUAR ng-click=vm.consultarOutroEndereco(form)></button></div></div></div><div id=complementoBuscaEndereco ng-if=vm.showComplementoBuscaEndereco><div class=row><div class="col-xs-24 col-md-16"><div class=form-group><label for=logradouro class=inputs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-COMPLEMENTO-LABEL-LOGRADOURO></label><input type=text class=form-control id=logradouro placeholder="{{\'@APP-COMMON-PLACEHOLDER-ENDERECO\' | translate}}" ng-model=vm.form.logradouro ng-disabled=vm.disableEdit cpfl-highlight-input></div></div><div class="col-xs-24 col-md-8"><div class=form-group><label for=numero class=inputs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-COMPLEMENTO-LABEL-NUMERO></label><input type=text class=form-control id=numero placeholder="{{\'@APP-COMMON-PLACEHOLDER-NUMERO\' | translate}}" ng-model=vm.form.numero ng-disabled=vm.disableEdit ui-number-mask=0 cpfl-highlight-input></div></div></div><div class=buttons ng-if=!vm.showComplementoOutroEndereco><div class=row><div class="col-xs-24 col-md-8"><button id=btnBuscarEndereco type=button class="btn btn-default btn-lg btn-block" translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-BTN-BUSCAR-ENDERECO ng-click=vm.buscarEndereco();></button></div></div></div></div><div id=complementoOutroEndereco ng-if=vm.showComplementoOutroEndereco><div class=row><div class="col-xs-24 col-md-8"><div class=form-group><label for=estado class=inputs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-COMPLEMENTO-LABEL-ESTADO></label><input type=text class=form-control name=estado id=estado placeholder=@APP-HISTORICO-CONTAS-SELECIONE-ESTADO ng-model=vm.form.estado ng-disabled=vm.disableEdit cpfl-highlight-input></div></div><div class="col-xs-24 col-md-8"><div class=form-group><label for=municipio class=inputs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-OUTRO-ENDERECO-COMPLEMENTO-LABEL-MUNICIPIO></label><input type=text class=form-control name=municipio id=municipio placeholder=@APP-HISTORICO-CONTAS-SELECIONE-MUNICIPIO ng-model=vm.form.municipio ng-disabled=vm.disableEdit cpfl-highlight-input></div></div><div class=col-xs-24><div class=form-group><busca-endereco-complemento source=vm form=form></busca-endereco-complemento></div></div></div></div></div><div id=caixaPostalDiv ng-if="vm.form.endereco == \'optCaixaPostal\'"><div class=row><div class="col-xs-24 col-md-12"><div class=selectBoxServicos><div class=form-group><label class=inputs translate