a.put("modules/historico-contas/partials/modal-confirmacao-pagamento-token-sms.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-HISTORICO-CONTAS-MODAL-CONFIRMACAO-PAGAMENTO-CARTAO-TITLE></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-meus-dados-alerta-sms></alert></div></div><div class=row><div class=col-xs-24><div class=form-group><label class=inputs translate=@APP-HISTORICO-CONTAS-MODAL-CONFIRMACAO-PAGAMENTO-CARTAO-TEXTO></label><div class=radio-box><div class="form-group form-group-radio" ng-repeat="telefone in vm.celular track by $index"><label ng-if=telefone><input type=radio name=opcaoRamalSub ng-model=vm.telefoneSelecionado value={{$index}} required> <span ng-bind=telefone></span></label></div></div></div></div></div><div class=buttons><div class=row><div class="col-xs-24 col-md-12"><button type=button class="btn btn-secondary btn-lg btn-block hand" ng-click=vm.cancelar(); translate=@APP-HISTORICO-CONTAS-MODAL-CONFIRMACAO-PAGAMENTO-CARTAO-BTN-CANCELAR></button></div><div class="col-xs-24 col-md-12"><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.enviar(); translate=@APP-HISTORICO-CONTAS-MODAL-CONFIRMACAO-PAGAMENTO-CARTAO-BTN-ENVIAR></button></div></div><div class=row><div class=col-xs-24 style=text-align:left!important><label class=inputs translate=@APP-HISTORICO-CONTAS-MODAL-CONFIRMACAO-PAGAMENTO-CARTAO-TXT_REENVIO></label></div></div><div class=row><div class="col-xs-24 col-md-8"><button type=button class="btn btn-link" style=color:#006699;margin-top:1em;margin-bottom:-2em ng-click=vm.naoTenhoMaisEsseCelular() translate=@APP-MODAL-MEUS-DADOS-ALERTA-SMS-BTN-NAO-TENHO-MAIS-CELULAR></button></div></div></div><div class=row style=margin-top:30px><div class="col-xs-24 col-md-12 col-md-offset-6"><div class=form-group><label for=cardcvvc translate=@APP-HISTORICO-CONTAS-MODAL-C