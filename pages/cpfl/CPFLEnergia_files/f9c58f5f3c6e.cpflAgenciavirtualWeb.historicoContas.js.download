></button></div><div class="col-xs-24 col-md-8"><button id=btnPDF type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-MODAL-BTN-PDF ng-click=vm.gerarPDFContaAgrupada();></button></div><div class="col-xs-24 col-md-8 hidden-xs hidden-md"><button id=btnFechar type=button class="btn btn-default btn-lg btn-block hand" translate=@APP-HISTORICO-CONTAS-CONTA-AGRUPADA-MODAL-BTN-FECHAR ng-click=vm.fechar();></button></div></div></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-conta-completa.html",'<div class=modal-content id=pdfModal tabindex=-1 role=dialog aria-hidden=true><div class=modal-body style=overflow-y:hidden;height:450px id=via-pagamento><iframe ng-if=vm.pdfContent id=iFramePdf src={{vm.pdfContent}} style="width:100%; height:450px"></iframe></div><div class=modal-footer style="padding-top:10px !important"><div class=row style="text-align:left; border:1px solid rgba(0,0,0,.1)"><div class=col-xs-24><div class=taxaCorreios style=padding:5px><p translate=@APP-COMMON-MODAL-CONTA-COMPLETA-MSG-CUSTO-IMPRESSAO translate-values="{taxaCorreio: vm.taxaCorreio}"></p><p><span translate=@APP-HISTORICO-CONTAS-ADOBE-READER-INICIO></span> <a title="adobe reader" ng-click="$root.openExternalLink(\'https://get.adobe.com/br/reader/\', \'_blank\')">aqui</a> <span translate=@APP-HISTORICO-CONTAS-ADOBE-READER-FIM></span></p></div></div></div><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-12"><button id=btnEnviar type=button class="btn btn-default btn-lg btn-block hand" data-dismiss=modal translate=@APP-COMMON-MODAL-CONTA-COMPLETA-BTN-IMPRIMIR ng-click=vm.imprimir();></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button id=btnVoltar type=button class="btn btn-secondary btn-lg btn-block hand" data-dismiss=modal translate=@APP-COMMON-MODAL-CONTA-COMPLETA-BTN-FECHAR ng-click=vm.fechar();></button></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-conta-minima.html",'<div id=conta-minima><div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-HISTORICO-CONTAS-MODAL-CONTA-MINIMA-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=cpfl-style><div class=col-xs-24><p translate=@APP-HISTORICO-CONTAS-MODAL-CONTA-MINIMA-MENSAGEM-1></p><p translate=@APP-HISTORICO-CONTAS-MODAL-CONTA-MINIMA-MENSAGEM-2></p><p ng-if="vm.dadosConta.ContaMinima == \'CMA\' && vm.dadosConta != null">Caso deseje gerar o código de barras para pagamento <a ng-click=vm.detalhesConta() class=hand>clique aqui</a></p></div></div></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-6"><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.fechar() translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-BTN-FECHAR></button></div></div></div></div>');a.put("modules/historico-contas/partials/modal-enviar-por-email.html",'<div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-COMMON-MODAL-ENVIAR-POR-EMAIL-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><alert target=modal-enviar-por-email></alert></div></div><div class=row><div class=col-xs-24><div class=cpfl-style><form novalidate name=form><div class=form-group><label for=email class=inputs translate=@APP-COMMON-MODAL-ENVIAR-POR-EMAIL-LABEL-EMAIL></label><input type=text class=form-control id=email placeholder="{{\'@APP-COMMON-PLACEHOLDER-EMAIL\' | translate}}" ng-model=vm.formEnviar.email acn-email-validator></div></form></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-push-12"><button id=btnEnviar type=button class="btn btn-default btn-lg btn-block hand" data-dismiss=modal translate=@APP-COMMON-MODAL-ENVIAR-POR-EMAIL-BTN-ENVIAR ng-click=vm.enviar(form);></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button id=btnVoltar type=button class="btn btn-secondary btn-lg btn-block hand" data-dismiss=modal translate=@APP-COMMON-MODAL-ENVIAR-POR-EMAIL-BTN-VOLTAR ng-click=vm.voltar();></button></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-historico-conta-fintech.html",'<div class=modal-content><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.fechar(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-HISTORICO-CONTAS-FINTECH-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><div class=cpfl-style><div class=col-xs-24><div><span style=font-weight:400 translate=@APP-HISTORICO-CONTAS-FINTECH-MENSAGEM-REGRA-1 ng-if="vm.regraPopupAvisoFintech == \'1\' "></span> <span style=font-weight:400 translate=@APP-HISTORICO-CONTAS-FINTECH-MENSAGEM-REGRA-2 ng-if="vm.regraPopupAvisoFintech == \'2\' "></span> <span style=font-weight:400 translate=@APP-HISTORICO-CONTAS-FINTECH-MENSAGEM-REGRA-3 ng-if="vm.regraPopupAvisoFintech == \'3\' "></span></div></div></div><section ng-if="vm.regraPopupAvisoFintech == \'2\'"><table class=table ng-table=vm.tableParams><thead style="text-align: center"><tr><th class="hidden-md hidden-sm" translate=@APP-HISTORICO-CONTAS-MES-REFERENCIA></th><th class="hidden-xs hidden-sm" translate=@APP-HISTORICO-CONTAS-DATA-VENCIMENTO></th><th class="hidden-xs hidden-sm" translate=@APP-HISTORICO-CONTAS-VALOR><tbody style="text-align: center"><tr ng-repeat="debitoFintech in $data track by $index"><td class="hidden-xs hidden-sm" ng-bind=debitoFintech.MesRef></td><td class="hidden-xs hidden-sm" ng-bind=debitoFintech.DataVencimento></td><td class="hidden-xs hidden-sm" ng-bind=debitoFintech.Valor></td></tr></tbody></th></tr></thead></table></section><span translate=@APP-HISTORICO-CONTAS-PAGAMENTO-EFETUADO ng-if="vm.regraPopupAvisoFintech == \'2\'" style="font-weight: 400"></span></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class=row><div class=buttons ng-if="vm.regraPopupAvisoFintech == \'2\'"><div class="col-xs-24 col-md-12 col-md-push-12"><button class="btn btn-default btn-lg btn-block" id=btnConfirm ng-click="vm.executar(\'S\')" translate=@APP-HISTORICO-CONTAS-SIM></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button class="btn btn-default btn-secondary btn-lg btn-block" ng-click=vm.fechar() translate=@APP-HISTORICO-CONTAS-NAO></button></div></div><div class=row style="display: flex" ng-if="vm.regraPopupAvisoFintech != \'2\'"><div class=buttons style="margin: auto"><div class="col-xs-24 col-md-12" style="display: inline-table; min-width: 300px"><button class="btn btn-default btn-secondary btn-lg btn-block" style="background: -webkit-linear-gradient(left, #006699, #00bbcc);color: #fff" ng-click=vm.fechar() translate=@APP-HISTORICO-CONTAS-BTN-OK></button></div></div></div></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-historico-conta-parcelar-debitos-tipo-parcelamento.html",'<div class="modal-content cpfl-style"><div class=modal-header><button type=button style=color:#006699 class=close data-dismiss=modal aria-label=Close ng-click=vm.voltar();><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO></h2></div></div></div><div class=modal-body><div ng-if="(vm.permitirParcelamentoBoleto || vm.permitirParcelamentoCartao || vm.permitirParcelamentoFatura || vm.permitirParcelamentoDentroFatura)"><div class=row><div class=col-xs-24><alert target=modal-historico-contas-parcelar-debitos-forma-pagamento></alert></div></div><div class=row><div class=col-xs-24><div class=form-group><div class=text-center><label class=inputs style=font-size:22px;color:grey;text-transform:none translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-LABEL></label></div><div class=container-fluid><div class=row style=margin:auto><div ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if="vm.permitirParcelamentoCartao && !vm.ehDebitoAutomatico"><div class=col-md-24 style=margin-top:1em><div class=card-servicos-destaque style="background-color:#3F6F9B;height: 170px;border-radius: 8px;min-width: 160px;position: relative; padding: inherit"><div class=card-servicos-destaque-icone style="position: absolute; top: 12px; left: 12px"><img ng-src=assets/images/ico/ParcelamentoCartao.svg style="width:6.7em; height:6.7em;margin-left:-25px;margin-top:-24px"></div><div class=card-servicos-destaque-nome-servico style="position: absolute; bottom: 25px; left: 14px; font-family: \'Lato\', sans-serif; font-size: 15px; text-align: left; color: #FFFFFF; padding-right: 3%"><span class=card-vertical-align translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-CARTAO-CREDITO></span></div></div></div><div class=col-md-24 style=margin-top:1em;min-height:150px><span translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-TEXTO-CARTAO-CREDITO translate-values="{quantidadeParcelas: {{vm.qtdParcelasCartao}}}" style=font-size:14px;color:dimgray></span></div><div class="row hidden-sm hidden-lg"><div class=col-xs-24 style="text-align: center"><div class="col-xs-24 col-md-20 col-md-push-2"><button ng-click=vm.selecttipoParcelamento(2); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div></div></div></div><div ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if="vm.permitirParcelamentoBoleto && !vm.ehDebitoAutomatico"><div class=col-md-24 style=margin-top:1em><div class=card-servicos-destaque style="background-color:#589690;height: 170px;border-radius: 8px;min-width: 160px;position: relative; padding: inherit"><div class=card-servicos-destaque-icone style="position: absolute; top: 12px; left: 12px"><img ng-src=assets/images/ico/ParcelamentoBoleto.svg style="width:6.7em; height:6.7em;margin-left:-25px;margin-top:-24px"></div><div class=card-servicos-destaque-nome-servico style="position: absolute; bottom: 25px; left: 14px; font-family: \'Lato\', sans-serif; font-size: 15px; text-align: left; color: #FFFFFF; padding-right: 3%"><span class=card-vertical-align translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-BOLETO translate-values="{empresa: \'{{vm.empresa}}\'}"></span></div></div></div><div class=col-md-24 style=margin-top:1em;min-height:150px><span translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-TEXTO-BOLETO translate-values="{quantidadeParcelas: {{vm.qtdParcelasBoleto}}}" style=font-size:14px;color:dimgray></span></div><div class="row hidden-sm hidden-lg"><div class=col-xs-24 style="text-align: center"><button ng-click=vm.selecttipoParcelamento(1); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div></div></div><div ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if="vm.permitirParcelamentoDentroFatura && !vm.ehDebitoAutomatico"><div class=col-md-24 style=margin-top:1em><div class=card-servicos-destaque style="background-color:#FAC963;height: 170px;border-radius: 8px;min-width: 160px;position: relative; padding: inherit"><div class=card-servicos-destaque-icone style="position: absolute; top: 12px; left: 12px"><img ng-src=assets/images/ico/ParcelamentoDentroFatura.svg style="width:6.7em; height:6.7em;margin-left:-25px;margin-top:-24px"></div><div class=card-servicos-destaque-nome-servico style="position: absolute; bottom: 25px; left: 14px; font-family: \'Lato\', sans-serif; font-size: 15px; text-align: left; color: #FFFFFF; padding-right: 3%"><span class=card-vertical-align translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-DENTRO-FATURA translate-values="{empresa: \'{{vm.empresa}}\'}"></span></div></div></div><div class=col-md-24 style=margin-top:1em;min-height:150px><span translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-TEXTO-DENTRO-FATURA translate-values="{quantidadeParcelas: {{vm.qtdParcelasDentroFatura}},percentualEntrada:{{vm.percentualEntradaDentroFatura}}}" style=font-size:14px;color:dimgray></span><br></div><div class="row hidden-sm hidden-lg"><div class=col-xs-24 style="text-align: center"><button ng-click=vm.selecttipoParcelamento(6); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div></div></div><div ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if=vm.permitirParcelamentoFatura><div class=col-md-24 style=margin-top:1em><div class=card-servicos-destaque style="background-color:#DC683C;height: 170px;border-radius: 8px;min-width: 160px;position: relative; padding: inherit"><div class=card-servicos-destaque-icone style="position: absolute; top: 12px; left: 12px"><img ng-src=assets/images/ico/ParcelamentoFatura.svg style="width:6.7em; height:6.7em;margin-left:-25px;margin-top:-24px"></div><div class=card-servicos-destaque-nome-servico style="position: absolute; bottom: 10px; left: 14px; font-family: \'Lato\', sans-serif; font-size: 15px; text-align: left; color: #FFFFFF; padding-right: 3%"><span class=card-vertical-align translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-FATURA></span></div></div></div><div class=col-md-24 style=margin-top:1em;min-height:150px><span translate=@APP-MODAL-HISTORICO-CONTAS-PARCELAR-DEBITOS-FORMA-PAGAMENTO-TEXTO-FATURA translate-values="{quantidadeParcelas: {{vm.qtdParcelasFatura}}}" style=font-size:14px;color:dimgray></span></div><div class="row hidden-sm hidden-lg"><div class=col-xs-24 style="text-align: center"><button ng-click=vm.selecttipoParcelamento(99999); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div></div></div></div><br><div class="row hidden-md hidden-xs" style="overflow: auto; margin:auto; padding-left: inherit"><div class=col-xs-24 style="text-align: center" ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if="vm.permitirParcelamentoCartao && !vm.ehDebitoAutomatico"><button ng-click=vm.selecttipoParcelamento(2); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div><div class=text-center ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if="vm.permitirParcelamentoBoleto && !vm.ehDebitoAutomatico"><button ng-click=vm.selecttipoParcelamento(1); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div><div class=text-center ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if="vm.permitirParcelamentoDentroFatura && !vm.ehDebitoAutomatico"><button ng-click=vm.selecttipoParcelamento(6); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div><div class=text-center ng-class="vm.qtdTiposParcelamento == 1 ? \'col-lg-12 col-lg-offset-6\' : vm.qtdTiposParcelamento == 2 ? \'col-lg-12\' : vm.qtdTiposParcelamento == 3 ? \'col-lg-8\' : vm.qtdTiposParcelamento == 4 ? \'col-lg-6\' : \'\'" ng-if=vm.permitirParcelamentoFatura><button ng-click=vm.selecttipoParcelamento(99999); class="btn btn-default btn-md btn-block" translate=@APP-HISTORICO-CONTAS-MODAL-OPCOES-PARCELAMENTO></button></div></div></div><div ng-if="vm.permitirParcelamentoFatura && vm.avisoParcelamentoFatura"><div class=row><div class=col-xs-24><div uib-alert class=alert ng-class="{\'alert-warning\': !vm.aceitaRedirMarketplace, \'alert-success\': vm.aceitaRedirMarketplace}"><span translate=@APP-HISTORICO-CONTAS-PARCELAR-FATURA-ATENCAO class="alert-message small"></span> <span translate=@APP-HISTORICO-CONTAS-PARCELAR-FATURA-AVISO-REDIRECIONAMENTO class=small></span><p><input type=checkbox id=checkBoxAceita ng-model=vm.aceitaRedirMarketplace> <span for=checkBoxAceita translate=@APP-HISTORICO-CONTAS-PARCELAR-FATURA-ACEITE-TERMO-REDIRECIONAMENTO class=alert-message></span></p></div></div></div></div></div></div></div></div></div><div class=modal-footer></div></div>');a.put("modules/historico-contas/partials/modal-historico-contas-enderecos-encontrados.html",'<div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MODAL-ENDERECOS-ENCONTRADOS-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><table class=table ng-table=vm.tableParams><thead><tr><th translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MODAL-ENDERECOS-ENCONTRADOS-COLHEAD-LOGRADOURO></th><th class=hidden-xs translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MODAL-ENDERECOS-ENCONTRADOS-COLHEAD-CEP></th><th translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MODAL-ENDERECOS-ENCONTRADOS-COLHEAD-BAIRRO></th><th class=text-center translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MODAL-ENDERECOS-ENCONTRADOS-COLHEAD-SELECIONE></th></tr></thead><tbody><tr ng-repeat="endereco in $data"><td ng-bind=endereco.Logradouro></td><td class=hidden-xs ng-bind=endereco.CEP></td><td ng-bind=endereco.Bairro></td><td class="cpfl-style text-center"><div class=radio-box><div class="form-group form-group-radio"><label><input type=radio ng-value=endereco ng-model=vm.enderecoSelecionado name=enderecoRadio> <span class=any></span></label></div></div></td></tr></tbody></table></div></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12 col-md-offset-6"><button ng-click=vm.selecionarEndereco() id=btnSelecionarEndereco type=submit class="btn btn-default btn-lg btn-block" translate=@APP-HISTORICO-CONTAS-ENVIAR-CORREIO-MODAL-ENDERECOS-ENCONTRADOS-BTN-SELECIONAR-INSTALACAO></button></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-historico-contas-parcelar-debitos-confirmacao-parcelamento.html",'<div class="modal-content cpfl-style"><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><span ng-if="vm.tipoParcelamento !=\'DENTRO DA FATURA\'" style=font-size:1em translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-CONFIRMACAO-PARCELAMENTO-MENSAGEM translate-values="{tipoParcelamento: \'{{vm.tipoParcelamento}}\'}"></span> <span ng-if="vm.tipoParcelamento ==\'DENTRO DA FATURA\'" style=font-size:1em translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-CONFIRMACAO-PARCELAMENTO-FATURA-MENSAGEM translate-values="{tipoParcelamento: \'{{vm.tipoParcelamento}}\'}"></span></div></div></div><div class=modal-footer><div id=botoes><div class=row><div class="col-xs-24 col-md-12 col-md-push-12"><button id=btnLogadoSim type=button class="btn btn-default btn-lg btn-block" translate=@APP-COMMON-CONFIRM-SELECTION-MODAL-BTN-SIM-DEFAULT ng-click=vm.confirmar()></button></div><div class="col-xs-24 col-md-12 col-md-pull-12"><button id=btnLogadoNao type=button class="btn btn-default btn-secondary btn-lg btn-block" translate=@APP-COMMON-CONFIRM-SELECTION-MODAL-BTN-NAO-DEFAULT ng-click=vm.close()></button></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-itens-consolidados.html",'<div id=itens-consolidados><div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><div class=cpfl-style><div class=panel-body><table ng-table=vm.tableItensConsolidadosParams class=table><thead class=hidden-xs><tr><th translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-ITEM></th><th translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-VALOR></th><th translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-REFERENCIA-ATRASO></th><th translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-DIAS-ATRASO></th></tr></thead><tbody class=hidden-xs><tr ng-repeat="registro in $data track by $index"><td ng-bind=registro.Item></td><td ng-bind="registro.Valor | currency"></td><td ng-bind="registro.RefContaAtraso | date:\'yyyy/mm\'" style=padding-left:30px></td><td ng-bind=registro.DiasAtraso style=padding-left:30px></td></tr></tbody><tbody class="hidden-sm hidden-md hidden-lg"><tr ng-repeat="registro in $data track by $index"><td><span translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-ITEM-MOBILE style="font-size: 13px"></span> <span ng-bind=registro.Item></span><br><span translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-VALOR-MOBILE style="font-size: 13px"></span> <span ng-bind="registro.Valor | currency"></span><br><span translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-REFERENCIA-ATRASO-MOBILE style="font-size: 13px"></span> <span ng-bind="registro.RefContaAtraso | date:\'yyyy/mm\'"></span><br><span translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-ITENS-CONSOLIDADOS-COLHEAD-DIAS-ATRASO-MOBILE style="font-size: 13px"></span> <span ng-bind=registro.DiasAtraso></span><br></td></tr></tbody></table></div></div></div></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 hidden-xs hidden-sm"><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.baixarPDF() translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-BTN-PDF></button></div><div class="col-xs-24 col-md-12"><button type=button class="btn btn-default btn-lg btn-block hand" ng-click=vm.fechar() translate=@APP-HISTORICO-CONTAS-DETALHES-MODAL-BTN-FECHAR></button></div></div></div></div>');a.put("modules/historico-contas/partials/modal-pagamento-fatura-pix.html",'<div class="modal-content cpfl-style"><div class=modal-header><button type=button style=color:#006699 class=close data-dismiss=modal aria-label=Close ng-click=vm.fechar();><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-HISTORICO-CONTAS-PAGAR-COM-PIX-TITULO></h2></div><div class=col-xs-24><alert target=modal-pagamento-fatura-pix></alert></div></div></div><div class=modal-body><div class=row><p translate=@APP-HISTORICO-CONTAS-PAGAR-COM-PIX-DESCRICAO></p></div><div class=row><table class="table hidden-xs"><thead><tr><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-EMPRESA></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR></th><th translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VENCIMENTO></th></tr></thead><tbody><tr><td ng-bind=vm.empresa.nomeEmpresa class="text-center span-vertical"></td><td ng-bind=vm.dadosConta.MesReferencia class="text-center span-vertical"></td><td ng-bind=vm.dadosConta.DescricaoFatura class="text-center span-vertical" ng-if=!vm.dadosConta.ContaAcumulada></td><td ng-bind="vm.dadosConta.Valor | currency" ng-if="vm.dadosConta.ContaMinima == null || vm.dadosConta.ContaMinima == \'CMA\'" class="text-center span-vertical"></td><td ng-bind="vm.dadosConta.Vencimento | date:\'dd/MM/yyyy\'" class="text-center span-vertical"></td></tr></tbody></table><table class="table hidden-sm hidden-md hidden-lg" style="margin-bottom: 5px !important"><tbody><tr><td><div class=col-xs-21><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-EMPRESA-MOBILE style="font-size: 13px"></span> <span ng-bind=vm.empresa.nomeEmpresa></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-MES-REF-MOBILE style="font-size: 13px"></span> <span ng-bind=vm.dadosConta.MesReferencia></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-DESCRICAO-FATURA-MOBILE style="font-size: 13px"></span> <span ng-bind=vm.dadosConta.DescricaoFatura ng-if=!vm.dadosConta.ContaAcumulada></span> <a class=hand ng-click=vm.exibirModalContaMinima(registro); translate=@APP-HISTORICO-CONTAS-CONTA-MINIMA ng-if=vm.dadosConta.ContaAcumulada></a> <i class="fa fa-info-circle hand" aria-hidden=true type=button style="font-size:1.3em; color:#069; margin-left:0.5em" ng-click=vm.exibirModalContaMinima(registro); ng-if=vm.dadosConta.ContaAcumulada></i><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VENCIMENTO-MOBILE style="font-size: 13px"></span> <span ng-bind="vm.dadosConta.Vencimento | date:\'dd/MM/yyyy\'"></span><br><span translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-VALOR-MOBILE style="font-size: 13px"></span> <span ng-bind="vm.dadosConta.Valor | currency" ng-if="vm.dadosConta.ContaMinima == null || vm.dadosConta.ContaMinima == \'CMA\'"></span><br></div></td></tr></tbody></table></div><div class=row><div class=col-xs-24><div class=codigoBarras style="text-align: center !important; margin-bottom: -25px !important; margin-top: 25px !important; font-size: 99% !important"><img ng-src={{vm.dadosConta.QRCodeBase64}} width=160px height=160px></div></div><div class=buttons><div class=row><div class="col-xs-24 col-md-9" style="margin-top:25px !important" ngclipboard data-clipboard-text={{vm.dadosConta.strEstaticoPIX}} ng-click=vm.mostrarMensagemCopiadoClipboardPIX(); style="margin-bottom:-10px !important"><i class="fa hand" aria-hidden=true type=button style="font-size:1.3em; color:#069"><img src=assets/images/ico/copiar.svg style="Margin-top: 10px !important"></i>&nbsp; <a class=hand translate=@APP-HISTORICO-CONTAS-DETALHES-CONTA-BTN-COPIAR-CODIGO-PIX></a></div></div></div><br></div><div class=row><div class=protocolo ng-if=vm.protocolo><div class=protocolo-primary><span translate=@APP-HISTORICO-CONTAS-PROTOCOLO></span> <span class=numero-protocolo ng-bind=vm.protocolo></span></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-4 col-md-push-20"><button id=btnVoltar type=button class="btn btn-secondary btn-sm btn-block hand" data-dismiss=modal translate=@APP-COMMON-MODAL-VIA-PAGAMENTO-BTN-FECHAR ng-click=vm.fechar();></button></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-pesquisa-segunda-via.html",'<div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-TITULO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><p translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-TEXTO></p></div><form name=form novalidate><div class=cpfl-style><div class=radio-box><div class="form-group form-group-radio"><label><input type=radio name=questionario1 value=1 ng-model=vm.questionarioSelecionado> <span translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-QUESTIONARIO-1></span></label></div><div class="form-group form-group-radio"><label><input type=radio name=questionario2 value=2 ng-model=vm.questionarioSelecionado> <span translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-QUESTIONARIO-2></span></label></div><div class="form-group form-group-radio"><label><input type=radio name=questionario3 value=3 ng-model=vm.questionarioSelecionado> <span translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-QUESTIONARIO-3></span></label></div><div class="form-group form-group-radio"><label><input type=radio name=questionario4 value=4 ng-model=vm.questionarioSelecionado> <span translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-QUESTIONARIO-4></span></label></div><div class="form-group form-group-radio"><label><input type=radio name=questionario5 value=5 ng-model=vm.questionarioSelecionado> <span translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-QUESTIONARIO-5></span></label></div></div><div class=form-group ng-if="vm.questionarioSelecionado == 5"><textarea class=form-control rows=3 ng-model=vm.respostaOutros maxlength=300></textarea></div></div></form></div></div><div class=modal-footer><div class=buttons><div class=row><div class="col-xs-24 col-md-12 col-md-offset-6"><button ng-click=vm.enviarQuestionario(form) id=btnSelecionarEndereco type=submit ng-disabled="vm.questionarioSelecionado == 5 ? !vm.respostaOutros : !vm.questionarioSelecionado" class="btn btn-default btn-lg btn-block" translate=@APP-MODAL-HISTORICO-CONTAS-PESQUISA-SEGUNDA-VIA-BTN-ENVIAR></button></div></div></div></div></div>');
a.put("modules/historico-contas/partials/modal-possibilita-parcelamento.html",'<div class=cpfl-style><div class=modal-content><div class=modal-header><div class=row><div class=col-xs-24><h2 class=modal-title id=modal-title translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-INFORMATIVO-EMAIL-TITLE-LABEL></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><span translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-INFORMATIVO-EMAIL-DESCRICAO-LABEL translate-values="{email: \'{{vm.emailEmpresaSAP}}\'}"></span></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class="col-xs-24 col-md-12 col-md-offset-6"><button class="btn btn-default btn-lg btn-block" ng-click=vm.close(); translate=@APP-HISTORICO-CONTAS-PARCELAR-DEBITOS-INFORMATIVO-EMAIL-BUTTON></button></div></div></div></div></div></div>');a.put("modules/historico-contas/partials/modal-reaviso.html","<div class=modal-content><div class=modal-header><button type=button class=close data-dismiss=modal ng-click=vm.fechar(); aria-label=Close><span aria-hidden=true>&times;</span></button><div class=row><div class=col-xs-24><h2 class=modal-title translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-REAVISO></h2></div></div></div><div class=modal-body><div class=row><div class=col-xs-24><div class=cpfl-style><div class=col-xs-24><div><span style=font-weight:400 translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-REAVISO-MENSAGEM translate-values=\"{nome: '{{vm.primeiroNome}}', dataVencimento: '{{vm.conta.Vencimento}}', dataReaviso: '{{vm.conta.DTLimiteReaviso}}'}\"></span> <span ng-bind=\"vm.dataReaviso | date:'dd/MM/yyyy'\"></span></div></div></div></div></div></div><div class=modal-footer><div class=row><div class=buttons><div class=\"col-xs-24 col-md-12 col-md-push-6\"><button id=btnVoltar type=button class=\"btn btn-default btn-danger btn-lg btn-block hand\" data-dismiss=modal translate=@APP-HISTORICO-CONTAS-TOTAL-DEBITOS-EM-ABERTO-COLHEAD-REAVISO-REGULARIZAR ng-click=vm.regularizar();></button></div></div></div></div></div>");a.put("modules/historico-contas/partials/modal-via-pagamento.html","<div class=modal-content><div class=modal-body style=overflow-y:auto;height:410px id=via-pagamento><div class=cpfl-style ng-show=vm.response><table width=100%><tr><td valign=top width=20%><img ng-src={{vm.dadosEmpresa.Logo}}></td><td valign=top width=45%><font face=Tahoma size=1><span ng-bind=vm.dadosEmpresa.EnderecoCompleto></span><br><span translate=@APP-MODAL-VIA-PAGAMENTO-CNPJ></span> <span ng-bind=vm.dadosEmpresa.CNPJ></span><br><span translate=@APP-MODAL-VIA-PAGAMENTO-INSCRICAO-ESTADUAL></span> <span ng-bind=vm.dadosEmpresa.InscricaoEstadual></span></font></td><td valign=top align=right width=40%><font face=Tahoma size=1><span translate=@APP-MODAL-VIA-PAGAMENTO-INFORMACOES-CODIGO-BARRAS></span> <span translate=@APP-MODAL-VIA-PAGAMENTO-INFORMACOES-VALOR-FISCAL></span> <span translate=@APP-MODAL-VIA-PAGAMENTO-INFORMACOES-EMISSAO></span> <span>{{vm.dataEmissao | date:'dd/MM/yyyy'}}</span><br><span translate=@APP-MODAL-VIA-PAGAMENTO-INFORMACOES-ICMS></span></font></td></tr><tr style=\"background-color: Silver\"><td style=\"border-top: black 2px solid\" align=center colspan=3><font face=Tahoma size=1><span translate=@APP-MODAL-VIA-PAGAMENTO-DADOS-CADASTRAIS-TITULO></span></font></td></tr><tr><td><font face=Tahoma size=1><span translate=@APP-MODAL-VIA-PAGAMENTO-DADOS-CADASTRAIS-SEU-CODIGO></span></font></td><td><font face=Tahoma size=1><span translate=@APP-MODAL-VIA-PAGAMENTO-DADOS-CADASTRAIS-CLIENTE></span></font></td><td><font face=Tahoma size=1><span translate=@APP-MODAL-VIA-PAGAMENTO-DADOS-CADASTRAIS-CONTA-CONTRATO></span></font></td></tr><tr><td style=\"border-left: black 2px solid; border-bottom: black 1px solid\"><font face=Tahoma size=2><span ng-bind=vm.instalacao.Instalacao></span></font></td><td style=\"border-left: black 2px solid; border-bottom: black 1px solid\"><font face=Tahoma size=2><span ng-bind=vm.inst